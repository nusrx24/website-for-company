---
import LogoCarousel from "@/components/LogoCarousel.astro";
import type { Homepage } from "@/types";

export interface Props {
  projects: Homepage["projects"];
}

const { projects } = Astro.props as Props;

// The carousel shows every client that has a tile: the client's own logo, or
// for a client who has not supplied one, a stand-in drawn for this page.
const logos = projects.items.flatMap((item) =>
  item.logo ? [{ name: item.name, src: item.logo }] : [],
);
---

{/* Proof: the businesses we build for. Their tiles, four at a time, each
    giving way to the next every two seconds (the full list of names is in
    the page for screen readers and search engines); and under them, how
    many customers there are. */}
<section id="work" class="section">
  <div class="wrap">
    <div class="section-head">
      <h2 data-breathe>{projects.title}</h2>
      {(projects.label || projects.content || projects.link) && (
        <div class="work-intro">
          {projects.label && <strong class="work-intro__label">{projects.label}</strong>}
          {projects.content && <p>{projects.content}</p>}
          {projects.link && (
            <a
              id="work-facebook-link"
              class="work-intro__link"
              href={projects.link.href}
              target="_blank"
              rel="noopener noreferrer"
            >
              {projects.link.label}
              <span aria-hidden="true">→</span>
            </a>
          )}
        </div>
      )}
    </div>

    <LogoCarousel logos={logos} columns={4} />

    {/* How many customers there are. The count is the owner's own. */}
    {projects.customers && <h3 class="work-count">{projects.customers.title}</h3>}
  </div>
</section>

<style>
  /* ── Section intro: label, sentence, link ─────────────────────────────── */
  .work-intro {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .work-intro__label {
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .work-intro__link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    width: fit-content;
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 0.25em;
    text-decoration-thickness: 1px;
    transition: gap 0.2s ease-out, opacity 0.2s ease-out;
  }

  .work-intro__link:hover,
  .work-intro__link:focus-visible {
    gap: 0.65rem;
    opacity: 0.8;
  }

  /* On a touch screen the link is a fingertip tall. The negative margin
     gives back the extra height, so the spacing around it stays the same. */
  @media (pointer: coarse) {
    .work-intro__link {
      min-height: 2.75rem;
      margin-block: -0.5rem;
    }
  }

  /* ── The count of customers ─────────────────────────────────────────────
     One line, centred under the logos like them. */
  .work-count {
    margin-top: clamp(1.75rem, 3.5vw, 2.5rem);
    text-align: center;
  }
</style>
