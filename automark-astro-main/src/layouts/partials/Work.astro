---
import ImageMod from "@/components/ImageMod.astro";
import type { Homepage } from "@/types";

export interface Props {
  projects: Homepage["projects"];
}

const { projects } = Astro.props as Props;
---

{/* Proof, in one block: a card per client. The open card shows the
    photograph in colour with the client's logo, who they are and what we
    built; the others wait as narrow strips with their name. Pointing at,
    tabbing to or tapping a card opens it. All the text is in the page for
    every card, open or not. */}
<section id="work" class="section">
  <div class="wrap">
    <div class="section-head">
      <h2 data-breathe>{projects.title}</h2>
      {(projects.label || projects.content || projects.link) && (
        <div class="work-intro">
          {projects.label && <strong class="work-intro__label">{projects.label}</strong>}
          {projects.content && <p>{projects.content}</p>}
          {projects.link && (
            <a
              id="work-facebook-link"
              class="work-intro__link"
              href={projects.link.href}
              target="_blank"
              rel="noopener noreferrer"
            >
              {projects.link.label}
              <span aria-hidden="true">→</span>
            </a>
          )}
        </div>
      )}
    </div>

    <ul
      class="cards"
      role="list"
      data-cards
      style={`--n:${projects.items.length}`}
    >
      {
        projects.items.map((item, index) => (
          <li
            class="card metal-frame"
            data-card
            data-active={index === 0 ? "true" : "false"}
            tabindex="0"
          >
            <div class="card__inner">
              <ImageMod
                src={item.image.src}
                alt={item.image.alt}
                width={1600}
                widths={[480, 720, 960, 1280, 1600]}
                sizes="(min-width: 1024px) 680px, calc(100vw - 2.5rem)"
                format="webp"
                quality={76}
                loading="lazy"
                style={item.image.focus ? `object-position:${item.image.focus}` : undefined}
              />
              <div class="card__shade" />

              {/* The name on a closed card. The heading below repeats it,
                  so this copy is hidden from assistive tech. */}
              <span class="card__spine" aria-hidden="true">
                {item.name}
              </span>

              <article class="card__body">
                {item.logo && (
                  <span class="card__logo">
                    <ImageMod
                      src={item.logo}
                      alt=""
                      width={96}
                      format="webp"
                      quality={85}
                      loading="lazy"
                    />
                  </span>
                )}
                <p class="card__meta">
                  {item.sector}
                  {item.location && `, ${item.location}`}
                </p>
                <h3>{item.name}</h3>
                <p class="card__summary">{item.summary}</p>
              </article>
            </div>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  /* ── Section intro: label, sentence, link ─────────────────────────────── */
  .work-intro {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .work-intro__label {
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .work-intro__link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    width: fit-content;
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 0.25em;
    text-decoration-thickness: 1px;
    transition: gap 0.2s ease-out, opacity 0.2s ease-out;
  }

  .work-intro__link:hover,
  .work-intro__link:focus-visible {
    gap: 0.65rem;
    opacity: 0.8;
  }

  /* On a touch screen the link is a fingertip tall. The negative margin
     gives back the extra height, so the spacing around it stays the same. */
  @media (pointer: coarse) {
    .work-intro__link {
      min-height: 2.75rem;
      margin-block: -0.5rem;
    }
  }

  /* ── Expanding cards ──────────────────────────────────────────────────
     One card is open and the rest are closed. Which one is open changes;
     the block itself never changes size.

     Phone and tablet: the cards are rows. A closed row is --closed tall and
     the open one --open.
     From 1024px: the cards are columns in a block 500px tall. The open
     column takes five shares of the width and each closed one a single
     share.

     --n is the number of cards, set on the list. The list is also a size
     container, so 100cqw below means "the width of the whole block". */
  .cards {
    --closed: 3.5rem;
    --open: 26rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
    container-type: inline-size;
  }

  /* The moving chrome edge comes from .metal-frame (components.css). */
  .card {
    flex: 0 0 var(--closed);
    min-width: 0;
    min-height: 0;
    cursor: pointer;
    /* Room above and below when the page scrolls a card into view. */
    scroll-margin-block: 0.75rem;
    transition: flex-basis 0.5s ease-out;
    /* No grey flash across the photograph when tapped. */
    -webkit-tap-highlight-color: transparent;
  }

  .card[data-active="true"] {
    flex-basis: var(--open);
  }

  .card__inner {
    position: relative;
    z-index: 1;
    overflow: hidden;
    height: 100%;
    border-radius: 6px;
    background-color: var(--color-light);
  }

  /* The photograph. Closed: grey and slightly zoomed. Open: full colour. */
  .card__inner > :global(img) {
    position: absolute;
    inset: 0;
    z-index: 0;
    width: 100%;
    height: 100%;
    border-radius: 0;
    object-fit: cover;
    filter: grayscale(1);
    transform: scale(1.1);
    transition:
      filter 0.3s ease-out,
      transform 0.3s ease-out;
  }

  .card[data-active="true"] .card__inner > :global(img) {
    filter: none;
    transform: none;
  }

  .card__shade {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgb(0 0 0 / 0.8), rgb(0 0 0 / 0.4), transparent);
  }

  /* Name on a closed card: across the row on a phone, turned on its side in
     a column. */
  .card__spine {
    position: absolute;
    top: 50%;
    left: 1rem;
    color: rgb(255 255 255 / 0.85);
    font-size: 0.875rem;
    letter-spacing: 0.05em;
    text-shadow: 0 1px 3px rgb(0 0 0 / 0.7);
    text-transform: uppercase;
    white-space: nowrap;
    transform: translateY(-50%);
    transition: opacity 0.3s ease-out;
  }

  .card[data-active="true"] .card__spine {
    opacity: 0;
  }

  /* A fixed width, not the card's: the text keeps its line breaks while the
     card opens and closes instead of re-wrapping mid-animation. */
  .card__body {
    position: absolute;
    bottom: 0;
    left: 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    width: min(24rem, calc(100cqw - 4px));
    padding: 1rem;
    /* Some of the photographs are busy screens; this keeps the words clear
       of them. */
    text-shadow: 0 1px 3px rgb(0 0 0 / 0.75);
  }

  .card__logo,
  .card__meta,
  .card__body h3,
  .card__summary {
    opacity: 0;
    transition: opacity 0.3s ease-out;
  }

  /* The lines arrive one after another as the card opens. */
  .card[data-active="true"] .card__logo {
    opacity: 1;
    transition-delay: 75ms;
  }

  .card[data-active="true"] .card__meta {
    opacity: 1;
    transition-delay: 110ms;
  }

  .card[data-active="true"] .card__body h3 {
    opacity: 1;
    transition-delay: 150ms;
  }

  .card[data-active="true"] .card__summary {
    opacity: 1;
    transition-delay: 225ms;
  }

  /* The client's own logo, as a small tile. */
  .card__logo {
    overflow: hidden;
    width: 44px;
    height: 44px;
    margin-bottom: 0.125rem;
    border: 1px solid rgb(255 255 255 / 0.3);
    border-radius: 10px;
    background-color: #fff;
    box-shadow: 0 2px 8px rgb(0 0 0 / 0.45);
  }

  .card__logo :global(img) {
    position: static;
    width: 100%;
    height: 100%;
    border-radius: 0;
    object-fit: cover;
  }

  .card__meta {
    color: rgb(255 255 255 / 0.9);
    font-size: 0.8125rem;
  }

  .card__body h3 {
    font-size: clamp(1.25rem, 2.2vw, 1.5rem);
    line-height: 1.15;
  }

  .card__summary {
    max-width: 22rem;
    color: rgb(255 255 255 / 0.8);
    font-size: 0.8125rem;
    line-height: 1.6;
  }

  @media (min-width: 640px) {
    .cards {
      --open: 30rem;
    }
  }

  @media (min-width: 1024px) {
    .cards {
      /* One share of the block's width: the inside of a closed card. What
         is shared out is the block minus the gaps and minus each card's
         4px of chrome edge. */
      --share: calc(
        (100cqw - (var(--n) - 1) * 0.5rem - var(--n) * 4px) / (var(--n) + 4)
      );
      flex-direction: row;
      height: 500px;
    }

    .card {
      flex: 1 1 0px;
      transition: flex-grow 0.5s ease-out;
    }

    .card[data-active="true"] {
      flex: 5 1 0px;
    }

    /* Reads upwards from the bottom, centred in the closed column. */
    .card__spine {
      top: auto;
      bottom: 1.25rem;
      left: calc(var(--share) / 2);
      writing-mode: vertical-rl;
      transform: translateX(-50%) rotate(180deg);
    }

    /* As wide as the open column, so nothing is cut off. */
    .card__body {
      width: min(24rem, calc(var(--share) * 5));
      padding: 1.25rem;
    }

    .card__summary {
      font-size: 0.875rem;
    }
  }
</style>

<script>
  // The open card is whichever was last pointed at, focused or tapped. It
  // stays open when the pointer leaves, so the block never collapses.
  document.querySelectorAll<HTMLElement>("[data-cards]").forEach((list) => {
    const cards = [...list.querySelectorAll<HTMLElement>("[data-card]")];

    const open = (active: HTMLElement) =>
      cards.forEach((card) => {
        card.dataset.active = String(card === active);
      });

    // While the cards are rows (phone and tablet), opening one closes
    // another above or below it, which slides the page under the finger and
    // can leave the card that was just opened half off the screen. So after
    // a tap, once the card has finished opening, bring all of it into view.
    // Touch only: with a mouse, moving the page would put the pointer over
    // a different card and open that one instead.
    const rows = window.matchMedia("(max-width: 1023.98px)");
    const reduce = window.matchMedia("(prefers-reduced-motion: reduce)");
    let settling = 0;

    const settle = (card: HTMLElement) => {
      window.clearTimeout(settling);
      settling = window.setTimeout(() => {
        if (card.dataset.active !== "true") return;
        card.scrollIntoView({
          block: "nearest",
          behavior: reduce.matches ? "auto" : "smooth",
        });
      }, 600);
    };

    cards.forEach((card) => {
      card.addEventListener("mouseenter", () => open(card));
      card.addEventListener("focus", () => open(card));
      card.addEventListener("click", () => open(card));
      // A finger lifting (a swipe that scrolls the page ends in
      // "pointercancel" instead, so scrolling past does nothing here).
      card.addEventListener("pointerup", (event) => {
        if (event.pointerType !== "mouse" && rows.matches) settle(card);
      });
    });
  });
</script>
