---
import ImageMod from "@/components/ImageMod.astro";
import type { Homepage } from "@/types";
import TextLoop from "@/components/ui/text-loop";

export interface Props {
  hardware: Homepage["hardware"];
}

const { hardware } = Astro.props as Props;
---

{/* Image-led rather than card-led: the counter photograph does the explaining,
    and the four items sit beside it as a plain list. */}
<section id="hardware" class="section scroll-mt-24">
  <div class="container">
    <div class="grid items-center gap-10 lg:grid-cols-12 lg:gap-14">
      <div class="lg:col-span-6">
        {
          hardware.image && (
            <figure class="overflow-hidden rounded-2xl border border-border bg-light shine-border">
              <ImageMod
                src={hardware.image}
                alt={hardware.image_alt ?? ""}
                width={900}
                class="aspect-[16/10] w-full object-cover"
                format="webp"
              />
            </figure>
          )
        }
      </div>

      <div class="lg:col-span-6">
        {
          hardware.eyebrow && (
            <p class="mb-4 font-primary text-xs font-semibold tracking-[0.18em] text-primary uppercase">
              {hardware.eyebrow}
            </p>
          )
        }
        <div class="mb-5">
          <TextLoop
            client:visible
            staticText="Software and hardware."
            rotatingTexts={["Ready to run.", "Counter ready.", "Plug & play.", "Zero downtime."]}
            className="text-h3 lg:text-h2 font-secondary font-bold uppercase leading-[1.1] tracking-tight flex-col items-start sm:flex-row sm:items-center sm:flex-wrap"
            staticTextClassName="text-white mr-0 sm:mr-3 whitespace-normal sm:whitespace-nowrap"
            rotatingTextClassName="text-primary pr-1 font-secondary font-bold uppercase drop-shadow-[0_0_14px_rgba(46,144,255,0.45)]"
            cursorClassName="bg-primary shadow-[0_0_10px_rgba(46,144,255,0.8)]"
            backgroundClassName="bg-gradient-to-r from-transparent via-primary/15 to-primary/25 rounded"
            interval={2800}
          />
        </div>
        {
          hardware.content && (
            <p class="mb-8 max-w-xl text-base leading-[1.75] text-text">
              {hardware.content}
            </p>
          )
        }

        <dl class="divide-y divide-border border-y border-border">
          {
            hardware.items.map((item) => (
              <div class="grid gap-1 py-4 sm:grid-cols-5 sm:gap-4">
                <dt class="text-h6 leading-tight uppercase sm:col-span-2">
                  {item.title}
                </dt>
                <dd class="text-sm leading-[1.75] text-text sm:col-span-3">
                  {item.content}
                </dd>
              </div>
            ))
          }
        </dl>

        {
          hardware.note && (
            <p class="mt-6 border-l-2 border-primary/50 pl-4 font-primary text-[13px] leading-[1.75] text-text-dark">
              {hardware.note}
            </p>
          )
        }
      </div>
    </div>
  </div>
</section>
