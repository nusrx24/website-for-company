---
import MockFrame from "./MockFrame.astro";

/**
 * Act three: the sale lands in the day's figures. Totals count up and the
 * week's bars grow, with today's bar carrying the accent.
 *
 * These are example figures for a demonstration screen, deliberately modest
 * and unremarkable. There is no growth percentage anywhere here: a performance
 * figure would read as a claim about what the software achieves, which is a
 * different thing from showing what it displays.
 */
const stats = [
  { label: "Today's sales", value: 128450, prefix: "LKR " },
  { label: "Bills", value: 48, prefix: "" },
  { label: "Net profit", value: 21380, prefix: "LKR " },
];

// Monday to Saturday; the last bar is today.
const bars = [52, 61, 47, 70, 58, 82];
---

<MockFrame label="Business report" mockKey="report">
  <div class="report">
    <div class="report__stats">
      {
        stats.map((stat, i) => (
          <div class="report__stat" style={`--i:${i}`}>
            <p class="report__statLabel">{stat.label}</p>
            <p
              class="report__statValue"
              data-count-to={stat.value}
              data-count-prefix={stat.prefix}
            >
              {stat.prefix}
              {stat.value.toLocaleString("en-LK")}
            </p>
          </div>
        ))
      }
    </div>

    <div class="report__chart" aria-hidden="true">
      {
        bars.map((height, i) => (
          <span
            class="report__bar"
            style={`--i:${i}; --h:${height}%`}
            data-today={i === bars.length - 1 ? "true" : undefined}
          />
        ))
      }
    </div>
    <p class="report__chartLabel">Last six days</p>
  </div>
</MockFrame>

<style>
  .report {
    display: grid;
    gap: 1.1rem;
  }

  /* ── Stat tiles ────────────────────────────────────────────────────── */
  .report__stats {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.5rem;
  }

  .report__stat {
    padding: 0.7rem 0.6rem;
    border: 1px solid var(--color-border);
    border-radius: 0.6rem;
    background: color-mix(in srgb, var(--color-body) 50%, transparent);
    opacity: 0;
    transform: translateY(6px);
  }
  :global([data-play="true"]) .report__stat {
    animation: statIn 340ms cubic-bezier(0.22, 1, 0.36, 1) both;
    animation-delay: calc(var(--i) * 90ms + 120ms);
  }
  @keyframes statIn {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .report__statLabel {
    font-family: var(--font-primary);
    font-size: 9px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-text-dark);
    /* Keeps the three tiles the same height when a label wraps. */
    min-height: 1.6em;
  }

  .report__statValue {
    margin-top: 0.3rem;
    font-family: var(--font-primary);
    font-size: 13px;
    font-weight: 700;
    color: var(--color-text-light);
    font-variant-numeric: tabular-nums;
  }
  .report__stat:first-child .report__statValue {
    color: var(--color-primary);
  }

  /* ── Bars ──────────────────────────────────────────────────────────── */
  .report__chart {
    display: flex;
    align-items: flex-end;
    gap: 0.4rem;
    height: 4.5rem;
    padding: 0 0.1rem;
  }

  .report__bar {
    flex: 1;
    height: var(--h);
    border-radius: 0.22rem 0.22rem 0 0;
    background: color-mix(in srgb, var(--color-text-dark) 40%, transparent);
    transform: scaleY(0);
    transform-origin: bottom;
  }
  .report__bar[data-today] {
    background: var(--color-primary);
  }
  :global([data-play="true"]) .report__bar {
    animation: barGrow 420ms cubic-bezier(0.22, 1, 0.36, 1) both;
    animation-delay: calc(var(--i) * 65ms + 420ms);
  }
  @keyframes barGrow {
    to {
      transform: scaleY(1);
    }
  }

  .report__chartLabel {
    margin-top: 0.15rem;
    font-family: var(--font-primary);
    font-size: 9px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-text-dark);
  }

  @media (prefers-reduced-motion: reduce) {
    .report__stat {
      opacity: 1;
      transform: none;
    }
    .report__bar {
      transform: scaleY(1);
    }
    :global([data-play="true"]) .report__stat,
    :global([data-play="true"]) .report__bar {
      animation: none;
    }
  }
</style>
