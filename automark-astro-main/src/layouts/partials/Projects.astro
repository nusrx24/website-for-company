---
import ImageMod from "@/components/ImageMod.astro";
import ProjectsMorphGallery from "@/components/ProjectsMorphGallery";
import { markdownify } from "@/lib/utils/textConverter";
import type { Homepage } from "@/types";

export interface Props {
  projects: Homepage["projects"];
}

const { projects } = Astro.props as Props;

// A client who has not agreed to be named is shown by alias instead.
const displayName = (item: Homepage["projects"]["items"][number]) =>
  item.name_public ? item.name : (item.alias ?? "Client project");
---

<section id="projects" class="section scroll-mt-24 projects-section">
  <div class="container">
    <div class="mb-12 max-w-3xl lg:mb-16 projects-intro">
      {
        projects.eyebrow && (
          <p class="mb-4 font-primary text-xs font-semibold tracking-[0.18em] text-primary uppercase">
            {projects.eyebrow}
          </p>
        )
      }
      <h2
        class="text-h3 lg:text-h2 mb-5 leading-[1.1] uppercase hasHighlight"
        set:html={markdownify(projects.title)}
      />
      {
        projects.content && (
          <p class="max-w-2xl text-base text-text">{projects.content}</p>
        )
      }
    </div>

    <div class="grid gap-4 lg:grid-cols-3">
      {
        projects.items.map((item, i) => (
          <article
            class="project-card flex flex-col overflow-hidden rounded-2xl border border-border bg-light"
            style={`--i:${i}`}
          >
            {item.images.length > 0 ? (
              /* object-contain, not cover: these are real screenshots and
                 receipts in mixed aspect ratios, and cropping one would hide
                 the very thing it is meant to prove. */
              <figure class="aspect-[16/10] overflow-hidden border-b border-border bg-body/60 p-3">
                <ImageMod
                  src={item.images[0].src}
                  alt={item.images[0].alt}
                  width={900}
                  class="h-full w-full rounded-md object-contain"
                  format="webp"
                />
              </figure>
            ) : (
              /* No screenshot supplied yet: show the modules the system covers
                 rather than inventing a picture of one. */
              <div class="border-b border-border bg-body/40 p-6">
                <p class="font-primary text-[10px] tracking-[0.14em] text-text-dark uppercase">
                  Covers
                </p>
                <ul class="mt-3 flex flex-wrap gap-1.5">
                  {item.handles.map((h) => (
                    <li class="rounded-md border border-border/70 px-2.5 py-1 font-primary text-[11px] text-text">
                      {h}
                    </li>
                  ))}
                </ul>
              </div>
            )}

            <div class="flex flex-1 flex-col p-6">
              <p class="font-primary text-[10px] tracking-[0.14em] text-text-dark uppercase">
                {item.sector}
                {item.location && ` — ${item.location}`}
              </p>

              <h3 class="text-h6 mt-2 mb-3 leading-tight uppercase">
                {displayName(item)}
              </h3>

              <p class="text-sm leading-[1.75] text-text">{item.summary}</p>

              {item.images.length > 0 && item.handles.length > 0 && (
                <ul class="mt-5 space-y-2 border-t border-border pt-5">
                  {item.handles.map((h) => (
                    <li class="flex gap-2.5 font-primary text-[13px] text-text-dark">
                      <span class="text-primary" aria-hidden="true">
                        /
                      </span>
                      {h}
                    </li>
                  ))}
                </ul>
              )}

              {item.setup && (
                <p class="mt-auto pt-5 font-primary text-[11px] tracking-[0.1em] text-primary uppercase">
                  {item.setup}
                </p>
              )}
            </div>
          </article>
        ))
      }
    </div>

    {/* 3D Scroll Morph Achievement Photo Showcase */}
    <div class="projects-gallery">
      <ProjectsMorphGallery client:load />
    </div>
  </div>
</section>

{/* Native <dialog> lightbox — no JS library, no third-party requests */}
<dialog
  id="photo-lightbox"
  class="lightbox"
  aria-label="Photo viewer"
>
  <div class="lightbox__backdrop"></div>
  <div class="lightbox__content">
    <button
      id="lightbox-close"
      type="button"
      class="lightbox__close"
      aria-label="Close photo viewer"
    >
      <svg
        viewBox="0 0 20 20"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        class="size-5"
        aria-hidden="true"
      >
        <path d="M4 4l12 12M16 4L4 16"></path>
      </svg>
    </button>
    <figure class="lightbox__figure">
      <img id="lightbox-img" src="" alt="" class="lightbox__img" />
      <figcaption id="lightbox-caption" class="lightbox__caption"></figcaption>
    </figure>
  </div>
</dialog>

<style>
  /* ── Project card entrance ────────────────────────────────────────────── */
  .projects-intro,
  .project-card,
  .projects-gallery {
    opacity: 0;
    transform: translateY(14px);
  }

  .projects-section.is-revealed .projects-intro {
    animation: projectsIn 520ms cubic-bezier(0.22, 1, 0.36, 1) both;
  }

  .projects-section.is-revealed .project-card {
    animation: projectsIn 480ms cubic-bezier(0.22, 1, 0.36, 1) both;
    animation-delay: calc(120ms + var(--i) * 100ms);
  }

  .projects-section.is-revealed .projects-gallery {
    animation: projectsIn 500ms cubic-bezier(0.22, 1, 0.36, 1) 480ms both;
  }

  @keyframes projectsIn {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* ── Lightbox ─────────────────────────────────────────────────────────── */
  .lightbox {
    /* Override browser dialog defaults */
    position: fixed;
    inset: 0;
    margin: 0;
    padding: 0;
    max-width: 100vw;
    max-height: 100vh;
    width: 100vw;
    height: 100vh;
    border: none;
    background: transparent;
    overflow: hidden;
    z-index: 100;
  }

  .lightbox:not([open]) {
    display: none;
  }

  .lightbox__backdrop {
    position: absolute;
    inset: 0;
    background: rgb(0 0 0 / 0.88);
    backdrop-filter: blur(6px);
    cursor: zoom-out;
  }

  .lightbox__content {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    height: 100%;
    padding: 2rem;
  }

  .lightbox__close {
    position: absolute;
    top: 1.25rem;
    right: 1.25rem;
    display: flex;
    align-items: center;
    justify-content: center;
    size: 2.5rem;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 9999px;
    border: 1px solid rgb(255 255 255 / 0.2);
    background: rgb(0 0 0 / 0.5);
    color: white;
    cursor: pointer;
    transition: background 200ms ease, border-color 200ms ease;
  }

  .lightbox__close:hover {
    background: rgb(255 255 255 / 0.15);
    border-color: rgb(255 255 255 / 0.5);
  }

  .lightbox__close:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 3px;
  }

  .lightbox__figure {
    display: grid;
    gap: 1rem;
    justify-items: center;
    max-width: min(90vw, 1200px);
    max-height: 90vh;
  }

  .lightbox__img {
    display: block;
    max-width: 100%;
    max-height: calc(90vh - 4rem);
    object-fit: contain;
    border-radius: 0.75rem;
    border: 1px solid rgb(255 255 255 / 0.1);
    box-shadow: 0 32px 80px -20px rgb(0 0 0 / 0.9);
    animation: lightboxIn 280ms cubic-bezier(0.22, 1, 0.36, 1) both;
  }

  .lightbox__caption {
    font-family: var(--font-primary);
    font-size: 13px;
    color: rgb(255 255 255 / 0.6);
    text-align: center;
    max-width: 60ch;
  }

  @keyframes lightboxIn {
    from {
      opacity: 0;
      transform: scale(0.94);
    }
    to {
      opacity: 1;
      transform: scale(1);
    }
  }

  /* ── Reduced motion ───────────────────────────────────────────────────── */
  @media (prefers-reduced-motion: reduce) {
    .projects-intro,
    .project-card,
    .projects-gallery {
      opacity: 1;
      transform: none;
      animation: none !important;
    }
    .lightbox__img {
      animation: none;
    }
  }
</style>

<script>
  (() => {
    // ── Lightbox ───────────────────────────────────────────────────────────
    const dialog = document.getElementById(
      "photo-lightbox",
    ) as HTMLDialogElement | null;
    const img = document.getElementById("lightbox-img") as HTMLImageElement | null;
    const caption = document.getElementById("lightbox-caption");
    const closeBtn = document.getElementById("lightbox-close");
    const backdrop = dialog?.querySelector(".lightbox__backdrop");

    if (dialog && img && caption) {
      const open = (src: string, alt: string) => {
        img.src = src;
        img.alt = alt;
        caption.textContent = alt;
        dialog.showModal();
        document.body.style.overflow = "hidden";
      };

      const close = () => {
        dialog.close();
        document.body.style.overflow = "";
        img.src = "";
      };

      // Clicking the backdrop closes the dialog
      backdrop?.addEventListener("click", close);
      closeBtn?.addEventListener("click", close);

      // Escape key is handled natively by <dialog>, but we need to clean up overflow
      dialog.addEventListener("close", () => {
        document.body.style.overflow = "";
      });

      // Wire up all gallery triggers
      document
        .querySelectorAll<HTMLButtonElement>(".gallery-trigger")
        .forEach((btn) => {
          btn.addEventListener("click", () => {
            const src = btn.dataset.photoSrc ?? "";
            const alt = btn.dataset.photoAlt ?? "";
            if (src) open(src, alt);
          });
        });
    }

    // ── Entrance animation ─────────────────────────────────────────────────
    const section = document.getElementById("projects");
    if (!section) return;

    const reduced = window.matchMedia("(prefers-reduced-motion: reduce)");

    if (reduced.matches) {
      section.classList.add("is-revealed");
      return;
    }

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          section.classList.add("is-revealed");
          observer.disconnect();
        });
      },
      { threshold: 0.08 },
    );
    observer.observe(section);
  })();
</script>
