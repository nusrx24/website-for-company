---
import { whatsappUrl } from "@/lib/utils/contact";

const whatsappLink = whatsappUrl(
  "Hello LapCircuit, I would like to build a website for my business.",
);
---

<section id="websites" class="section website-promo">
  <div class="wrap website-promo__container">
    <div class="website-promo__content">
      <span class="website-promo__label">WEBSITE DEVELOPMENT</span>
      <h2 class="website-promo__heading">
        YOUR BUSINESS DESERVES A WEBSITE.
      </h2>
      <p class="website-promo__desc">
        We create modern websites that showcase your business, help customers
        discover your products and services, and build your online presence.
      </p>

      <ul class="website-promo__benefits" role="list">
        <li class="website-promo__benefit">
          <div class="website-promo__benefit-icon" aria-hidden="true">
            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <rect x="2" y="3" width="20" height="14" rx="2" ry="2"></rect>
              <line x1="8" y1="21" x2="16" y2="21"></line>
              <line x1="12" y1="17" x2="12" y2="21"></line>
            </svg>
          </div>
          <div class="website-promo__benefit-body">
            <h3 class="website-promo__benefit-title">Showcase Your Business</h3>
            <p class="website-promo__benefit-text">
              Present your products and services professionally.
            </p>
          </div>
        </li>

        <li class="website-promo__benefit">
          <div class="website-promo__benefit-icon" aria-hidden="true">
            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <circle cx="12" cy="12" r="10"></circle>
              <line x1="2" y1="12" x2="22" y2="12"></line>
              <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path>
            </svg>
          </div>
          <div class="website-promo__benefit-body">
            <h3 class="website-promo__benefit-title">Reach More Customers</h3>
            <p class="website-promo__benefit-text">
              Help people discover your business online.
            </p>
          </div>
        </li>

        <li class="website-promo__benefit">
          <div class="website-promo__benefit-icon" aria-hidden="true">
            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"></path>
            </svg>
          </div>
          <div class="website-promo__benefit-body">
            <h3 class="website-promo__benefit-title">Built Around Your Needs</h3>
            <p class="website-promo__benefit-text">
              Websites designed for your business goals.
            </p>
          </div>
        </li>
      </ul>

      <div class="website-promo__cta">
        <a
          class="btn btn-shiny"
          href={whatsappLink}
          target="_blank"
          rel="noopener noreferrer"
        >
          <span>Let's Build Your Website</span>
        </a>
      </div>
    </div>

    <div class="website-promo__visual">
      <div class="metal-frame website-promo__frame">
        <img
          src="/images/website-showcase.webp"
          alt="Modern business website preview displayed on laptop and smartphone"
          width="1376"
          height="768"
          loading="lazy"
          decoding="async"
        />
      </div>
    </div>
  </div>
</section>

<style>
  .website-promo {
    position: relative;
    overflow: hidden;
  }

  .website-promo__container {
    display: grid;
    gap: clamp(2.5rem, 5vw, 4.5rem);
    align-items: center;
  }

  .website-promo__content {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .website-promo__label {
    display: inline-block;
    color: var(--color-primary);
    font-family: var(--font-secondary);
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    margin-bottom: 0.875rem;
  }

  .website-promo__heading {
    color: var(--color-text-light);
    font-size: clamp(2rem, 3.6vw, 3.25rem);
    font-weight: 700;
    line-height: 1.12;
    letter-spacing: -0.015em;
    text-transform: uppercase;
    margin: 0;
  }

  .website-promo__desc {
    margin-top: 1.25rem;
    color: var(--color-text);
    font-size: clamp(1rem, 1.25vw, 1.125rem);
    line-height: 1.625;
    max-width: 52ch;
  }

  .website-promo__benefits {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    margin: 2rem 0 0;
    padding: 0;
    list-style: none;
    width: 100%;
  }

  .website-promo__benefit {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
  }

  .website-promo__benefit-icon {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 0.5rem;
    background-color: color-mix(in srgb, var(--color-primary) 12%, transparent);
    border: 1px solid color-mix(in srgb, var(--color-primary) 28%, transparent);
    color: var(--color-primary);
    margin-top: 0.125rem;
  }

  .website-promo__benefit-icon svg {
    width: 1.2rem;
    height: 1.2rem;
  }

  .website-promo__benefit-body {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .website-promo__benefit-title {
    font-size: 1rem;
    font-weight: 600;
    color: var(--color-text-light);
    line-height: 1.35;
    margin: 0;
  }

  .website-promo__benefit-text {
    font-size: 0.875rem;
    color: var(--color-text-dark);
    line-height: 1.5;
    margin: 0;
  }

  .website-promo__cta {
    margin-top: 2.25rem;
  }

  .website-promo__visual {
    position: relative;
  }

  .website-promo__visual::before {
    content: "";
    position: absolute;
    inset: 5%;
    background: radial-gradient(
      circle,
      color-mix(in srgb, var(--color-primary) 22%, transparent) 0%,
      transparent 70%
    );
    filter: blur(50px);
    z-index: 0;
    pointer-events: none;
  }

  .website-promo__frame {
    position: relative;
    z-index: 1;
    border-radius: 1rem;
    overflow: hidden;
    box-shadow: 0 20px 48px -16px rgb(0 0 0 / 0.7);
  }

  .website-promo__frame img {
    display: block;
    width: 100%;
    height: auto;
    object-fit: cover;
  }

  @media (min-width: 1024px) {
    .website-promo__container {
      grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);
      gap: 3.5rem;
    }
  }

  @media (min-width: 1280px) {
    .website-promo__container {
      gap: 4.5rem;
    }
  }

  @media (max-width: 479.98px) {
    .website-promo__cta .btn {
      width: 100%;
    }
  }
</style>
