---
import { markdownify } from "@/lib/utils/textConverter";
import type { Homepage } from "@/types";
import { BenefitsCards } from "@/components/BenefitsCards";

export interface Props {
  benefits: Homepage["benefits"];
}

const { benefits } = Astro.props as Props;

/**
 * Redesigned benefits section using color-change hover cards.
 * Each card represents one stage of a sale: checkout, stock, reporting, receipt.
 * Images desaturate at rest and become vivid on hover, with letter-by-letter
 * title animation powered by framer-motion.
 */
const cardData = benefits.acts.map((act) => {
  const imageMap: Record<string, string> = {
    checkout: "/images/benefits-checkout.jpg",
    stock: "/images/benefits-stock.jpg",
    report: "/images/benefits-report.jpg",
    receipt: "/images/benefits-receipt.jpg",
  };

  return {
    kicker: act.kicker,
    heading: act.title,
    description: act.content,
    imgSrc: imageMap[act.key] || "/images/benefits-checkout.jpg",
  };
});
---

<section id="benefits" class="benefits section scroll-mt-24">
  <div class="container">
    <div class="benefits__intro">
      {
        benefits.eyebrow && (
          <p class="mb-4 font-primary text-xs font-semibold tracking-[0.18em] text-primary uppercase">
            {benefits.eyebrow}
          </p>
        )
      }
      <h2
        class="text-h3 lg:text-h2 mb-5 leading-[1.1] uppercase hasHighlight"
        set:html={markdownify(benefits.title)}
      />
      {
        benefits.content && (
          <p class="max-w-2xl text-base leading-[1.75] text-text">
            {benefits.content}
          </p>
        )
      }
    </div>

    {/* Color-change hover cards — React island */}
    <BenefitsCards client:visible benefits={cardData} />

    <p class="benefits__note">{benefits.demo_note}</p>
  </div>
</section>

<style>
  .benefits__intro {
    max-width: 48rem;
    margin-bottom: 3rem;
    opacity: 0;
    transform: translateY(14px);
  }
  @media (min-width: 1024px) {
    .benefits__intro {
      margin-bottom: 4rem;
    }
  }

  .benefits.is-revealed .benefits__intro {
    animation: benefitIn 520ms cubic-bezier(0.22, 1, 0.36, 1) both;
  }

  @keyframes benefitIn {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .benefits__note {
    margin-top: 2.5rem;
    padding-left: 0.85rem;
    border-left: 2px solid color-mix(in srgb, var(--color-primary) 45%, transparent);
    font-family: var(--font-primary);
    font-size: 11.5px;
    line-height: 1.7;
    color: var(--color-text-dark);
  }
  @media (min-width: 1024px) {
    .benefits__note {
      margin-top: 3.5rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .benefits__intro {
      opacity: 1;
      transform: none;
      animation: none !important;
    }
  }
</style>

<script>
  (() => {
    const section = document.getElementById("benefits");
    if (!section) return;

    const reduced = window.matchMedia("(prefers-reduced-motion: reduce)");

    if (reduced.matches) {
      section.classList.add("is-revealed");
      return;
    }

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          section.classList.add("is-revealed");
          observer.disconnect();
        });
      },
      { threshold: 0.1 },
    );
    observer.observe(section);
  })();
</script>
