---
import LegoBrick from "@/components/LegoBrick.astro";
import type { Homepage } from "@/types";

export interface Props {
  process: Homepage["process"];
}

const { process } = Astro.props as Props;

// The wall is six studs wide. Each step is a brick; the widths are chosen so
// that every row adds up to six and the joins never line up (4+2, 3+3, 2+4),
// the way real brickwork is laid.
const COLS = 6;
const BRICKS = [
  { studs: 4, color: "blue", swatch: "#0ea5e9" },
  { studs: 2, color: "teal", swatch: "#14b8a6" },
  { studs: 3, color: "fuchsia", swatch: "#c026d3" },
  { studs: 3, color: "grey", swatch: "#9ca3af" },
  { studs: 2, color: "red", swatch: "#ef4444" },
  { studs: 4, color: "green", swatch: "#22c55e" },
] as const;

// Lay the bricks in order: each goes in the lowest row that still has room
// for it, as far left as it fits.
const taken: boolean[][] = [];
const bricks = process.steps.map((step, index) => {
  const { studs, color, swatch } = BRICKS[index % BRICKS.length];
  let row = 0;
  let col = -1;

  while (col === -1) {
    taken[row] ??= Array(COLS).fill(false);
    let run = 0;
    for (let c = 0; c < COLS; c++) {
      run = taken[row][c] ? 0 : run + 1;
      if (run === studs) {
        col = c - studs + 1;
        break;
      }
    }
    if (col === -1) row++;
  }

  for (let c = col; c < col + studs; c++) taken[row][c] = true;

  return {
    ...step,
    index,
    number: String(index + 1).padStart(2, "0"),
    studs,
    color,
    swatch,
    row,
    col,
  };
});

const rows = taken.length;
const { builder } = process;
---

{/* How we work, as something you build. "Your business" is the base brick
    and each step is a brick that goes on top of it, in order. The numbered
    list underneath says the same thing in words and is what a screen reader,
    a search engine or a browser without JavaScript gets. */}
<section id="process" class="section process">
  <div class="wrap">
    <div class="section-head">
      <h2 data-breathe>{process.title}</h2>
      {process.content && <p>{process.content}</p>}
    </div>

    <div
      class="lego"
      data-lego
      data-hint={builder.hint}
      data-progress={builder.progress}
      data-done={builder.done}
      style={`--rows:${rows}`}
    >
      {/* Loose bricks. A slot keeps its place (and a faint label) while its
          brick is on the wall, so the tray never reshuffles. */}
      <div class="lego__tray">
        {
          bricks.map((brick) => (
            <div
              class="lego__slot"
              data-slot
              data-label={`${brick.number} ${brick.title}`}
              style={`--studs:${brick.studs}`}
            >
              <button
                type="button"
                class="lego__brick"
                data-brick
                aria-pressed="false"
                aria-label={`Step ${brick.index + 1}: ${brick.title}`}
              >
                <LegoBrick color={brick.color} studs={brick.studs}>
                  <span class="lego__label">
                    <span class="lego__chip">{brick.number}</span>
                    <span class="lego__name">{brick.title}</span>
                  </span>
                </LegoBrick>
              </button>
            </div>
          ))
        }
      </div>

      {/* The build: numbered outlines show where each step goes. */}
      <div class="lego__stage">
        <div class="lego__base" data-base>
          <div class="lego__stack">
            {
              bricks.map((brick) => (
                <div
                  class="lego__cell"
                  data-cell
                  data-number={brick.number}
                  data-row={brick.row}
                  data-col={brick.col}
                  data-studs={brick.studs}
                  style={`--row:${brick.row};--col:${brick.col};--studs:${brick.studs}`}
                />
              ))
            }
          </div>

          <LegoBrick color="yellow" studs={COLS}>
            <span class="lego__plate">
              <span class="lego__plate-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M3 9l1.5-5h15L21 9"></path>
                  <path d="M3 9a3 3 0 0 0 6 0 3 3 0 0 0 6 0 3 3 0 0 0 6 0"></path>
                  <path d="M5 12v8h14v-8"></path>
                  <path d="M10 20v-5h4v5"></path>
                </svg>
              </span>
              <span class="lego__plate-text">
                <span class="lego__plate-title">{builder.base}</span>
                <span class="lego__status" data-status aria-live="polite">
                  {builder.idle}
                </span>
              </span>
            </span>
          </LegoBrick>
        </div>
      </div>
    </div>

    <ol class="steps">
      {
        bricks.map((brick) => (
          <li class="steps__item" data-step style={`--swatch:${brick.swatch}`}>
            {/* The <ol> already carries the order for assistive tech. */}
            <span class="steps__number" aria-hidden="true">
              <span class="steps__swatch" />
              {brick.number}
            </span>
            <h3>{brick.title}</h3>
            <p>{brick.content}</p>
          </li>
        ))
      }
    </ol>

    {process.warranty && <p class="steps__warranty">{process.warranty}</p>}
  </div>
</section>

<style>
  /* A brick stretches a little as it jumps; on a narrow screen that would
     otherwise widen the page for a moment. */
  .process {
    overflow-x: clip;
  }

  /* ── Builder ────────────────────────────────────────────────────────────
     --stud is the width of one stud. Every brick and the wall are sized from
     it, so the whole thing scales by changing this one value. */
  .lego {
    --stud: min(65px, calc((100vw - 2.5rem - 8px) / 6));
    --tray-gap: 8px;
    display: flex;
    flex-direction: column;
    align-items: center;
    /* Stacked on a phone: kept close so the loose bricks and the base brick
       are on screen together. */
    gap: 1.75rem;
    margin-bottom: clamp(2.5rem, 7vw, 5.5rem);
    user-select: none;
  }

  .lego__tray {
    display: flex;
    flex-wrap: wrap;
    gap: 16px var(--tray-gap);
    width: calc(6 * var(--stud) + var(--tray-gap));
    max-width: 100%;
  }

  .lego__slot {
    position: relative;
    width: calc(var(--studs) * var(--stud));
    height: 94px;
  }

  /* What is left in the tray once the brick has gone to the wall. */
  .lego__slot::before {
    content: attr(data-label);
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1px dashed rgb(255 255 255 / 0.16);
    border-radius: 4px;
    color: var(--color-text-dark);
    font-size: 0.75rem;
    white-space: nowrap;
  }

  /* ── A step brick ───────────────────────────────────────────────────── */
  .lego__brick {
    position: relative;
    display: block;
    width: 100%;
    padding: 0;
    border: 0;
    border-radius: 8px;
    background: none;
    color: inherit;
    font: inherit;
    text-align: left;
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
    /* Lets the label below adapt to the brick's own width. */
    container-type: inline-size;
    transition: transform 0.2s ease;
  }

  .lego__brick::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 5;
    border-radius: 8px;
    pointer-events: none;
    transition: background-color 0.2s ease;
  }

  @media (hover: hover) {
    .lego__brick:hover {
      transform: translateY(-6px);
    }

    .lego__brick:hover::after {
      background-color: rgb(255 255 255 / 0.1);
    }
  }

  .lego__brick:active {
    transform: scale(0.95);
  }

  /* In the air: above everything, and not clickable until it lands. */
  .lego__brick.is-flying {
    z-index: 60;
    pointer-events: none;
  }

  .lego__label {
    display: flex;
    align-items: center;
    gap: 12px;
    height: 60px;
    padding-inline: 16px;
  }

  .lego__chip {
    display: flex;
    flex: none;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: 8px;
    background: var(--brick-chip);
    box-shadow: inset 0 2px 4px rgb(0 0 0 / 0.06);
    color: #fff;
    font-size: 0.8125rem;
    font-weight: 500;
    text-shadow: 0 1px 1px rgb(0 0 0 / 0.3);
  }

  .lego__name {
    overflow: hidden;
    color: #fff;
    font-family: var(--font-secondary);
    font-size: 1.0625rem;
    font-weight: 700;
    letter-spacing: 0.025em;
    text-overflow: ellipsis;
    text-shadow: 0 1px 1px rgb(0 0 0 / 0.5);
    white-space: nowrap;
  }

  /* Narrower bricks: a smaller number chip and name. */
  @container (max-width: 170px) {
    .lego__label {
      gap: 10px;
      padding-inline: 12px;
    }

    .lego__chip {
      width: 28px;
      height: 28px;
      border-radius: 6px;
      font-size: 0.6875rem;
    }

    .lego__name {
      font-size: 0.9375rem;
    }
  }

  @container (max-width: 112px) {
    .lego__label {
      gap: 6px;
      padding-inline: 8px;
    }

    .lego__chip {
      width: 22px;
      height: 22px;
      border-radius: 5px;
      font-size: 0.6875rem;
    }

    .lego__name {
      font-size: 0.875rem;
      letter-spacing: 0;
    }
  }

  /* ── Stage: base brick and the wall above it ────────────────────────── */
  .lego__stage {
    flex: none;
    width: calc(6 * var(--stud));
    /* Room for the finished wall, so nothing on the page moves as it grows. */
    padding-top: calc(var(--rows) * 80px + 12px);
  }

  .lego__base {
    position: relative;
    border-radius: 12px;
    box-shadow: 0 15px 35px rgb(0 0 0 / 0.25);
  }

  /* Bricks overlap the one below by 14px, which is what makes them look
     pressed on: a brick is 94px tall and each row rises 80px. */
  .lego__stack {
    position: absolute;
    bottom: calc(100% - 14px);
    left: 0;
    width: 100%;
    height: 0;
  }

  .lego__cell {
    position: absolute;
    bottom: calc(var(--row) * 80px);
    left: calc(var(--col) * var(--stud));
    z-index: calc(var(--row) * 10 + 1);
    width: calc(var(--studs) * var(--stud));
    height: 94px;
  }

  /* The outline of a brick that is not there yet. */
  .lego__cell::before {
    content: attr(data-number);
    position: absolute;
    inset: 1px 1px 15px;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1px dashed rgb(255 255 255 / 0.16);
    border-radius: 4px;
    color: var(--color-text-dark);
    font-size: 0.75rem;
  }

  .lego__plate {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 20px 20px 16px;
  }

  .lego__plate-icon {
    display: flex;
    flex: none;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: 12px;
    background: var(--brick-chip);
    box-shadow: inset 0 2px 4px rgb(0 0 0 / 0.06);
    color: #241a00;
  }

  .lego__plate-text {
    display: block;
    min-width: 0;
  }

  /* Dark lettering: white on this yellow is too faint to read. */
  .lego__plate-title {
    display: block;
    color: #241a00;
    font-family: var(--font-secondary);
    font-size: 1.0625rem;
    font-weight: 700;
    letter-spacing: 0.025em;
    line-height: 1.2;
  }

  .lego__status {
    display: block;
    margin-top: 6px;
    color: rgb(36 26 0 / 0.75);
    font-size: 0.625rem;
    font-weight: 500;
    letter-spacing: 0.2em;
    line-height: 1.4;
    text-transform: uppercase;
  }

  /* ── The steps in words ─────────────────────────────────────────────── */
  .steps {
    display: grid;
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--color-border);
  }

  .steps__item {
    padding-block: 1.5rem 1.75rem;
    border-bottom: 1px solid var(--color-border);
  }

  .steps__number {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--color-text-dark);
    font-size: 0.8125rem;
    transition: color 0.3s ease;
  }

  /* Matches the brick's colour: an outline until the brick is on the wall,
     filled once it is. */
  .steps__swatch {
    width: 10px;
    height: 10px;
    border: 1.5px solid var(--swatch);
    border-radius: 3px;
    transition: background-color 0.3s ease;
  }

  .steps__item.is-built .steps__number {
    color: #fff;
  }

  .steps__item.is-built .steps__swatch {
    background-color: var(--swatch);
  }

  .steps__item h3 {
    margin-block: 0.625rem 0.5rem;
  }

  .steps__item p {
    max-width: 34ch;
  }

  .steps__warranty {
    max-width: 62ch;
    margin-top: clamp(2rem, 4vw, 3rem);
    color: var(--color-text-light);
  }

  /* Phone: each step is one compact row - number on the left, the name and
     its sentence beside it - so all six can be read in about a screen. The
     line under the base brick is set a size larger and less widely spaced,
     so it stays readable and still fits the brick on the narrowest phone. */
  @media (max-width: 639.98px) {
    .lego__status {
      font-size: 0.6875rem;
      letter-spacing: 0.14em;
    }

    .steps__item {
      display: grid;
      grid-template-columns: auto minmax(0, 1fr);
      column-gap: 1rem;
      align-items: center;
      padding-block: 1rem 1.125rem;
    }

    .steps__item h3 {
      margin-block: 0;
      font-size: 1.125rem;
    }

    .steps__item p {
      grid-column: 2;
      max-width: none;
      margin-top: 0.25rem;
    }
  }

  @media (min-width: 640px) {
    .steps {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: 2.5rem;
      border-top: 0;
    }

    .steps__item {
      border-top: 1px solid var(--color-border);
      border-bottom: 0;
      padding-block: 1.5rem 2.5rem;
    }
  }

  /* Tray beside the wall once there is room for both. */
  @media (min-width: 900px) {
    .lego {
      --stud: 56px;
      --tray-gap: 20px;
      flex-direction: row;
      justify-content: space-between;
      gap: 3rem;
    }

    .lego__tray {
      row-gap: 20px;
    }
  }

  @media (min-width: 1024px) {
    .steps {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      column-gap: 3rem;
    }
  }

  @media (min-width: 1100px) {
    .lego {
      --stud: 65px;
    }
  }
</style>

<script>
  // The builder. Bricks always sit on the wall as an unbroken run from step
  // one, because the steps are a sequence: clicking a loose brick places it
  // and every step before it; clicking a placed brick lifts it off together
  // with every step after it.

  const STAGGER = 160; // ms between one brick setting off and the next
  const DURATION = 1200; // ms for one jump
  const APEX = 150; // px the arc rises above the higher of its two ends

  function setup(root: HTMLElement) {
    const bricks = [...root.querySelectorAll<HTMLButtonElement>("[data-brick]")];
    const slots = [...root.querySelectorAll<HTMLElement>("[data-slot]")];
    const cells = [...root.querySelectorAll<HTMLElement>("[data-cell]")];
    const base = root.querySelector<HTMLElement>("[data-base]");
    const status = root.querySelector<HTMLElement>("[data-status]");
    const section = root.closest("section") ?? root;
    const legend = [...section.querySelectorAll<HTMLElement>("[data-step]")];
    if (!base || bricks.length === 0 || cells.length !== bricks.length) return;

    const total = bricks.length;
    const baseStuds = [...base.querySelectorAll<HTMLElement>(":scope > .brick .stud")];
    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)");

    // Where each brick sits in the wall, read from the markup.
    const layout = cells.map((cell) => ({
      row: Number(cell.dataset.row),
      col: Number(cell.dataset.col),
      studs: Number(cell.dataset.studs),
    }));

    const wanted = bricks.map(() => false); // should be on the wall
    const landed = bricks.map(() => false); // is on the wall and at rest
    const timers: number[] = [];
    const flights: (Animation | undefined)[] = [];

    // Is the stud at this row and column underneath a brick that has landed?
    const covered = (row: number, column: number) =>
      layout.some(
        (brick, index) =>
          landed[index] &&
          brick.row === row + 1 &&
          column >= brick.col &&
          column < brick.col + brick.studs,
      );

    function refresh() {
      bricks.forEach((brick, index) => {
        brick.querySelectorAll(".stud").forEach((stud, k) => {
          const { row, col } = layout[index];
          stud.classList.toggle("is-hidden", landed[index] && covered(row, col + k));
        });
        legend[index]?.classList.toggle("is-built", landed[index]);
      });
      baseStuds.forEach((stud, k) => stud.classList.toggle("is-hidden", covered(-1, k)));

      if (!status) return;
      const count = landed.filter(Boolean).length;
      const { hint = "", progress = "", done = "" } = root.dataset;
      status.textContent =
        count === 0
          ? hint
          : count === total
            ? done
            : progress.replace("{n}", String(count)).replace("{total}", String(total));
    }

    function settle(index: number) {
      bricks[index].classList.remove("is-flying");
      landed[index] = wanted[index];
      refresh();
    }

    // The thud as a brick lands: the whole build dips and recovers.
    function thud() {
      base?.animate(
        [
          { transform: "translateY(0)" },
          { transform: "translateY(10px)", offset: 0.4 },
          { transform: "translateY(-3px)", offset: 0.7 },
          { transform: "translateY(0)" },
        ],
        { duration: 400, easing: "ease-in-out" },
      );
    }

    // Move one brick to wherever it is wanted. The brick is re-parented
    // first and then animated from where it was to where it now is, so it
    // can be interrupted mid-air and still set off from the right place.
    function move(index: number) {
      const brick = bricks[index];
      const destination = wanted[index] ? cells[index] : slots[index];
      if (brick.parentElement === destination) return;

      const from = brick.getBoundingClientRect();
      flights[index]?.cancel();

      const hadFocus = document.activeElement === brick;
      landed[index] = false;
      destination.appendChild(brick);
      if (hadFocus) brick.focus({ preventScroll: true });
      brick.setAttribute("aria-pressed", String(wanted[index]));
      refresh();

      if (reduceMotion.matches) {
        settle(index);
        return;
      }

      const to = brick.getBoundingClientRect();
      const dx = from.left - to.left;
      const dy = from.top - to.top;
      const apex = Math.min(dy, 0) - APEX;
      const at = (x: number, y: number, sx: number, sy: number) =>
        `translate(${x}px, ${y}px) scale(${sx}, ${sy})`;
      const shadow = (y: number, blur: number, alpha: number) =>
        `drop-shadow(0px ${y}px ${blur}px rgba(0, 0, 0, ${alpha}))`;

      brick.classList.add("is-flying");
      const flight = brick.animate(
        [
          { transform: at(dx, dy, 1, 1), filter: shadow(10, 15, 0.2), offset: 0 },
          { transform: at(dx, dy, 1.1, 0.85), filter: shadow(5, 5, 0.3), offset: 0.15 },
          { transform: at(dx * 0.75, dy + (apex - dy) * 0.5, 0.9, 1.15), filter: shadow(30, 20, 0.05), offset: 0.35 },
          { transform: at(dx * 0.5, apex, 1, 1), filter: shadow(40, 20, 0), offset: 0.55 },
          { transform: at(dx * 0.25, apex * 0.5, 0.9, 1.15), filter: shadow(30, 20, 0.05), offset: 0.75 },
          { transform: at(0, 0, 1.15, 0.85), filter: shadow(5, 5, 0.3), offset: 0.9 },
          { transform: at(0, 0, 1, 1), filter: shadow(10, 15, 0.2), offset: 1 },
        ],
        { duration: DURATION, easing: "cubic-bezier(0.25, 1, 0.5, 1)", fill: "both" },
      );

      flights[index] = flight;
      flight.onfinish = () => {
        flight.cancel();
        flights[index] = undefined;
        settle(index);
      };

      if (wanted[index]) {
        window.setTimeout(() => {
          if (flights[index] === flight) thud();
        }, DURATION * 0.9);
      }
    }

    // Bring the wall to "the first `count` steps are placed", one brick
    // after another: upwards when building, top first when taking apart.
    function build(count: number) {
      let delay = 0;
      const send = (index: number, toWall: boolean) => {
        wanted[index] = toWall;
        window.clearTimeout(timers[index]);
        timers[index] = window.setTimeout(() => move(index), delay);
        delay += STAGGER;
      };

      for (let index = 0; index < count; index++) {
        if (!wanted[index]) send(index, true);
      }
      for (let index = total - 1; index >= count; index--) {
        if (wanted[index]) send(index, false);
      }
    }

    bricks.forEach((brick, index) => {
      brick.addEventListener("click", () => build(wanted[index] ? index : index + 1));
    });

    // The soft highlight on each brick follows the pointer.
    section.addEventListener("pointermove", (event) => {
      const { clientX, clientY } = event as PointerEvent;
      root.style.setProperty("--mx", `${(clientX / window.innerWidth) * 100}%`);
      root.style.setProperty("--my", `${(clientY / window.innerHeight) * 100}%`);
    });

    refresh();
  }

  document.querySelectorAll<HTMLElement>("[data-lego]").forEach(setup);
</script>
