---
import { markdownify } from "@/lib/utils/textConverter";
import type { Homepage } from "@/types";
import { WorkflowTimeline } from "@/components/WorkflowTimeline";

export interface Props {
  process: Homepage["process"];
}

const { process } = Astro.props as Props;
---

<section id="process" class="section scroll-mt-24 process-section pt-16 pb-0">
  <div class="container mb-8 lg:mb-12">
    <div class="max-w-3xl process-intro">
      {
        process.eyebrow && (
          <p class="mb-4 font-primary text-xs font-semibold tracking-[0.18em] text-primary uppercase">
            {process.eyebrow}
          </p>
        )
      }
      <h2
        class="text-h3 lg:text-h2 mb-5 leading-[1.1] uppercase hasHighlight"
        set:html={markdownify(process.title)}
      />
      {
        process.content && (
          <p class="max-w-2xl text-base leading-[1.75] text-text">
            {process.content}
          </p>
        )
      }
    </div>
  </div>

  {/* GSAP Horizontal Scroll Timeline */}
  <WorkflowTimeline
    client:visible
    title="HOW WE WORK"
    periodLabel="STEP 01 — 06"
    imageUrl="/images/hardware-counter.webp"
    imageAlt="LapCircuit POS counter hardware setup"
  />
</section>

<style>
  .process-intro {
    opacity: 0;
    transform: translateY(14px);
  }

  .process-section.is-revealed .process-intro {
    animation: processIn 520ms cubic-bezier(0.22, 1, 0.36, 1) both;
  }

  @keyframes processIn {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .process-intro {
      opacity: 1;
      transform: none;
      animation: none !important;
    }
  }
</style>

<script>
  (() => {
    const section = document.getElementById("process");
    if (!section) return;

    const reduced = window.matchMedia("(prefers-reduced-motion: reduce)");

    if (reduced.matches) {
      section.classList.add("is-revealed");
      return;
    }

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          section.classList.add("is-revealed");
          observer.disconnect();
        });
      },
      { threshold: 0.1 },
    );
    observer.observe(section);
  })();
</script>
