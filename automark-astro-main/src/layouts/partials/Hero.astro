---
import { whatsappUrl } from "@/lib/utils/contact";
import { markdownify } from "@/lib/utils/textConverter";
import type { Homepage } from "@/types";
import { KineticFabric } from "@/components/ui/kinetic-particle-fabric";

export interface Props {
  banner: Homepage["banner"];
}

const { banner } = Astro.props as Props;

// Content files say `link: "whatsapp"` so the number stays in config.json only.
const resolve = (link: string) => (link === "whatsapp" ? whatsappUrl() : link);
---

<section class="hero-section relative overflow-hidden pt-32 pb-16 lg:pt-44 lg:pb-24">
  {/* Kinetic particle fabric — fills the entire hero as an interactive background */}
  <div class="absolute inset-0 -z-10" aria-hidden="true">
    <KineticFabric
      client:load
      headline=""
      tagline=""
      showControls={false}
      accentColor="#2E90FF"
      bgColor="#05070A"
      strokeRGB="255, 255, 255"
      className="h-full w-full"
    />
  </div>

  {/* Gradient overlays so text remains readable over the animation */}
  <div
    class="pointer-events-none absolute inset-0 -z-[5]"
    style="background: linear-gradient(to bottom, rgba(5,7,10,0.6) 0%, rgba(5,7,10,0.3) 40%, rgba(5,7,10,0.7) 100%);"
    aria-hidden="true"
  >
  </div>

  <div class="container relative">
    <div class="grid items-center gap-12 lg:grid-cols-12 lg:gap-10">
      <!-- copy -->
      <div class="hero-copy lg:col-span-5">
        {
          banner.eyebrow && (
            <p class="mb-5 font-primary text-xs font-semibold tracking-[0.18em] text-primary uppercase">
              {banner.eyebrow}
            </p>
          )
        }

        <!-- Lifetime Ownership Differentiator Badge -->
        <div class="mb-4 inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full border border-[#2E90FF]/40 bg-[#2E90FF]/15 shadow-[0_0_20px_rgba(46,144,255,0.25)] backdrop-blur-md">
          <span class="relative flex size-2">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-[#2E90FF] opacity-75"></span>
            <span class="relative inline-flex rounded-full size-2 bg-[#2E90FF]"></span>
          </span>
          <span class="font-mono text-[11px] sm:text-xs font-bold text-[#93C5FD] tracking-wider uppercase">
            Paid Once &bull; Yours For Life &bull; Zero Monthly Subscriptions
          </span>
        </div>

        <h1
          class="text-h3 lg:text-h1 mb-6 leading-[1.05] uppercase hasHighlight"
          set:html={markdownify(banner.title)}
        />

        <p class="mb-8 max-w-xl text-base leading-[1.75] text-text">
          {banner.content}
        </p>

        {
          banner.price_signal && (
            <div class="mb-8 inline-flex flex-col rounded-xl border border-border bg-light/80 backdrop-blur-sm px-5 py-4">
              <span class="font-primary text-[11px] tracking-[0.14em] text-text-dark uppercase">
                {banner.price_signal.label}
              </span>
              <span class="mt-1 font-primary text-xl font-bold text-primary lg:text-2xl">
                {banner.price_signal.value}
              </span>
            </div>
          )
        }

        <div class="flex flex-wrap items-center gap-4">
          {
            banner.button_primary.enable && (
              <a
                class="btn btn-primary"
                href={resolve(banner.button_primary.link)}
                target={
                  banner.button_primary.link === "whatsapp" ? "_blank" : null
                }
                rel="noopener noreferrer"
              >
                {banner.button_primary.label}
              </a>
            )
          }
          {
            banner.button_secondary.enable && (
              <a class="btn btn-outline" href={banner.button_secondary.link}>
                {banner.button_secondary.label}
                <span aria-hidden="true">&rarr;</span>
              </a>
            )
          }
        </div>

        <!-- Value commitment bullet points -->
        <div class="mt-6 flex flex-wrap items-center gap-x-5 gap-y-2 text-xs font-medium text-slate-300">
          <span class="inline-flex items-center gap-1.5 text-emerald-400">
            <svg class="size-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
            </svg>
            <strong class="text-white">Pay Once For Life</strong>
          </span>
          <span class="inline-flex items-center gap-1.5 text-emerald-400">
            <svg class="size-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
            </svg>
            <strong class="text-white">Rs. 0 Monthly Fees</strong>
          </span>
          <span class="inline-flex items-center gap-1.5 text-emerald-400">
            <svg class="size-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
            </svg>
            <strong class="text-white">Works 100% Offline</strong>
          </span>
        </div>

        {
          banner.trust_signals.length > 0 && (
            <ul class="mt-9 flex flex-wrap items-center gap-x-3 gap-y-2 font-primary text-[11px] tracking-[0.12em] text-text-dark uppercase">
              {banner.trust_signals.map((signal, i) => (
                <>
                  {i > 0 && (
                    <li aria-hidden="true" class="text-border">
                      &bull;
                    </li>
                  )}
                  <li>{signal}</li>
                </>
              ))}
            </ul>
          )
        }
      </div>

      <!-- visual: the POS demo film is the whole right-hand column -->
      <div class="hero-visual-col lg:col-span-7">
        {
          banner.media?.video && (
            <div class="hero-visual relative aspect-video w-full overflow-hidden rounded-2xl border border-border bg-light lg:aspect-[4/3]">
              {/* 1920x1080 source. Mobile keeps the native 16:9 so nothing is
                  cropped. From lg up the frame is 4:3, which crops the sides
                  rather than stretching: full height is kept, 75% of the width
                  shown, anchored at 58% to hold the scanner, terminal and
                  printer in shot. The clip opens wide with the terminal against
                  the right edge and pushes in, so playback is held to the
                  stronger second half - see the script at the end of the file. */}
              <video
                class="absolute inset-0 h-full w-full object-cover object-[58%_50%]"
                src={banner.media.video}
                poster={banner.media.poster}
                autoplay
                muted
                loop
                playsinline
                preload="metadata"
                aria-label={banner.media.caption}
              />
            </div>
          )
        }
      </div>
    </div>

    {
      banner.locations.length > 0 && (
        <div class="mt-16 border-t border-border pt-6 lg:mt-20">
          <ul class="flex flex-wrap items-center gap-x-6 gap-y-2 font-primary text-[11px] tracking-[0.16em] text-text-dark uppercase">
            <li class="text-primary">Local support</li>
            {banner.locations.map((place) => (
              <li>{place}</li>
            ))}
          </ul>
        </div>
      )
    }
  </div>
</section>

<style>
  /* ── Hero entrance animations ────────────────────────────────────────── */
  .hero-copy {
    opacity: 0;
    transform: translateY(20px);
    animation: heroFadeUp 700ms cubic-bezier(0.22, 1, 0.36, 1) 100ms both;
  }

  .hero-visual-col {
    opacity: 0;
    transform: translateY(16px);
    animation: heroFadeUp 700ms cubic-bezier(0.22, 1, 0.36, 1) 260ms both;
  }

  @keyframes heroFadeUp {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-copy,
    .hero-visual-col {
      opacity: 1;
      transform: none;
      animation: none;
    }
  }
</style>

<script is:inline>
  (function () {
    var v = document.querySelector(".hero-visual video");
    if (!v) return;

    // The clip opens on a wide frame with the terminal hard against the right
    // edge, then pushes in. Everything from ~1.3s reads well, so the loop is
    // held to that window instead of replaying the weak opening. Seeking past
    // END means the natural end is never reached and the `loop` attribute
    // never fires, so there is no jump back to 0.
    var START = 1.3;
    var END = 3.95;

    var toStart = function () {
      try {
        v.currentTime = START;
      } catch (e) {
        /* seeking before metadata is ready - the loadedmetadata handler retries */
      }
    };

    // Reduced motion: hold a strong still rather than looping.
    if (
      window.matchMedia &&
      window.matchMedia("(prefers-reduced-motion: reduce)").matches
    ) {
      v.removeAttribute("autoplay");
      v.addEventListener("loadedmetadata", toStart, { once: true });
      if (v.readyState >= 1) toStart();
      v.pause();
      return;
    }

    if (v.readyState >= 1) toStart();
    else v.addEventListener("loadedmetadata", toStart, { once: true });

    v.addEventListener("timeupdate", function () {
      if (v.currentTime >= END || v.currentTime < START - 0.15) toStart();
    });
  })();
</script>
