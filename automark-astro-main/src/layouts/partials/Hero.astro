---
import Orbit from "@/components/Orbit.astro";
import social from "@/config/social.json";
import { whatsappUrl } from "@/lib/utils/contact";
import type { Homepage, SocialType } from "@/types";

export interface Props {
  banner: Homepage["banner"];
}

const { banner } = Astro.props as Props;

// Content files say `link: "whatsapp"` so the number stays in config.json
// only; that link opens in a new tab with its own message. Anything else,
// such as "#work", is followed as written.
type Action = Homepage["banner"]["button_primary"];
const linkTo = (action: Action) =>
  action.link === "whatsapp"
    ? { href: whatsappUrl(action.enquiry), target: "_blank", rel: "noopener noreferrer" }
    : { href: action.link };

const primary = linkTo(banner.button_primary);
const secondary = linkTo(banner.link_secondary);

// The LinkedIn logo in the orbits opens the company's LinkedIn: the same
// address as the LinkedIn button in the footer (social.json), so changing
// it there changes both.
const linkedin = (social as SocialType).main.find((item) => item.name === "LinkedIn")?.link;
const orbitLinks = linkedin ? { FaLinkedin: linkedin } : {};

// The eyebrow's words, taken apart at the middle dots so the dots can be
// set in blue. They are hidden from screen readers, which hear the words.
const eyebrow = (banner.eyebrow ?? "")
  .split("·")
  .map((word) => word.trim())
  .filter(Boolean);
---

{/* What LapCircuit is, in one headline and one paragraph, and the two
    things to do next: see the work, or start a conversation. Along the foot
    of the first screen are the closing line and where we are. Behind it,
    at its right, logos of software-development tools turn on three
    orbits. */}
<section class="hero">
  <div class="wrap hero__inner">
    <div class="hero__main">
      <div class="hero__orbit">
        <Orbit links={orbitLinks} />
      </div>

      {
        eyebrow.length > 0 && (
          <p class="hero__eyebrow">
            {eyebrow.map((word, i) => (
              <Fragment>
                {i > 0 && (
                  <Fragment>
                    {" "}
                    <span class="hero__dot" aria-hidden="true">·</span>{" "}
                  </Fragment>
                )}
                {word}
              </Fragment>
            ))}
          </p>
        )
      }

      {/* The headline is scanned: dim, but for a band of full strength that
          sweeps across it and back with a thin blue line. See "Scanner" in
          the styles below. */}
      <h1 class="hero__title" data-scan>
        <span class="scan">
          <span class="scan__text">{banner.title}</span>
          <span class="scan__line" aria-hidden="true"></span>
        </span>
      </h1>

      <p class="hero__lead">{banner.content}</p>

      <div class="hero__actions">
        <a class="btn btn-shiny" {...primary}>
          <span>{banner.button_primary.label}</span>
        </a>
        {/* data-page-cta: while this is on screen the header's "Request a
            Demo" steps aside, so two ways to contact us are never shown
            side by side (main.js). */}
        <a class="text-link hero__link" {...secondary} data-page-cta>
          {banner.link_secondary.label}
        </a>
      </div>
    </div>

    {
      (banner.closing || banner.location) && (
        <div class="hero__foot">
          {banner.closing && <p class="hero__closing">{banner.closing}</p>}
          {banner.location && <p class="hero__location">{banner.location}</p>}
        </div>
      )
    }
  </div>
</section>

<style>
  /* The hero is the first screen and no more: the headline block sits in
     the middle of it and the foot line along its bottom edge. On a very
     tall screen it stops growing at 60rem, so the next section is not
     pushed far away; where the content needs more room than the screen
     has (a phone held sideways), it simply grows. The top padding is the
     fixed header's height (navigation.css). The orbits are clipped to the
     hero, and the content sits above them. */
  .hero {
    position: relative;
    display: flex;
    flex-direction: column;
    min-height: min(100vh, 60rem);
    min-height: min(100svh, 60rem);
    padding-top: 3.75rem;
    overflow: hidden;
  }

  .hero__inner {
    position: relative;
    z-index: 1;
    display: flex;
    flex: 1;
    flex-direction: column;
  }

  .hero__main {
    position: relative;
    margin-block: auto;
    padding-block: clamp(2.5rem, 7vh, 5rem) clamp(2.5rem, 6vh, 4rem);
  }

  /* The orbits lie behind this block, and its boxes reach across the empty
     right half too, so a click there would land on an empty box instead of
     the LinkedIn logo. The empty boxes let the pointer through; the words,
     the button and the link still take it as before. */
  .hero__main,
  .hero__title,
  .hero__actions {
    pointer-events: none;
  }

  .hero__eyebrow,
  .scan,
  .hero__lead,
  .hero__actions > * {
    pointer-events: auto;
  }

  /* ── Orbits (Orbit.astro) ─────────────────────────────────────────────
     This box is the orbits' centre point, behind the text. The hero clips
     whatever runs past its edges, so nothing ever scrolls sideways.

     On a phone and a tablet the centre sits on the right edge of the
     screen, so only the left half of the rings shows, like the source cut
     off at its edge: on a phone level with the headline, whose large
     letters bear a faint background better than the paragraph does; on a
     tablet higher, in the empty space beside the eyebrow. There the rings
     pass behind words, so they are drawn faintly and smaller. On a computer they
     have the empty right side to themselves, at full strength: the centre
     on the right edge of the screen up to 1200px wide, and from there on
     the right edge of the content, where the outer ring just clears the
     end of the headline. */
  .hero__orbit {
    position: absolute;
    top: 20%;
    right: -1.25rem;
    z-index: -1;
    width: 0;
    height: 0;
    font-size: 9px;
    opacity: 0.4;
    pointer-events: none;
  }

  @media (min-width: 640px) {
    .hero__orbit {
      top: 10%;
      right: -2rem;
      font-size: 13px;
      opacity: 0.5;
    }
  }

  @media (min-width: 900px) {
    .hero__orbit {
      top: 50%;
      font-size: 14px;
      opacity: 1;
    }
  }

  @media (min-width: 1024px) {
    .hero__orbit {
      right: -2.5rem;
    }
  }

  @media (min-width: 1200px) {
    .hero__orbit {
      right: 0;
      font-size: 16px;
    }
  }

  /* Understated: small, grey, tracked capitals. The dots between the words
     are the only blue before the button. */
  .hero__eyebrow {
    width: fit-content;
    margin-bottom: clamp(1.25rem, 2.4vw, 1.75rem);
    color: var(--color-text-dark);
    font-family: var(--font-primary);
    font-size: 0.8125rem;
    font-weight: 600;
    line-height: 1.4;
    letter-spacing: 0.14em;
  }

  .hero__dot {
    color: var(--color-primary);
  }

  /* The one large thing on the page. Big enough to lead, not so big that
     it fills the screen: at full size it takes two lines and about two
     thirds of the width. The weight sits between the section headlines'
     bold and black, and the letters are drawn in close, as display type
     wants at this size. */
  .hero__title {
    max-width: 14em;
    color: var(--color-text-light);
    font-size: clamp(2.25rem, 1.1rem + 5vw, 4.75rem);
    font-weight: 650;
    line-height: 1.04;
    letter-spacing: -0.035em;
  }

  /* ── Scanner ──────────────────────────────────────────────────────────
     A port of the "text scanner" component. The headline is shown at a
     quarter of its strength, except for a band at full strength that sweeps
     across it and back; a thin blue line with a glow travels with the band.
     The component's own values: 2.6s each way, eased in and out, the band
     the middle fifth of a gradient 2.4 times as wide as the text.

     The component paints its letters with that moving gradient. Here the
     same gradient is a mask laid over the headline instead: the picture is
     the same, and the letters keep their own colour under it.

     .scan is the block the line crosses. It hugs the words - the script at
     the foot of this file sets its width to the longest line when the
     headline wraps - so the line turns round where the words end.

     Without JavaScript the sweep still runs. For anyone who has asked for
     less motion, none of this applies and the headline is simply there. */
  .scan {
    position: relative;
    display: inline-block;
    max-width: 100%;
    vertical-align: top;
  }

  .scan__text {
    display: block;
  }

  .scan__line {
    display: none;
  }

  @media (prefers-reduced-motion: no-preference) {
    /* The padding (given back as margin) is room for the tails of letters:
       a mask cuts off anything outside the box it is laid on. */
    .scan__text {
      margin: -0.2em -0.06em;
      padding: 0.2em 0.06em;
      -webkit-mask-image: linear-gradient(
        90deg,
        rgb(0 0 0 / 0.25) 0 40%,
        #000 50%,
        rgb(0 0 0 / 0.25) 60% 100%
      );
      mask-image: linear-gradient(
        90deg,
        rgb(0 0 0 / 0.25) 0 40%,
        #000 50%,
        rgb(0 0 0 / 0.25) 60% 100%
      );
      -webkit-mask-size: 240% 100%;
      mask-size: 240% 100%;
      animation: hero-scan-text 2.6s ease-in-out infinite alternate;
    }

    /* As wide as the text, with the visible line at its left edge: sliding
       the whole strip by its own width carries the line from one end of the
       text to the other without the browser laying anything out again. */
    .scan__line {
      position: absolute;
      top: -0.375rem;
      bottom: -0.375rem;
      left: 0;
      display: block;
      width: 100%;
      pointer-events: none;
      animation: hero-scan-line 2.6s ease-in-out infinite alternate;
    }

    .scan__line::before {
      content: "";
      position: absolute;
      top: 0;
      bottom: 0;
      left: 0;
      width: 0.125rem;
      background: var(--color-primary);
      box-shadow: 0 0 14px var(--color-primary);
    }

    /* Scrolled out of view: stop redrawing. The script sets this. */
    .hero__title.is-paused .scan__text,
    .hero__title.is-paused .scan__line {
      animation-play-state: paused;
    }
  }

  @keyframes hero-scan-text {
    from {
      -webkit-mask-position: 100% 0;
      mask-position: 100% 0;
    }
    to {
      -webkit-mask-position: 0% 0;
      mask-position: 0% 0;
    }
  }

  @keyframes hero-scan-line {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(calc(100% - 0.125rem));
    }
  }

  /* About sixty characters to a line, narrower than the headline above. */
  .hero__lead {
    max-width: 36rem;
    margin-top: clamp(1.5rem, 2.6vw, 2rem);
    color: var(--color-text);
    font-size: clamp(1.0625rem, 0.98rem + 0.3vw, 1.1875rem);
    line-height: 1.65;
    text-wrap: pretty;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 2rem;
    margin-top: clamp(2rem, 3.4vw, 2.75rem);
  }

  /* The main action is the site's shiny button (components.css), with its
     light travelling round the border. The second action is a link, not a second button: underlined text at
     the button's size, a fingertip tall. */
  .hero__link {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    font-size: 0.9375rem;
    font-weight: 500;
  }

  .hero__foot {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.25rem 2rem;
    padding-bottom: clamp(1.5rem, 3vw, 2.25rem);
    color: var(--color-text-dark);
  }

  .hero__closing,
  .hero__location {
    font-size: 0.875rem;
    line-height: 1.5;
    text-wrap: pretty;
  }

  @media (min-width: 900px) {
    .hero {
      padding-top: 4.5rem;
    }
  }

  /* Phone: the button the full width of the screen, within reach of either
     thumb, with the link centred under it; the foot line stacks. A little
     less space above, so the button is on the first screen even of a
     320 x 568 phone. */
  @media (max-width: 479.98px) {
    .hero__main {
      padding-top: 1.5rem;
    }

    .hero__actions {
      flex-direction: column;
      align-items: stretch;
      gap: 0.5rem;
      margin-top: 1.75rem;
    }

    .hero__link {
      align-self: center;
    }

    .hero__foot {
      flex-direction: column;
    }
  }

  /* A phone held sideways: very little height, so less of it goes on space
     and on the headline, and the paragraph uses the extra width to take
     fewer lines. The button stays on the first screen. */
  @media (max-height: 480px) and (orientation: landscape) {
    .hero__main {
      padding-block: 1rem 2rem;
    }

    .hero__eyebrow {
      margin-bottom: 0.75rem;
    }

    .hero__title {
      font-size: clamp(2rem, 9vh, 3rem);
    }

    .hero__lead {
      max-width: 42rem;
      margin-top: 1rem;
      font-size: 1rem;
    }

    .hero__actions {
      margin-top: 1.25rem;
    }
  }
</style>

<script>
  // Two small jobs for the scanned headline.
  //
  // The scanner's line should turn round where the words end. When the
  // headline wraps, a wrapped block is as wide as the space it is in rather
  // than as its longest line, so the longest line is measured and the block
  // is made that wide. (Every line already fits in that width, so nothing
  // re-wraps.)
  //
  // And the sweep rests while the headline is scrolled out of view.
  document.querySelectorAll<HTMLElement>("[data-scan]").forEach((title) => {
    const block = title.querySelector<HTMLElement>(".scan");
    const text = title.querySelector<HTMLElement>(".scan__text");
    if (!block || !text) return;

    let fitted = -1;
    const fit = () => {
      block.style.width = "";
      const left = block.getBoundingClientRect().left;
      const range = document.createRange();
      range.selectNodeContents(text);

      let right = 0;
      for (const box of range.getClientRects()) right = Math.max(right, box.right - left);
      if (right > 0) block.style.width = `${Math.ceil(right)}px`;
      fitted = title.clientWidth;
    };

    fit();
    document.fonts?.ready.then(fit);

    if (typeof ResizeObserver === "function") {
      new ResizeObserver(() => {
        if (title.clientWidth !== fitted) requestAnimationFrame(fit);
      }).observe(title);
    }

    if ("IntersectionObserver" in window) {
      new IntersectionObserver(([entry]) => {
        title.classList.toggle("is-paused", !entry.isIntersecting);
      }).observe(title);
    }
  });
</script>
