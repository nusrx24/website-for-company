---
import BackgroundPaths from "@/components/BackgroundPaths.astro";
import { whatsappUrl } from "@/lib/utils/contact";
import { markdownify } from "@/lib/utils/textConverter";
import type { Homepage } from "@/types";

export interface Props {
  banner: Homepage["banner"];
}

const { banner } = Astro.props as Props;

// Content files say `link: "whatsapp"` so the number stays in config.json only.
const isWhatsapp = banner.button_primary.link === "whatsapp";
const primaryHref = isWhatsapp ? whatsappUrl() : banner.button_primary.link;
---

{/* What LapCircuit does, in a headline and one sentence, how it is paid
    for, and the one request the page makes. The product screenshot sits in the next section,
    beside the argument it supports. Behind it, blue lines flow from corner
    to corner. */}
<section class="hero">
  <BackgroundPaths />

  <div class="wrap hero__content">
    {/* The headline is scanned: dim, but for a band of full strength that
        sweeps across it and back with a thin blue line. See "Scanner" in
        the styles below. */}
    <h1 class="hero__title" data-scan>
      <span class="scan">
        <span class="scan__text" set:html={markdownify(banner.title)} />
        <span class="scan__line" aria-hidden="true"></span>
      </span>
    </h1>

    <div class="hero__row">
      <div class="hero__intro">
        {
          banner.promise && (
            <p class="hero__promise">
              <mark>{banner.promise}</mark>
            </p>
          )
        }
        <p class="hero__lead">{banner.content}</p>
      </div>

      <div class="hero__actions">
        <a
          class="btn btn-shiny"
          href={primaryHref}
          target={isWhatsapp ? "_blank" : null}
          rel={isWhatsapp ? "noopener noreferrer" : null}
          data-page-cta
        >
          <span>{banner.button_primary.label}</span>
        </a>
        <a class="text-link" href={banner.link_secondary.link}>
          {banner.link_secondary.label}
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  /* Holds the background lines: they are clipped to this section and the
     content sits above them. */
  .hero {
    position: relative;
    overflow: hidden;
    padding-top: clamp(6rem, 15vw, 11.5rem);
    padding-bottom: clamp(3.5rem, 9vw, 7.5rem);
  }

  .hero__content {
    position: relative;
    z-index: 1;
  }

  /* The one large thing on the page, and the one headline with an effect of
     its own (the others breathe: see components.css).

     On a phone it is set in three short lines and sized from the width of
     the screen (14vw), so it fills the screen it is on instead of sitting
     small in one corner. From there it holds at 64px until the desktop
     size (7vw) overtakes it, where the first sentence fits on one line. */
  .hero__title {
    font-size: clamp(2.75rem, max(7vw, min(14vw, 4rem)), 5.5rem);
    line-height: 1.05;
    letter-spacing: -0.025em;
  }

  /* The words marked **like this** in the content are set in the brand's
     blue; the rest of the headline is white. */
  .hero__title :global(strong) {
    color: var(--color-primary);
    font-weight: inherit;
  }

  /* ── Scanner ──────────────────────────────────────────────────────────
     A port of the "text scanner" component. The headline is shown at a
     quarter of its strength, except for a band at full strength that sweeps
     across it and back; a thin blue line with a glow travels with the band.
     The component's own values: 2.6s each way, eased in and out, the band
     the middle fifth of a gradient 2.4 times as wide as the text.

     The component paints its letters with that moving gradient. Here the
     same gradient is a mask laid over the headline instead: the picture is
     the same, and the blue words keep their own colour under it.

     .scan is the block the line crosses. It hugs the words - the script at
     the foot of this file sets its width to the longest line when the
     headline wraps - so the line turns round where the words end.

     Without JavaScript the sweep still runs. For anyone who has asked for
     less motion, none of this applies and the headline is simply there. */
  .scan {
    position: relative;
    display: inline-block;
    max-width: 100%;
    vertical-align: top;
  }

  .scan__text {
    display: block;
  }

  .scan__line {
    display: none;
  }

  @media (prefers-reduced-motion: no-preference) {
    /* The padding (given back as margin) is room for the tails of letters:
       a mask cuts off anything outside the box it is laid on. */
    .scan__text {
      margin: -0.2em -0.06em;
      padding: 0.2em 0.06em;
      -webkit-mask-image: linear-gradient(
        90deg,
        rgb(0 0 0 / 0.25) 0 40%,
        #000 50%,
        rgb(0 0 0 / 0.25) 60% 100%
      );
      mask-image: linear-gradient(
        90deg,
        rgb(0 0 0 / 0.25) 0 40%,
        #000 50%,
        rgb(0 0 0 / 0.25) 60% 100%
      );
      -webkit-mask-size: 240% 100%;
      mask-size: 240% 100%;
      animation: hero-scan-text 2.6s ease-in-out infinite alternate;
    }

    /* As wide as the text, with the visible line at its left edge: sliding
       the whole strip by its own width carries the line from one end of the
       text to the other without the browser laying anything out again. */
    .scan__line {
      position: absolute;
      top: -0.375rem;
      bottom: -0.375rem;
      left: 0;
      display: block;
      width: 100%;
      pointer-events: none;
      animation: hero-scan-line 2.6s ease-in-out infinite alternate;
    }

    .scan__line::before {
      content: "";
      position: absolute;
      top: 0;
      bottom: 0;
      left: 0;
      width: 0.125rem;
      background: var(--color-primary);
      box-shadow: 0 0 14px var(--color-primary);
    }

    /* Scrolled out of view: stop redrawing. The script sets this. */
    .hero__title.is-paused .scan__text,
    .hero__title.is-paused .scan__line {
      animation-play-state: paused;
    }
  }

  @keyframes hero-scan-text {
    from {
      -webkit-mask-position: 100% 0;
      mask-position: 100% 0;
    }
    to {
      -webkit-mask-position: 0% 0;
      mask-position: 0% 0;
    }
  }

  @keyframes hero-scan-line {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(calc(100% - 0.125rem));
    }
  }

  .hero__row {
    display: grid;
    gap: 2rem;
    margin-top: clamp(1.75rem, 3.5vw, 2.75rem);
  }

  /* The one sentence picked out with a highlighter: the brand's blue behind
     near-black lettering (6.5:1 contrast). If it runs to two lines on a
     very narrow phone, each line keeps its own highlight. */
  .hero__promise {
    margin-bottom: 1rem;
    font-size: clamp(1rem, 1.3vw, 1.125rem);
    line-height: 2;
  }

  .hero__promise mark {
    padding: 0.2em 0.6em;
    border-radius: 0.375rem;
    background-color: var(--color-primary);
    color: var(--color-body);
    font-weight: 700;
    -webkit-box-decoration-break: clone;
    box-decoration-break: clone;
  }

  .hero__lead {
    max-width: 54ch;
    color: var(--color-text-light);
    font-size: clamp(1.0625rem, 1.4vw, 1.1875rem);
    line-height: 1.6;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 1.75rem;
  }

  /* A fingertip's height for the link, without moving its text. */
  .hero__actions .text-link {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
  }

  /* Phone: a slightly smaller sentence, so the button is on the first
     screen even on a short phone, and a button the full width of the
     screen, within reach of either thumb. */
  @media (max-width: 479.98px) {
    .hero {
      padding-top: 5.5rem;
    }

    .hero__row {
      gap: 1.25rem;
      margin-top: 1.25rem;
    }

    .hero__promise {
      margin-bottom: 0.75rem;
      font-size: 1rem;
    }

    .hero__lead {
      font-size: 1rem;
      line-height: 1.6;
    }

    .hero__actions {
      flex-direction: column;
      align-items: stretch;
      gap: 0.25rem;
    }

    .hero__actions .text-link {
      align-self: center;
    }
  }

  /* The narrowest phones: a size smaller, so the highlighted sentence
     still fits on one line. */
  @media (max-width: 359.98px) {
    .hero__promise {
      font-size: 0.875rem;
    }
  }

  /* A phone held sideways: very little height, so less of it is spent
     above and on the headline. */
  @media (max-height: 480px) and (orientation: landscape) {
    .hero {
      padding-top: 5rem;
    }

    .hero__title {
      font-size: clamp(2.25rem, 11vh, 3.5rem);
    }
  }

  /* ...and the sentence and the button side by side, as on a computer, so
     the button is on the first screen. */
  @media (max-height: 480px) and (orientation: landscape) and (min-width: 560px) {
    .hero__row {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
      align-items: end;
      gap: 2rem;
    }

    .hero__actions {
      justify-content: flex-end;
    }
  }

  @media (min-width: 900px) {
    .hero__row {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
      align-items: end;
      gap: 3rem;
    }

    .hero__actions {
      justify-content: flex-end;
    }
  }
</style>

<script>
  // Two small jobs for the scanned headline.
  //
  // The scanner's line should turn round where the words end. On a phone the
  // headline wraps, and a wrapped block is as wide as the screen rather than
  // as its longest line, so the longest line is measured and the block is
  // made that wide. (Every line already fits in that width, so nothing
  // re-wraps.)
  //
  // And the sweep rests while the headline is scrolled out of view.
  document.querySelectorAll<HTMLElement>("[data-scan]").forEach((title) => {
    const block = title.querySelector<HTMLElement>(".scan");
    const text = title.querySelector<HTMLElement>(".scan__text");
    if (!block || !text) return;

    let fitted = -1;
    const fit = () => {
      block.style.width = "";
      const left = block.getBoundingClientRect().left;
      const range = document.createRange();
      range.selectNodeContents(text);

      let right = 0;
      for (const box of range.getClientRects()) right = Math.max(right, box.right - left);
      if (right > 0) block.style.width = `${Math.ceil(right)}px`;
      fitted = title.clientWidth;
    };

    fit();
    document.fonts?.ready.then(fit);

    if (typeof ResizeObserver === "function") {
      new ResizeObserver(() => {
        if (title.clientWidth !== fitted) requestAnimationFrame(fit);
      }).observe(title);
    }

    if ("IntersectionObserver" in window) {
      new IntersectionObserver(([entry]) => {
        title.classList.toggle("is-paused", !entry.isIntersecting);
      }).observe(title);
    }
  });
</script>
