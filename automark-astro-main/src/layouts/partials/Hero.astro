---
import { whatsappUrl } from "@/lib/utils/contact";
import type { Homepage } from "@/types";

export interface Props {
  banner: Homepage["banner"];
}

const { banner } = Astro.props as Props;

// Content files say `link: "whatsapp"` so the number stays in config.json
// only; that link opens in a new tab with its own message. Anything else,
// such as "#work", is followed as written.
type Action = Homepage["banner"]["button_primary"];
const linkTo = (action: Action) =>
  action.link === "whatsapp"
    ? { href: whatsappUrl(action.enquiry), target: "_blank", rel: "noopener noreferrer" }
    : { href: action.link };

const primary = linkTo(banner.button_primary);
const secondary = linkTo(banner.link_secondary);

// The eyebrow's words, taken apart at the middle dots so the dots can be
// set in blue. They are hidden from screen readers, which hear the words.
const eyebrow = (banner.eyebrow ?? "")
  .split("·")
  .map((word) => word.trim())
  .filter(Boolean);
---

{/* What LapCircuit is, in one headline and one paragraph, and the two
    things to do next: see the work, or start a conversation. Nothing on it
    moves by itself; the type carries it. Along the foot of the first screen
    are the closing line and where we are. */}
<section class="hero">
  <div class="wrap hero__inner">
    <div class="hero__main">
      {
        eyebrow.length > 0 && (
          <p class="hero__eyebrow">
            {eyebrow.map((word, i) => (
              <Fragment>
                {i > 0 && (
                  <Fragment>
                    {" "}
                    <span class="hero__dot" aria-hidden="true">·</span>{" "}
                  </Fragment>
                )}
                {word}
              </Fragment>
            ))}
          </p>
        )
      }

      <h1 class="hero__title">{banner.title}</h1>

      <p class="hero__lead">{banner.content}</p>

      <div class="hero__actions">
        <a class="btn hero__btn" {...primary}>
          {banner.button_primary.label}
        </a>
        {/* data-page-cta: while this is on screen the header's "Request a
            Demo" steps aside, so two ways to contact us are never shown
            side by side (main.js). */}
        <a class="text-link hero__link" {...secondary} data-page-cta>
          {banner.link_secondary.label}
        </a>
      </div>
    </div>

    {
      (banner.closing || banner.location) && (
        <div class="hero__foot">
          {banner.closing && <p class="hero__closing">{banner.closing}</p>}
          {banner.location && <p class="hero__location">{banner.location}</p>}
        </div>
      )
    }
  </div>
</section>

<style>
  /* The hero is the first screen and no more: the headline block sits in
     the middle of it and the foot line along its bottom edge. On a very
     tall screen it stops growing at 60rem, so the next section is not
     pushed far away; where the content needs more room than the screen
     has (a phone held sideways), it simply grows. The top padding is the
     fixed header's height (navigation.css). */
  .hero {
    display: flex;
    flex-direction: column;
    min-height: min(100vh, 60rem);
    min-height: min(100svh, 60rem);
    padding-top: 3.75rem;
  }

  .hero__inner {
    display: flex;
    flex: 1;
    flex-direction: column;
  }

  .hero__main {
    margin-block: auto;
    padding-block: clamp(2.5rem, 7vh, 5rem) clamp(2.5rem, 6vh, 4rem);
  }

  /* Understated: small, grey, tracked capitals. The dots between the words
     are the only blue before the button. */
  .hero__eyebrow {
    margin-bottom: clamp(1.25rem, 2.4vw, 1.75rem);
    color: var(--color-text-dark);
    font-family: var(--font-primary);
    font-size: 0.8125rem;
    font-weight: 600;
    line-height: 1.4;
    letter-spacing: 0.14em;
  }

  .hero__dot {
    color: var(--color-primary);
  }

  /* The one large thing on the page. Big enough to lead, not so big that
     it fills the screen: at full size it takes two lines and about two
     thirds of the width. The weight sits between the section headlines'
     bold and black, and the letters are drawn in close, as display type
     wants at this size. */
  .hero__title {
    max-width: 14em;
    color: var(--color-text-light);
    font-size: clamp(2.25rem, 1.1rem + 5vw, 4.75rem);
    font-weight: 650;
    line-height: 1.04;
    letter-spacing: -0.035em;
  }

  /* About sixty characters to a line, narrower than the headline above. */
  .hero__lead {
    max-width: 36rem;
    margin-top: clamp(1.5rem, 2.6vw, 2rem);
    color: var(--color-text);
    font-size: clamp(1.0625rem, 0.98rem + 0.3vw, 1.1875rem);
    line-height: 1.65;
    text-wrap: pretty;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 2rem;
    margin-top: clamp(2rem, 3.4vw, 2.75rem);
  }

  /* The main action: a solid blue pill with near-black lettering (6.5:1).
     It is the largest patch of blue on the screen, so the eye finds it
     without a glow or moving light. */
  .hero__btn {
    min-height: 3.25rem;
    padding: 0 1.75rem;
    border-radius: 360px;
    background-color: var(--color-primary);
    color: var(--color-body);
    font-size: 0.9375rem;
    font-weight: 600;
    transition: background-color 0.15s ease;
  }

  .hero__btn:hover,
  .hero__btn:focus-visible {
    background-color: var(--color-primary-light);
  }

  .hero__btn:active {
    translate: 0 1px;
  }

  /* The second action is a link, not a second button: underlined text at
     the button's size, a fingertip tall. */
  .hero__link {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    font-size: 0.9375rem;
    font-weight: 500;
  }

  .hero__foot {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.25rem 2rem;
    padding-bottom: clamp(1.5rem, 3vw, 2.25rem);
    color: var(--color-text-dark);
  }

  .hero__closing,
  .hero__location {
    font-size: 0.875rem;
    line-height: 1.5;
    text-wrap: pretty;
  }

  @media (min-width: 900px) {
    .hero {
      padding-top: 4.5rem;
    }
  }

  /* Phone: the button the full width of the screen, within reach of either
     thumb, with the link centred under it; the foot line stacks. A little
     less space above, so the button is on the first screen even of a
     320 x 568 phone. */
  @media (max-width: 479.98px) {
    .hero__main {
      padding-top: 1.5rem;
    }

    .hero__actions {
      flex-direction: column;
      align-items: stretch;
      gap: 0.5rem;
      margin-top: 1.75rem;
    }

    .hero__link {
      align-self: center;
    }

    .hero__foot {
      flex-direction: column;
    }
  }

  /* A phone held sideways: very little height, so less of it goes on space
     and on the headline, and the paragraph uses the extra width to take
     fewer lines. The button stays on the first screen. */
  @media (max-height: 480px) and (orientation: landscape) {
    .hero__main {
      padding-block: 1rem 2rem;
    }

    .hero__eyebrow {
      margin-bottom: 0.75rem;
    }

    .hero__title {
      font-size: clamp(2rem, 9vh, 3rem);
    }

    .hero__lead {
      max-width: 42rem;
      margin-top: 1rem;
      font-size: 1rem;
    }

    .hero__actions {
      margin-top: 1.25rem;
    }
  }
</style>
