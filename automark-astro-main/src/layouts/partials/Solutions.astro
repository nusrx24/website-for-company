---
import config from "@/config/config.json";
import { contact, whatsappUrl } from "@/lib/utils/contact";
import type { Homepage } from "@/types";

export interface Props {
  solutions: Homepage["solutions"];
}

const { solutions } = Astro.props as Props;
const { receipt } = solutions;

// The head of every receipt: who issued it and their number. Both come from
// config.json, so the phone number is not typed a second time.
const merchant = config.site.title;
const merchantLine = `Tel ${contact.phoneDisplay}`;
---

{/* What LapCircuit builds, printed as till receipts: one slip per solution
    with what it includes and where its price starts. The button on each
    slip opens WhatsApp with a message naming that solution. On a phone the
    slips lie in a row that is swiped sideways, one at a time. */}
<section id="solutions" class="section">
  <div class="wrap">
    <div class="section-head">
      <h2 data-breathe>{solutions.title}</h2>
      {solutions.content && <p>{solutions.content}</p>}
    </div>

    <div class="receipts">
      <ul class="receipts__grid" role="list" data-receipts>
        {
          solutions.items.map((item, position) => (
            <li class="receipt" style={`--i:${position}`}>
              {item.badge && (
                <span class="receipt__stamp" aria-hidden="true">
                  {item.badge}
                </span>
              )}

              <p class="receipt__merchant">{merchant}</p>
              <p class="receipt__merchant-line">{merchantLine}</p>

              <span class="receipt__rule" aria-hidden="true" />

              <div class="receipt__item">
                <h3>{item.title}</h3>
                <span aria-hidden="true">×1</span>
              </div>
              <p class="receipt__tagline">{item.content}</p>

              <span class="receipt__rule" aria-hidden="true" />

              <ul class="receipt__lines" role="list">
                {item.lines.map((line) => (
                  <li>
                    <span class="receipt__label">{line}</span>
                    <span class="receipt__leader" aria-hidden="true" />
                    <span class="receipt__incl">{receipt.included}</span>
                  </li>
                ))}
              </ul>

              <span class="receipt__rule" aria-hidden="true" />

              {receipt.extras.map((extra) => (
                <p class="receipt__extra">
                  <span>{extra.label}</span>
                  <span>{extra.value}</span>
                </p>
              ))}

              <p class="receipt__total">
                <span>{item.price ? item.price_prefix : receipt.quote_label}</span>
                <span>{item.price ?? receipt.quote_value}</span>
              </p>

              <span class="receipt__rule" aria-hidden="true" />

              <a
                class="receipt__cta"
                href={whatsappUrl(item.enquiry)}
                target="_blank"
                rel="noopener noreferrer"
              >
                {receipt.cta}
              </a>

              <span class="receipt__barcode" aria-hidden="true" />
              <p class="receipt__foot">
                No. {String(position + 1).padStart(4, "0")} · {receipt.thanks}
              </p>
            </li>
          ))
        }
      </ul>

      {/* Phone only: one dot per receipt, the long one being the receipt in
          view. Decoration - the receipts themselves are all in the page. */}
      <div class="receipts__pager" data-pager aria-hidden="true">
        {solutions.items.map((_, position) => <span class={position === 0 ? "is-on" : undefined} />)}
      </div>
    </div>

    {/* Receipts rise into place the first time they are scrolled to. This
        runs as the page is read, before anything is drawn, so they never
        flash. Without JavaScript they are simply there. */}
    <script is:inline>
      (function () {
        var el = document.currentScript.previousElementSibling;
        if (!el || !("IntersectionObserver" in window)) return;
        el.classList.add("will-reveal");
        new IntersectionObserver(
          function (entries, observer) {
            if (!entries[0].isIntersecting) return;
            el.classList.add("is-shown");
            observer.disconnect();
          },
          { threshold: 0.12 },
        ).observe(el);
      })();
    </script>
  </div>
</section>

<style>
  /* ── The counter the receipts lie on ──────────────────────────────────
     Paper, ink and stamp colours are the receipt's own, and deliberately
     not the site's palette: a receipt is cream paper with dark print.
     To print them on dark paper instead, change --paper to #1c1c1f,
     --ink to #d8d8d2, --muted to #8f8f95 and --line to #3f3f45. */
  .receipts {
    --paper: #fefdf8;
    --ink: #2a2a26;
    --muted: #7c7a72;
    --line: #b9b6ad;
    --stamp: #c93a28;
    padding: 3rem 1.5rem;
    border-radius: 1rem;
    background-color: #111113;
    /* Lets the layout below respond to this panel's own width. */
    container-type: inline-size;
  }

  .receipts__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    align-items: start;
    justify-items: center;
    gap: 2rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* ── One receipt ─────────────────────────────────────────────────────── */
  .receipt {
    position: relative;
    width: 100%;
    max-width: 21rem;
    padding: 2rem 1.5rem 1.75rem;
    background-color: var(--paper);
    color: var(--ink);
    font-size: 12.5px;
    line-height: 1.625;
    box-shadow: 0 12px 32px -16px rgb(0 0 0 / 0.35);
    /* The torn edge along the bottom. */
    clip-path: polygon(
      0 0,
      100% 0,
      100% calc(100% - 8px),
      97% 100%,
      94% calc(100% - 8px),
      91% 100%,
      88% calc(100% - 8px),
      85% 100%,
      82% calc(100% - 8px),
      79% 100%,
      76% calc(100% - 8px),
      73% 100%,
      70% calc(100% - 8px),
      67% 100%,
      64% calc(100% - 8px),
      61% 100%,
      58% calc(100% - 8px),
      55% 100%,
      52% calc(100% - 8px),
      49% 100%,
      46% calc(100% - 8px),
      43% 100%,
      40% calc(100% - 8px),
      37% 100%,
      34% calc(100% - 8px),
      31% 100%,
      28% calc(100% - 8px),
      25% 100%,
      22% calc(100% - 8px),
      19% 100%,
      16% calc(100% - 8px),
      13% 100%,
      10% calc(100% - 8px),
      7% 100%,
      4% calc(100% - 8px),
      1% 100%,
      0 calc(100% - 8px)
    );
  }

  .receipt__merchant {
    font-size: 13.5px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-align: center;
    text-transform: uppercase;
  }

  .receipt__merchant-line {
    margin-top: 0.25rem;
    color: var(--muted);
    font-size: 10.5px;
    letter-spacing: 0.06em;
    text-align: center;
    text-transform: uppercase;
  }

  .receipt__rule {
    display: block;
    margin-block: 0.75rem;
    border-top: 1px dashed var(--line);
  }

  .receipt__item {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem;
  }

  /* The site's headings are large white display type; on a receipt the name
     is one more printed line. */
  .receipt__item h3 {
    min-width: 0;
    color: inherit;
    font-family: inherit;
    font-size: inherit;
    font-weight: 700;
    letter-spacing: 0.08em;
    line-height: inherit;
    text-transform: uppercase;
    text-wrap: wrap;
    word-spacing: normal;
  }

  .receipt__item span {
    flex: none;
    color: var(--muted);
  }

  .receipt__tagline {
    margin-top: 0.25rem;
    color: var(--muted);
    font-size: 11px;
  }

  .receipt__lines {
    display: grid;
    gap: 0.375rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .receipt__lines li {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
  }

  .receipt__label {
    flex-shrink: 1;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    text-transform: uppercase;
    white-space: nowrap;
  }

  /* The dotted line that runs from an item to its price. */
  .receipt__leader {
    flex: 1;
    min-width: 0.75rem;
    margin-bottom: 0.25rem;
    border-bottom: 1px dotted var(--line);
  }

  .receipt__incl {
    flex: none;
    color: var(--muted);
    text-transform: uppercase;
  }

  .receipt__extra {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem;
    color: var(--muted);
    font-size: 11.5px;
    text-transform: uppercase;
  }

  .receipt__total {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem;
    margin-top: 0.5rem;
    font-size: 17px;
    font-weight: 700;
    text-transform: uppercase;
  }

  .receipt__cta {
    display: block;
    width: 100%;
    padding-block: 0.75rem;
    background-color: var(--ink);
    color: var(--paper);
    font-size: 12.5px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-align: center;
    text-transform: uppercase;
    transition:
      transform 0.15s ease,
      background-color 0.15s ease;
  }

  .receipt__cta:hover {
    background-color: #000;
  }

  .receipt__cta:active {
    transform: scale(0.98);
  }

  .receipt__cta:focus-visible {
    outline: 2px solid var(--stamp);
    outline-offset: 2px;
  }

  .receipt__barcode {
    display: block;
    width: 80%;
    height: 2.5rem;
    margin: 1.25rem auto 0;
    opacity: 0.8;
    background-image: repeating-linear-gradient(
      90deg,
      currentColor 0,
      currentColor 2px,
      transparent 2px,
      transparent 5px,
      currentColor 5px,
      currentColor 6px,
      transparent 6px,
      transparent 9px
    );
  }

  .receipt__foot {
    margin-top: 0.5rem;
    color: var(--muted);
    font-size: 10px;
    letter-spacing: 0.2em;
    text-align: center;
    text-transform: uppercase;
  }

  /* A rubber stamp, pressed on at an angle in the bottom corner, over the
     sign-off. Higher up it covered the phone number, and across the barcode
     the bars made it hard to read. */
  .receipt__stamp {
    position: absolute;
    right: 0.6rem;
    bottom: 1.45rem;
    padding: 0.25rem 0.5rem;
    border: 2px solid var(--stamp);
    border-radius: 0.25rem;
    color: var(--stamp);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.14em;
    line-height: 1.5;
    opacity: 0.8;
    mix-blend-mode: multiply;
    text-transform: uppercase;
    rotate: -12deg;
  }

  .receipts__pager {
    display: none;
  }

  /* ── Phone: one receipt at a time, swiped sideways ────────────────────
     Stacked, the four receipts ran to more than four screens. Here they lie
     in a row on a counter that runs to both edges of the screen; each one
     snaps to the middle, with the edge of the next showing so it is plain
     there is more to the side. The print is a size larger than on a
     computer, because the receipt is now wide enough to carry it.

     It is used up to 672px wide: only from there do two receipts fit side
     by side (see "Side by side" below, which starts at the same width). */
  @media (max-width: 671.98px) {
    .receipts {
      margin-inline: -1.25rem;
      padding: 1.75rem 0 1.25rem;
      border-radius: 0;
    }

    .receipts__grid {
      grid-template-columns: none;
      grid-auto-columns: min(20rem, 100cqw - 4rem);
      grid-auto-flow: column;
      justify-items: stretch;
      gap: 0.75rem;
      padding: 0 1.25rem 1.25rem;
      overflow-x: auto;
      overscroll-behavior-x: contain;
      scroll-padding-inline: 1.25rem;
      scroll-snap-type: x mandatory;
      scrollbar-width: none;
    }

    .receipts__grid::-webkit-scrollbar {
      display: none;
    }

    .receipt {
      max-width: none;
      padding: 1.75rem 1.25rem;
      font-size: 13px;
      scroll-snap-align: center;
    }

    .receipt__merchant {
      font-size: 14px;
    }

    .receipt__merchant-line {
      font-size: 11.5px;
    }

    .receipt__tagline,
    .receipt__extra {
      font-size: 12px;
    }

    .receipt__cta {
      padding-block: 0.875rem;
      font-size: 13px;
    }

    .receipt__foot {
      font-size: 11px;
      letter-spacing: 0.16em;
    }

    .receipts__pager {
      display: flex;
      justify-content: center;
      gap: 6px;
    }

    .receipts__pager span {
      width: 6px;
      height: 6px;
      border-radius: 3px;
      background-color: rgb(255 255 255 / 0.28);
      transition:
        width 0.25s ease,
        background-color 0.25s ease;
    }

    .receipts__pager span.is-on {
      width: 20px;
      background-color: #fff;
    }
  }

  /* From 640px the page's own margin is wider (2rem), and the counter has to
     reach the edges of the screen through that instead. */
  @media (min-width: 640px) and (max-width: 671.98px) {
    .receipts {
      margin-inline: -2rem;
    }

    .receipts__grid {
      padding-inline: 2rem;
      scroll-padding-inline: 2rem;
    }
  }

  /* ── Side by side: two, then four, each dropped at a slight angle ─────
     Decided by the width of the counter, but only from 672px. Below that
     the receipts are the swipe row above, whose counter is as wide as the
     screen: without this guard these rules reached into it on screens
     560 to 639px wide and crushed the receipts into slivers. */
  @media (min-width: 672px) {
    @container (min-width: 35rem) {
      .receipts__grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }

      .receipt:nth-child(3n + 1) {
        rotate: -1deg;
      }

      .receipt:nth-child(3n + 2) {
        rotate: 0.5deg;
        translate: 0 -0.5rem;
      }

      .receipt:nth-child(3n) {
        rotate: 1.5deg;
      }
    }

    @container (min-width: 65rem) {
      .receipts__grid {
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 1.75rem;
      }
    }
  }

  /* ── Arrival ─────────────────────────────────────────────────────────
     The script above adds .will-reveal at once and .is-shown when the
     receipts are scrolled to. Each one follows the last by 90ms. */
  .receipts.will-reveal .receipt {
    opacity: 0;
    transform: translateY(14px);
  }

  .receipts.will-reveal.is-shown .receipt {
    opacity: 1;
    transform: none;
    transition:
      opacity 0.6s ease,
      transform 0.6s cubic-bezier(0.22, 1, 0.36, 1);
    transition-delay: calc(var(--i) * 90ms);
  }

  @media (prefers-reduced-motion: reduce) {
    .receipts.will-reveal .receipt {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }
</style>

<script>
  // On a phone the receipts are a row that is swiped. The dots under the row
  // show which receipt is in the middle of the screen.
  document.querySelectorAll<HTMLElement>("[data-receipts]").forEach((row) => {
    const slips = [...row.children] as HTMLElement[];
    const dots = [
      ...(row.parentElement?.querySelectorAll<HTMLElement>("[data-pager] span") ?? []),
    ];
    if (dots.length === 0 || dots.length !== slips.length) return;

    let frame = 0;
    const mark = () => {
      frame = 0;
      const box = row.getBoundingClientRect();
      const middle = box.left + box.width / 2;
      let nearest = 0;
      let best = Infinity;
      slips.forEach((slip, index) => {
        const slipBox = slip.getBoundingClientRect();
        const distance = Math.abs(slipBox.left + slipBox.width / 2 - middle);
        if (distance < best) {
          best = distance;
          nearest = index;
        }
      });
      dots.forEach((dot, index) => dot.classList.toggle("is-on", index === nearest));
    };

    row.addEventListener(
      "scroll",
      () => {
        frame ||= requestAnimationFrame(mark);
      },
      { passive: true },
    );
  });
</script>
