---
import type { Homepage } from "@/types";
import { WhyLapCircuitBucket } from "@/components/WhyLapCircuitBucket";

export interface Props {
  why?: Homepage["why_lapcircuit"];
}

const { why } = Astro.props as Props;
---

<section id="why-lapcircuit" class="scroll-mt-32 sm:scroll-mt-36 relative w-full bg-[#030508]">
  <WhyLapCircuitBucket
    client:load
    eyebrow={why?.eyebrow || "WHY LAPCIRCUIT"}
    title="Why businesses choose Lap Circuit"
    content="We’re a small team that works directly with business owners. That means we understand how your business actually operates—and build software around it."
  />
</section>
