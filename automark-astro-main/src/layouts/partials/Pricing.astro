---
import type { Homepage } from "@/types";
import { PricingOrbital } from "@/components/PricingOrbital";

export interface Props {
  pricing: Homepage["pricing"];
}

const { pricing } = Astro.props as Props;
---

<section id="pricing" class="scroll-mt-24 relative w-full bg-[#030508]">
  <PricingOrbital
    client:visible
    eyebrow={pricing?.eyebrow}
    title={pricing?.title}
    content={pricing?.content}
    cta_label={pricing?.cta_label}
    note={pricing?.note}
    tiers={pricing?.tiers}
  />
</section>
