---
import ImageMod from "@/components/ImageMod.astro";
import { markdownify } from "@/lib/utils/textConverter";
import type { Homepage } from "@/types";

export interface Props {
  about: Homepage["about"];
}

const { about } = Astro.props as Props;
---

<section id="about" class="section about">
  <div class="wrap about__container">
    {/* Left Column: Clear value proposition */}
    <div class="about__content">
      {about.eyebrow && <span class="about__eyebrow">{about.eyebrow}</span>}

      <h2 class="about__title" set:html={markdownify(about.title)} />

      {about.paragraphs.map((paragraph) => (
        <p class="about__lead">{paragraph}</p>
      ))}

      {about.features && about.features.length > 0 && (
        <ul class="about__features" role="list">
          {about.features.map((feature) => (
            <li class="about__feature">
              <span class="about__feature-dot" aria-hidden="true" />
              <span>{feature}</span>
            </li>
          ))}
        </ul>
      )}

      {about.supporting && <p class="about__supporting">{about.supporting}</p>}

      {about.closing && <p class="about__closing">{about.closing}</p>}
    </div>

    {/* Right Column: Clean, realistic POS checkout visual */}
    {
      about.media && (
        <figure class="about__visual">
          <div class="metal-frame about__frame">
            <ImageMod
              src={about.media.image}
              alt={about.media.alt}
              width={1265}
              widths={[480, 720, 960, 1265]}
              sizes="(min-width: 1280px) 580px, (min-width: 1024px) 46vw, calc(100vw - 2.5rem)"
              format="webp"
              quality={86}
            />
          </div>
          {about.media.caption && <figcaption>{about.media.caption}</figcaption>}
        </figure>
      )
    }
  </div>
</section>

<style>
  .about {
    position: relative;
    overflow: hidden;
  }

  .about__container {
    display: grid;
    gap: clamp(2rem, 4.5vw, 4rem);
    align-items: center;
  }

  .about__content {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .about__eyebrow {
    display: inline-block;
    color: var(--color-primary);
    font-family: var(--font-secondary);
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    margin-bottom: 0.875rem;
  }

  .about__title {
    color: var(--color-text-light);
    font-size: clamp(2rem, 3.4vw, 3rem);
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: -0.015em;
    text-transform: uppercase;
    margin: 0;
  }

  .about__lead {
    margin-top: 1.15rem;
    color: var(--color-text);
    font-size: clamp(1rem, 1.25vw, 1.125rem);
    line-height: 1.625;
    max-width: 52ch;
  }

  .about__features {
    display: flex;
    flex-wrap: wrap;
    gap: 0.625rem;
    margin: 1.5rem 0 0;
    padding: 0;
    list-style: none;
  }

  .about__feature {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.4rem 0.85rem;
    border-radius: 9999px;
    background-color: var(--color-light);
    border: 1px solid var(--color-border);
    color: var(--color-text-light);
    font-family: var(--font-primary);
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.02em;
  }

  .about__feature-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background-color: var(--color-primary);
    box-shadow: 0 0 8px var(--color-primary);
  }

  .about__supporting {
    margin-top: 1.25rem;
    color: var(--color-text-dark);
    font-size: 0.875rem;
    line-height: 1.5;
    max-width: 52ch;
  }

  .about__closing {
    margin-top: 0.875rem;
    color: var(--color-primary-light);
    font-family: var(--font-secondary);
    font-size: 0.875rem;
    font-weight: 600;
    letter-spacing: 0.03em;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }

  .about__closing::before {
    content: "";
    display: inline-block;
    width: 1.25rem;
    height: 1.5px;
    background-color: var(--color-primary);
  }

  .about__visual {
    margin: 0;
    position: relative;
  }

  .about__visual::before {
    content: "";
    position: absolute;
    inset: 5%;
    background: radial-gradient(
      circle,
      color-mix(in srgb, var(--color-primary) 18%, transparent) 0%,
      transparent 70%
    );
    filter: blur(50px);
    z-index: 0;
    pointer-events: none;
  }

  .about__visual figcaption {
    margin-top: 0.875rem;
    color: var(--color-text-dark);
    font-size: 0.875rem;
  }

  .about__frame {
    position: relative;
    z-index: 1;
    border-radius: 1rem;
    overflow: hidden;
    box-shadow: 0 20px 48px -16px rgb(0 0 0 / 0.7);
  }

  .about__frame :global(img) {
    display: block;
    width: 100%;
    height: auto;
    object-fit: cover;
  }

  @media (min-width: 860px) {
    .about__container {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: 3rem;
      align-items: center;
    }
  }

  @media (min-width: 1200px) {
    .about__container {
      grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);
      gap: 4.5rem;
    }
  }
</style>
