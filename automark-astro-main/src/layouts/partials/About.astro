---
import ImageMod from "@/components/ImageMod.astro";
import { markdownify } from "@/lib/utils/textConverter";
import type { Homepage } from "@/types";

export interface Props {
  about: Homepage["about"];
}

const { about } = Astro.props as Props;
---

{/* Why custom software matters: the statement across the top, a picture of
    the kind of system we build under it, and one supporting sentence beside
    the picture. */}
<section id="about" class="section about">
  <div class="wrap about__grid">
    <h2 class="about__title" data-breathe set:html={markdownify(about.title)} />

    {
      about.media && (
        <figure class="about__media">
          <div class="metal-frame">
            <ImageMod
              src={about.media.image}
              alt={about.media.alt}
              width={1265}
              widths={[480, 720, 960, 1265]}
              sizes="(min-width: 1296px) 626px, (min-width: 1024px) calc((100vw - 9rem) * 0.5834), (min-width: 640px) calc(100vw - 4rem), calc(100vw - 2.5rem)"
              format="webp"
              quality={84}
            />
          </div>
          {about.media.caption && <figcaption>{about.media.caption}</figcaption>}
        </figure>
      )
    }

    <div class="about__body">
      {about.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
    </div>
  </div>
</section>

<style>
  /* One column on a phone: statement, picture, sentence. */
  .about__grid {
    display: grid;
    gap: clamp(1.75rem, 3vw, 2.5rem) 2rem;
  }

  .about__media {
    margin: 0;
  }

  .about__media figcaption {
    margin-top: 0.875rem;
    color: var(--color-text-dark);
    font-size: 0.875rem;
  }

  .about__body {
    display: grid;
    align-content: start;
    gap: 1.25rem;
    max-width: 56ch;
  }

  /* The first sentence carries the argument, so it reads a step larger. */
  .about__body p:first-child {
    color: var(--color-text-light);
    font-size: clamp(1.0625rem, 1.4vw, 1.1875rem);
    line-height: 1.6;
  }

  /* On a computer the statement runs across the top, so each of its two
     sentences keeps to one line; under it the picture takes the wider
     share, because it is full of fine detail, and the sentence the rest. */
  @media (min-width: 1024px) {
    .about__grid {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
      column-gap: 4rem;
    }

    .about__title {
      grid-column: 1 / -1;
    }
  }
</style>
