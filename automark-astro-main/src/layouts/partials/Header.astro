---
import Logo from "@/components/Logo.astro";
import NavPill from "@/components/NavPill.astro";
import config from "@/config/config.json";
import menu from "@/config/menu.json";
import { contact, telUrl, whatsappUrl } from "@/lib/utils/contact";
import type { Menu } from "@/types";

const { main } = menu as Menu;
const { navigation_button } = config;
---

<header class="site-header">
  <div class="wrap site-header__bar">
    <Logo />

    {/* 3D Adaptive Navigation Pill (Desktop) */}
    <NavPill />

    {/* A real (visually hidden) checkbox, so the menu stays keyboard reachable
        and opens without JavaScript. */}
    <input
      id="nav-toggle"
      type="checkbox"
      class="sr-only"
      aria-controls="nav-menu"
      aria-label="Open menu"
    />
    <label for="nav-toggle" class="nav-burger" aria-hidden="true">
      <span class="nav-burger__bars">
        <span></span><span></span><span></span>
      </span>
    </label>

    <nav id="nav-menu" class="site-nav" aria-label="Main">
      <ul class="site-nav__list" role="list">
        {
          main.map((item) => (
            <li>
              <a class="site-nav__link" href={item.url}>
                {item.name}
              </a>
            </li>
          ))
        }
      </ul>

      {
        navigation_button.enable && (
          <div class="site-nav__action">
            <a
              class="btn btn-shiny btn-shiny--rest btn-sm"
              href={whatsappUrl()}
              target="_blank"
              rel="noopener noreferrer"
            >
              <span>{navigation_button.label}</span>
            </a>
            <p class="site-nav__call">
              Or call <a class="text-link" href={telUrl}>{contact.phoneDisplay}</a>
            </p>
          </div>
        )
      }
    </nav>
  </div>
</header>
