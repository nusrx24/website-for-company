---
import type { Homepage } from "@/types";
import WarrantyField from "@/components/WarrantyField";
import TextLoop from "@/components/ui/text-loop";

export interface Props {
  warranty: Homepage["warranty"];
}

const { warranty } = Astro.props as Props;
---

{/* One wide panel, not a card grid. The promise and its boundary are set as a
    matched pair so neither can be read without the other - the accent is spent
    on "covered", the limit stays quiet but equally prominent in size. */}
<section id="warranty" class="section scroll-mt-24">
  <div class="container">
    <div
      class="overflow-hidden rounded-2xl border border-border bg-light p-7 lg:p-12 shine-border"
    >
      <div class="mb-10 grid gap-8 lg:grid-cols-12 lg:items-center lg:gap-10">
        <div class="lg:col-span-6">
          {
            warranty.eyebrow && (
              <p class="mb-4 font-primary text-xs font-semibold tracking-[0.18em] text-primary uppercase">
                {warranty.eyebrow}
              </p>
            )
          }
          <div>
            <TextLoop
              client:visible
              staticText="Software bugs?"
              rotatingTexts={["We fix them.", "Covered for life.", "Zero extra fees.", "Direct support."]}
              className="text-h3 lg:text-h2 font-secondary font-bold uppercase leading-[1.1] tracking-tight flex-col items-start sm:flex-row sm:items-center sm:flex-wrap"
              staticTextClassName="text-white mr-0 sm:mr-3 whitespace-normal sm:whitespace-nowrap"
              rotatingTextClassName="text-primary pr-1 font-secondary font-bold uppercase drop-shadow-[0_0_14px_rgba(46,144,255,0.45)]"
              cursorClassName="bg-primary shadow-[0_0_10px_rgba(46,144,255,0.8)]"
              backgroundClassName="bg-gradient-to-r from-transparent via-primary/15 to-primary/25 rounded"
              interval={2800}
            />
          </div>
        </div>

        {/* The promise acted out: restless pixels settle into FIXED; a click
            or tap scatters them and they re-form. Decorative only. */}
        <div class="relative h-40 overflow-hidden rounded-xl border border-border bg-body sm:h-48 lg:col-span-6 lg:h-56 shine-border">
          <WarrantyField client:visible />
        </div>
      </div>

      <div class="grid gap-8 border-t border-border pt-8 lg:grid-cols-2 lg:gap-12">
        <div class="border-l-2 border-primary pl-5">
          <p
            class="mb-3 font-primary text-[11px] tracking-[0.16em] text-primary uppercase"
          >
            {warranty.covered_label}
          </p>
          <p class="text-base leading-[1.75] text-text-light">
            {warranty.covered}
          </p>
        </div>

        <div class="border-l-2 border-border pl-5">
          <p
            class="mb-3 font-primary text-[11px] tracking-[0.16em] text-text-dark uppercase"
          >
            {warranty.excluded_label}
          </p>
          <p class="text-base leading-[1.75] text-text">{warranty.excluded}</p>
        </div>
      </div>
    </div>
  </div>
</section>
