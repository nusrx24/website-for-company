---
import LocationCard from "@/components/LocationCard.astro";
import SocialLinks from "@/components/SocialLinks.astro";
import config from "@/config/config.json";
import menu from "@/config/menu.json";
import social from "@/config/social.json";
import { getListPage } from "@/lib/contentParser.astro";
import { CAP, glyphOf, layout } from "@/lib/footer/glyphs";
import { SHUTTER, blades, f, restPivot } from "@/lib/footer/shutter";
import { contact, mailtoUrl, telUrl, whatsappUrl } from "@/lib/utils/contact";
import type { Menu, SocialType } from "@/types";

// The closing section: a dark slate block set in monospace capitals. It opens
// with the four places to find us (Facebook, LinkedIn, WhatsApp, Email), and
// ends with the company name across the full width in a drawn, geometric
// alphabet. One
// letter is swapped for a "shutter" - three blue blades that meet at a pivot,
// and the pivot turns to follow the pointer. Its colours are the four
// variables at the top of the <style> block below.

// What the giant wordmark spells, and which letter the shutter replaces
// (counting from 0; -1 for none). It takes the place of the U: that leaves
// LAP whole and CIRC_IT still reads as CIRCUIT, where replacing a letter of
// LAP made the name read as "LA CIRCUIT".
const WORD = config.site.title.toUpperCase();
const SHUTTER_AT = 7;

const { items, width } = layout(WORD, SHUTTER_AT);
const rest = restPivot(0);

// No legal links: the template's privacy and terms pages were Lorem Ipsum and
// have been removed. Add real ones before publishing anything that collects
// personal data.
const { footer } = menu as Menu;
const navigate = footer.map((item) => ({ label: item.name, href: item.url }));

// Every way to reach the company. A social entry shows only once it has a
// real profile link in social.json.
const reach = [
  { label: "WhatsApp", href: whatsappUrl() },
  { label: contact.phoneDisplay, href: telUrl },
  { label: contact.email, href: mailtoUrl("Software enquiry") },
  ...(social as SocialType).main
    .filter((item) => item.link)
    .map((item) => ({ label: item.name, href: item.link })),
];

const { data } = await getListPage("homepage", "-index");
// The small print: the main place as a card, the other places under it.
const { card, places, languages } = data.locations;

const year = new Date().getFullYear();

const external = (href: string) =>
  /^https?:/.test(href) ? { target: "_blank", rel: "noopener noreferrer" } : {};

// The top row fades in piece by piece, 60ms apart, in reading order.
let step = 0;
const next = () => `--sgf-d:${(step += 60)}ms`;
const socialDelay = next();
const navigateDelays = navigate.map(next);
const smallDelay = next();
const reachDelays = reach.map(next);
---

<footer class="sgf" data-sgf data-in="true">
  <div class="sgf-top">
    {/* Where else to find us, first. Pointing at a name raises its icon. */}
    <div class="sgf-social sgf-fade" style={socialDelay}>
      <SocialLinks />
    </div>

    <nav aria-label="Footer">
      <ul class="sgf-list sgf-list--pair">
        {
          navigate.map((link, i) => (
            <li class="sgf-fade" style={navigateDelays[i]}>
              <a class="sgf-link" href={link.href} aria-label={link.label}>
                <span data-label aria-hidden="true">{link.label}</span>
                <svg viewBox="0 0 12 12" aria-hidden="true">
                  <path d="M1 6h9.2M6.4 2.2 10.2 6l-3.8 3.8" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="square" />
                </svg>
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="sgf-copy sgf-fade" style={smallDelay}>
      <p>© {year}<br />{config.site.title}</p>
      {
        card && (
          <div class="sgf-place">
            <LocationCard
              name={card.name}
              coordinates={card.coordinates}
              tag={card.tag}
              hint={card.hint}
            />
          </div>
        )
      }
      <div class="sgf-lines">
        {places.length > 0 && <p>{places.join(" · ")}</p>}
        {languages.length > 0 && <p>{languages.join(" · ")}</p>}
      </div>
    </div>

    <nav aria-label="Contact">
      <ul class="sgf-list">
        {
          reach.map((link, i) => (
            <li class="sgf-fade" style={reachDelays[i]}>
              <a
                class="sgf-link"
                href={link.href}
                aria-label={link.label}
                {...external(link.href)}
              >
                <span data-label aria-hidden="true">{link.label}</span>
                <svg viewBox="0 0 12 12" aria-hidden="true">
                  <path d="M1 6h9.2M6.4 2.2 10.2 6l-3.8 3.8" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="square" />
                </svg>
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>

  <div class="sgf-mark">
    <p class="sr-only">{config.site.title}</p>
    <svg
      class="sgf-svg"
      viewBox={`0 0 ${f(width)} ${CAP}`}
      style={`aspect-ratio:${f(width)} / ${CAP}`}
      data-width={f(width)}
      aria-hidden="true"
      focusable="false"
    >
      <defs>
        {/* Every letter is drawn twice, cut at its waist; hover slides the
            halves apart. */}
        <clipPath id="sgf-up" clipPathUnits="userSpaceOnUse">
          <rect x="-40" y="-200" width="400" height="252.6"></rect>
        </clipPath>
        <clipPath id="sgf-dn" clipPathUnits="userSpaceOnUse">
          <rect x="-40" y="51.4" width="400" height="250"></rect>
        </clipPath>
      </defs>
      {
        items.map((item, i) => {
          if (item.ch.trim() === "") return null;
          const rise = `--sgf-d:${200 + i * 90}ms`;

          if (item.shutter) {
            return (
              <g transform={`translate(${f(item.x)} 0)`}>
                <g class="sgf-rise" style={rise}>
                  <g class="sgf-g sgf-sh" data-shutter data-x={f(item.x)}>
                    <rect width={SHUTTER} height={CAP} fill="transparent" />
                    {blades(rest[0], rest[1], 0).map((points) => (
                      <polygon points={points.map(f).join(" ")} />
                    ))}
                  </g>
                </g>
              </g>
            );
          }

          const glyph = glyphOf(item.ch);
          return (
            <g transform={`translate(${f(item.x)} 0)`}>
              <g class="sgf-rise" style={rise}>
                <g class="sgf-g sgf-flip">
                  <rect width={glyph.w} height={CAP} fill="transparent" />
                  <g clip-path="url(#sgf-up)">
                    <g class="sgf-half sgf-up">
                      {glyph.d.map((d) => (
                        <path d={d} fill-rule="evenodd" />
                      ))}
                    </g>
                  </g>
                  <g clip-path="url(#sgf-dn)">
                    <g class="sgf-half sgf-dn">
                      {glyph.d.map((d) => (
                        <path d={d} fill-rule="evenodd" />
                      ))}
                    </g>
                  </g>
                </g>
              </g>
            </g>
          );
        })
      }
    </svg>
  </div>
</footer>

{/* The footer rises into place the first time it is scrolled to. This runs
    as the page is read, before the footer is drawn, so it never flashes;
    without JavaScript, or for anyone who has asked for less motion, the
    footer is simply there. */}
<script is:inline>
  (function () {
    var el = document.currentScript.previousElementSibling;
    if (!el || !("IntersectionObserver" in window)) return;
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
    el.setAttribute("data-in", "false");
    new IntersectionObserver(
      function (entries, observer) {
        if (!entries[0].isIntersecting) return;
        el.setAttribute("data-in", "true");
        observer.disconnect();
      },
      { threshold: 0.1 },
    ).observe(el);
  })();
</script>

<style>
  /* Colours. These four lines are the whole footer's palette.
     The block is the site's dark slate - the colour of its panels and cards -
     a touch lighter along its top edge, and everything on it is printed in
     the site's off-white. Blue is kept for one thing only: the one letter
     that moves (the shutter). All four are colours from theme.json. */
  .sgf {
    --sgf-bg: var(--color-light);
    --sgf-top: color-mix(in srgb, var(--color-light) 97%, #fff);
    --sgf-ink: var(--color-text-light);
    --sgf-accent: var(--color-primary);
    position: relative;
    isolation: isolate;
    overflow: hidden;
    container-type: inline-size;
    color: var(--sgf-ink);
    background: linear-gradient(180deg, var(--sgf-top) 0%, var(--sgf-bg) 24%);
    font-family: var(--font-secondary);
    font-size: clamp(13px, 1.25cqw, 15px);
    line-height: 1.5;
    letter-spacing: 0.01em;
    -webkit-font-smoothing: antialiased;
  }

  /* Resets go through :where() so they never out-rank the classes below. */
  :where(.sgf) a {
    color: inherit;
    text-decoration: none;
  }

  :where(.sgf) button {
    margin: 0;
    padding: 0;
    border: 0;
    background: none;
    color: inherit;
    font: inherit;
    letter-spacing: inherit;
    text-transform: inherit;
    cursor: pointer;
  }

  :where(.sgf) ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  :where(.sgf) p {
    margin: 0;
  }

  .sgf svg {
    max-width: none;
  }

  .sgf [hidden] {
    display: none;
  }

  /* ── Top row ───────────────────────────────────────────────────────────
     The four social buttons have a line of their own, the full width. Below
     them: the page links, the small print and the contact links. */
  .sgf-top {
    box-sizing: border-box;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 2fr) auto;
    column-gap: 24px;
    row-gap: 36px;
    padding: clamp(64px, 11.5cqw, 150px) clamp(16px, 2.6cqw, 40px) 0;
  }

  .sgf-fade {
    transition:
      opacity 0.8s ease var(--sgf-d, 0ms),
      translate 0.8s cubic-bezier(0.2, 0.7, 0.1, 1) var(--sgf-d, 0ms);
  }

  .sgf[data-in="false"] .sgf-fade {
    opacity: 0;
    translate: 0 10px;
  }

  /* ── Where to find us ───────────────────────────────────────────────────
     Four round icon buttons (SocialLinks.astro) on a line of their own,
     starting at the footer's margin like everything under them. */
  .sgf-social {
    grid-column: 1 / -1;
    letter-spacing: normal;
    text-transform: none;
  }

  .sgf-social :global(.social) {
    justify-content: flex-start;
  }

  /* Pointing at a button shows its name on a label that reaches 50px below
     it. This is the room for that label, so it does not land on the links
     underneath. A touch screen shows no label and needs no room. */
  @media (hover: hover) {
    .sgf-social {
      padding-bottom: 20px;
    }
  }

  /* ── Links: a mono label, an arrow that walks right, an underline that
        wipes in ───────────────────────────────────────────────────────── */
  .sgf-list {
    display: flex;
    flex-direction: column;
    gap: clamp(5px, 0.6cqw, 7px);
  }

  .sgf-link {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 0.65em;
    padding: 1px 0;
    white-space: nowrap;
  }

  .sgf-link::after {
    content: "";
    position: absolute;
    right: 1.6em;
    bottom: -2px;
    left: 0;
    height: 1px;
    background: currentColor;
    transform: scaleX(0);
    transform-origin: 100% 50%;
    transition: transform 0.4s cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .sgf-link:hover::after,
  .sgf-link:focus-visible::after {
    transform: scaleX(1);
    transform-origin: 0 50%;
  }

  .sgf-link svg {
    flex: none;
    width: 0.8em;
    height: 0.8em;
    transition: translate 0.35s cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .sgf-link:hover svg,
  .sgf-link:focus-visible svg {
    translate: 5px 0;
  }

  .sgf-link:focus-visible {
    outline: none;
  }

  /* On a touch screen every link is a fingertip tall (44px). The underline
     moves up with the text, which now sits in the middle of a taller row. */
  @media (pointer: coarse) {
    .sgf-list {
      gap: 0;
    }

    .sgf-link {
      min-width: 44px;
      min-height: 44px;
      padding: 0;
    }

    .sgf-link::after {
      bottom: calc(50% - 0.6em - 3px);
    }

  }

  /* The small print: the year and name, the location card, then the other
     places and the languages, a blank line apart.
     On a wide footer it stands at the right of its column, next to the
     contact links (owner's request). Its box is as wide as the card is when
     open, so the card opens into room that is already there and the lines
     around it never move sideways. */
  .sgf-copy {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.18em;
    justify-self: end;
    width: min(360px, 100%);
  }

  /* The room under the card is for its hint ("Click to expand"), which
     appears 9px below it and must not sit on the places listed next. */
  .sgf-place {
    max-width: 100%;
    margin-bottom: 20px;
  }

  /* ── The wordmark ────────────────────────────────────────────────────── */
  .sgf-mark {
    box-sizing: border-box;
    padding: clamp(36px, 4.6cqw, 64px) clamp(16px, 2.6cqw, 40px)
      clamp(14px, 2.1cqw, 28px);
  }

  .sgf-svg {
    display: block;
    overflow: hidden;
    width: 100%;
    height: auto;
    fill: var(--sgf-ink);
  }

  .sgf-rise {
    transition: transform 1.15s cubic-bezier(0.16, 0.84, 0.2, 1) var(--sgf-d, 0ms);
  }

  .sgf[data-in="false"] .sgf-rise {
    transform: translateY(112px);
  }

  .sgf-g {
    cursor: pointer;
  }

  /* Click a letter and it flips. */
  .sgf-flip {
    transform-box: fill-box;
    transform-origin: 50% 50%;
  }

  .sgf-flip.is-flip {
    animation: sgf-flip 0.7s cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  @keyframes sgf-flip {
    0% {
      transform: scaleY(1);
    }
    45% {
      transform: scaleY(-1);
    }
    100% {
      transform: scaleY(1);
    }
  }

  /* Hover a letter and it slices along its waist. */
  .sgf-half {
    transition: transform 0.45s cubic-bezier(0.2, 0.9, 0.25, 1.15);
  }

  .sgf-g:hover .sgf-up {
    transform: translate(5px, -1.5px);
  }

  .sgf-g:hover .sgf-dn {
    transform: translate(-5px, 1.5px);
  }

  /* The shutter is the one letter in the accent colour. */
  .sgf-sh polygon {
    fill: var(--sgf-accent);
    transition: none;
  }

  /* ── Narrower footers ────────────────────────────────────────────────── */
  @container (max-width: 760px) {
    .sgf-top {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    }

    .sgf-top > :first-child,
    .sgf-top > .sgf-copy {
      grid-column: 1 / -1;
    }

    /* Under the other blocks, and back at the left margin with them. */
    .sgf-copy {
      order: 3;
      justify-self: start;
      width: 100%;
    }
  }

  /* One column a little earlier than the source design (460px, not 420px),
     so the email address always has room on one line. */
  @container (max-width: 460px) {
    .sgf-top {
      grid-template-columns: minmax(0, 1fr);
    }

    /* The page links are short, so they pair up and take half the rows. */
    .sgf-list--pair {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: 24px;
    }
  }

  /* Phone: print a size larger (11px capitals are hard work on a small
     screen), and line the block up with the page's own 20px margin. */
  @media (max-width: 639.98px) {
    .sgf {
      font-size: 13px;
      line-height: 1.3;
    }

    .sgf-top {
      row-gap: 28px;
      padding-top: 5rem;
      padding-inline: 1.25rem;
    }

    .sgf-mark {
      padding-inline: 1.25rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .sgf .sgf-rise,
    .sgf .sgf-fade,
    .sgf .sgf-half,
    .sgf .sgf-link svg,
    .sgf .sgf-link::after {
      transition: none !important;
    }

    .sgf .sgf-flip {
      animation: none !important;
    }

    .sgf[data-in="false"] .sgf-rise {
      transform: none;
    }

    .sgf[data-in="false"] .sgf-fade {
      opacity: 1;
      translate: none;
    }
  }
</style>

<script>
  // What moves in the footer: the shutter follows the pointer and turns when
  // clicked, letters flip when clicked, and links scramble on hover.
  import { approach, blades, clamp, f, restPivot, scramble } from "@/lib/footer/shutter";

  document.querySelectorAll<HTMLElement>("[data-sgf]").forEach((root) => {
    const reduce = window.matchMedia("(prefers-reduced-motion: reduce)");
    const still = () => reduce.matches;

    // ── Links: scramble through noise glyphs, then settle ───────────────
    root.querySelectorAll<HTMLAnchorElement>(".sgf-link").forEach((link) => {
      const label = link.querySelector<HTMLElement>("[data-label]");
      if (!label) return;
      const text = label.textContent ?? "";
      let frame = 0;

      const run = () => {
        if (still()) return;
        cancelAnimationFrame(frame);
        const t0 = performance.now();
        const seed = Math.random() * 100;
        let n = 0;
        const step = (now: number) => {
          const progress = (now - t0) / 420;
          if (progress >= 1) {
            label.textContent = text;
            return;
          }
          // A new noise glyph every other frame reads as typing, not static.
          if (n++ % 2 === 0) {
            label.textContent = scramble(text, progress, seed + Math.floor(n / 2));
          }
          frame = requestAnimationFrame(step);
        };
        frame = requestAnimationFrame(step);
      };

      link.addEventListener("pointerenter", run);
      link.addEventListener("focus", run);
    });

    // ── Letters: click to flip ──────────────────────────────────────────
    root.querySelectorAll<SVGGElement>(".sgf-flip").forEach((letter) => {
      letter.addEventListener("click", () => {
        if (still()) return;
        letter.classList.remove("is-flip");
        void letter.getBoundingClientRect();
        letter.classList.add("is-flip");
      });
      letter.addEventListener("animationend", () => letter.classList.remove("is-flip"));
    });

    // ── The shutter ─────────────────────────────────────────────────────
    const svg = root.querySelector<SVGSVGElement>(".sgf-svg");
    const shutter = root.querySelector<SVGGElement>("[data-shutter]");

    if (svg && shutter) {
      const polygons = [...shutter.querySelectorAll("polygon")];
      const width = Number(svg.dataset.width) || 1;
      const offset = Number(shutter.dataset.x) || 0;
      const pointer = { x: 0, y: 0, inside: false };
      let turns = 0;
      let pivot = restPivot(0);
      let visible = false;
      let frame = 0;
      let last = 0;
      let drawn = "";

      // The blades are written straight to the polygons, and only when the
      // pivot has actually moved.
      const paint = (x: number, y: number) => {
        const key = `${f(x)} ${f(y)} ${turns}`;
        if (key === drawn) return;
        drawn = key;
        blades(x, y, turns).forEach((points, i) => {
          polygons[i]?.setAttribute("points", points.map(f).join(" "));
        });
      };

      const tick = (now: number) => {
        const dt = Math.min(0.1, (now - last) / 1000);
        last = now;
        const rest = restPivot(turns);
        const tx = pointer.inside ? clamp(pointer.x, 8, 92) : rest[0];
        const ty = pointer.inside ? clamp(pointer.y, 8, 92) : rest[1];
        pivot = [approach(pivot[0], tx, 0.12, dt), approach(pivot[1], ty, 0.12, dt)];
        paint(pivot[0], pivot[1]);
        frame = requestAnimationFrame(tick);
      };

      // The pivot eases toward the pointer while the footer is on screen;
      // otherwise it sits at rest and nothing runs.
      const start = () => {
        cancelAnimationFrame(frame);
        if (still() || !visible) {
          pivot = restPivot(turns);
          paint(pivot[0], pivot[1]);
          return;
        }
        last = performance.now();
        frame = requestAnimationFrame(tick);
      };

      const onPointer = (event: PointerEvent) => {
        pointer.inside = event.type !== "pointerleave";
        // The pointer in the shutter's own units, from the SVG's on-screen box.
        const box = svg.getBoundingClientRect();
        const scale = box.width / width || 1;
        pointer.x = (event.clientX - box.left) / scale - offset;
        pointer.y = (event.clientY - box.top) / scale;
      };

      root.addEventListener("pointermove", onPointer);
      root.addEventListener("pointerenter", onPointer);
      root.addEventListener("pointerleave", onPointer);

      // Click the shutter and its blades rotate a quarter turn.
      shutter.addEventListener("click", () => {
        turns += 1;
        start();
      });

      new IntersectionObserver(
        ([entry]) => {
          visible = entry.isIntersecting;
          start();
        },
        { threshold: 0.1 },
      ).observe(root);

      reduce.addEventListener("change", start);
    }
  });
</script>
