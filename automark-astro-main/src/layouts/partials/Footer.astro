---
import config from "@/config/config.json";
import menu from "@/config/menu.json";
import social from "@/config/social.json";
import { getListPage } from "@/lib/contentParser.astro";
import { CAP, glyphOf, layout } from "@/lib/footer/glyphs";
import { SHUTTER, blades, f, restPivot } from "@/lib/footer/shutter";
import { contact, mailtoUrl, telUrl, whatsappUrl } from "@/lib/utils/contact";
import type { Menu, SocialType } from "@/types";

// The closing section: a block of the brand's blue set in monospace capitals,
// with the company name across the full width in a drawn, geometric alphabet.
// One letter is swapped for a "shutter" - three blades that meet at a pivot,
// and the pivot turns to follow the pointer.

// What the giant wordmark spells, and which letter the shutter replaces
// (counting from 0; -1 for none). It takes the place of the U: that leaves
// LAP whole and CIRC_IT still reads as CIRCUIT, where replacing a letter of
// LAP made the name read as "LA CIRCUIT".
const WORD = config.site.title.toUpperCase();
const SHUTTER_AT = 7;

const { items, width } = layout(WORD, SHUTTER_AT);
const rest = restPivot(0);

// No legal links: the template's privacy and terms pages were Lorem Ipsum and
// have been removed. Add real ones before publishing anything that collects
// personal data.
const { footer } = menu as Menu;
const navigate = footer.map((item) => ({ label: item.name, href: item.url }));

// Every way to reach the company. A social entry shows only once it has a
// real profile link in social.json.
const reach = [
  { label: "WhatsApp", href: whatsappUrl() },
  { label: contact.phoneDisplay, href: telUrl },
  { label: contact.email, href: mailtoUrl("Software enquiry") },
  ...(social as SocialType).main
    .filter((item) => item.link)
    .map((item) => ({ label: item.name, href: item.link })),
];

const { data } = await getListPage("homepage", "-index");
const { places, languages } = data.locations;

const { footer_message_label, footer_message_placeholder } = config.params;
const year = new Date().getFullYear();
const small = [
  `© ${year}`,
  config.site.title,
  "",
  places.join(" · "),
  languages.join(" · "),
].join("\n");

const external = (href: string) =>
  /^https?:/.test(href) ? { target: "_blank", rel: "noopener noreferrer" } : {};

// The top row fades in piece by piece, 60ms apart, in reading order.
let step = 0;
const next = () => `--sgf-d:${(step += 60)}ms`;
const formDelay = next();
const navigateDelays = navigate.map(next);
const smallDelay = next();
const reachDelays = reach.map(next);
---

<footer class="sgf" data-sgf data-in="true">
  <div class="sgf-top">
    {/* A message box rather than a newsletter signup: there is no mailing
        list. What is typed opens in WhatsApp, ready to send. It is a plain
        form, so it works without JavaScript too. */}
    <form
      class="sgf-form sgf-fade"
      style={formDelay}
      action={`https://wa.me/${contact.whatsappNumber}`}
      method="get"
      target="_blank"
      novalidate
      data-empty="Type a message first"
    >
      <label for="sgf-message" class="sgf-lede">{footer_message_label}</label>
      <div class="sgf-field" data-state="idle">
        <input
          id="sgf-message"
          class="sgf-input"
          type="text"
          name="text"
          autocomplete="off"
          spellcheck="false"
          placeholder={footer_message_placeholder}
          aria-describedby="sgf-msg"
        />
        <button class="sgf-go" type="submit" aria-label="Send on WhatsApp">
          <svg viewBox="0 0 12 12" aria-hidden="true">
            <path d="M1 6h9.2M6.4 2.2 10.2 6l-3.8 3.8" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="square"></path>
          </svg>
        </button>
        <div class="sgf-done" role="status" hidden>
          <svg viewBox="0 0 12 12" aria-hidden="true">
            <path d="M1.5 6.4 4.6 9.4 10.6 2.6" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="square"></path>
          </svg>
          <span>Continue in WhatsApp</span>
          <button type="button">Clear</button>
        </div>
      </div>
      <p id="sgf-msg" class="sgf-msg" aria-live="polite"></p>
    </form>

    <nav aria-label="Footer">
      <ul class="sgf-list sgf-list--pair">
        {
          navigate.map((link, i) => (
            <li class="sgf-fade" style={navigateDelays[i]}>
              <a class="sgf-link" href={link.href} aria-label={link.label}>
                <span data-label aria-hidden="true">{link.label}</span>
                <svg viewBox="0 0 12 12" aria-hidden="true">
                  <path d="M1 6h9.2M6.4 2.2 10.2 6l-3.8 3.8" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="square" />
                </svg>
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <p class="sgf-copy sgf-fade" style={smallDelay}>{small}</p>

    <nav aria-label="Contact">
      <ul class="sgf-list">
        {
          reach.map((link, i) => (
            <li class="sgf-fade" style={reachDelays[i]}>
              <a
                class="sgf-link"
                href={link.href}
                aria-label={link.label}
                {...external(link.href)}
              >
                <span data-label aria-hidden="true">{link.label}</span>
                <svg viewBox="0 0 12 12" aria-hidden="true">
                  <path d="M1 6h9.2M6.4 2.2 10.2 6l-3.8 3.8" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="square" />
                </svg>
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>

  <div class="sgf-mark">
    <p class="sr-only">{config.site.title}</p>
    <svg
      class="sgf-svg"
      viewBox={`0 0 ${f(width)} ${CAP}`}
      style={`aspect-ratio:${f(width)} / ${CAP}`}
      data-width={f(width)}
      aria-hidden="true"
      focusable="false"
    >
      <defs>
        {/* Every letter is drawn twice, cut at its waist; hover slides the
            halves apart. */}
        <clipPath id="sgf-up" clipPathUnits="userSpaceOnUse">
          <rect x="-40" y="-200" width="400" height="252.6"></rect>
        </clipPath>
        <clipPath id="sgf-dn" clipPathUnits="userSpaceOnUse">
          <rect x="-40" y="51.4" width="400" height="250"></rect>
        </clipPath>
      </defs>
      {
        items.map((item, i) => {
          if (item.ch.trim() === "") return null;
          const rise = `--sgf-d:${200 + i * 90}ms`;

          if (item.shutter) {
            return (
              <g transform={`translate(${f(item.x)} 0)`}>
                <g class="sgf-rise" style={rise}>
                  <g class="sgf-g sgf-sh" data-shutter data-x={f(item.x)}>
                    <rect width={SHUTTER} height={CAP} fill="transparent" />
                    {blades(rest[0], rest[1], 0).map((points) => (
                      <polygon points={points.map(f).join(" ")} />
                    ))}
                  </g>
                </g>
              </g>
            );
          }

          const glyph = glyphOf(item.ch);
          return (
            <g transform={`translate(${f(item.x)} 0)`}>
              <g class="sgf-rise" style={rise}>
                <g class="sgf-g sgf-flip">
                  <rect width={glyph.w} height={CAP} fill="transparent" />
                  <g clip-path="url(#sgf-up)">
                    <g class="sgf-half sgf-up">
                      {glyph.d.map((d) => (
                        <path d={d} fill-rule="evenodd" />
                      ))}
                    </g>
                  </g>
                  <g clip-path="url(#sgf-dn)">
                    <g class="sgf-half sgf-dn">
                      {glyph.d.map((d) => (
                        <path d={d} fill-rule="evenodd" />
                      ))}
                    </g>
                  </g>
                </g>
              </g>
            </g>
          );
        })
      }
    </svg>
  </div>
</footer>

{/* The footer rises into place the first time it is scrolled to. This runs
    as the page is read, before the footer is drawn, so it never flashes;
    without JavaScript, or for anyone who has asked for less motion, the
    footer is simply there. */}
<script is:inline>
  (function () {
    var el = document.currentScript.previousElementSibling;
    if (!el || !("IntersectionObserver" in window)) return;
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
    el.setAttribute("data-in", "false");
    new IntersectionObserver(
      function (entries, observer) {
        if (!entries[0].isIntersecting) return;
        el.setAttribute("data-in", "true");
        observer.disconnect();
      },
      { threshold: 0.1 },
    ).observe(el);
  })();
</script>

<style>
  /* Colours. The block is the brand's blue, a touch lighter along its top
     edge; everything on it is printed in the site's near-black. */
  .sgf {
    --sgf-bg: var(--color-primary);
    --sgf-top: color-mix(in srgb, var(--color-primary) 87%, #fff);
    --sgf-ink: var(--color-body);
    position: relative;
    isolation: isolate;
    overflow: hidden;
    container-type: inline-size;
    color: var(--sgf-ink);
    background: linear-gradient(180deg, var(--sgf-top) 0%, var(--sgf-bg) 24%);
    font-family: var(--font-primary);
    font-size: clamp(11px, 1.12cqw, 13.5px);
    line-height: 1.18;
    letter-spacing: 0.015em;
    text-transform: uppercase;
    -webkit-font-smoothing: antialiased;
  }

  .sgf ::selection {
    background: var(--sgf-ink);
    color: var(--sgf-bg);
  }

  /* Resets go through :where() so they never out-rank the classes below. */
  :where(.sgf) a {
    color: inherit;
    text-decoration: none;
  }

  :where(.sgf) button {
    margin: 0;
    padding: 0;
    border: 0;
    background: none;
    color: inherit;
    font: inherit;
    letter-spacing: inherit;
    text-transform: inherit;
    cursor: pointer;
  }

  :where(.sgf) ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  :where(.sgf) p {
    margin: 0;
  }

  .sgf svg {
    max-width: none;
  }

  .sgf [hidden] {
    display: none;
  }

  /* ── Top row ─────────────────────────────────────────────────────────── */
  .sgf-top {
    box-sizing: border-box;
    display: grid;
    grid-template-columns: minmax(0, 2fr) minmax(0, 1fr) minmax(0, 2fr) auto;
    column-gap: 24px;
    row-gap: 36px;
    padding: clamp(64px, 11.5cqw, 150px) clamp(16px, 2.6cqw, 40px) 0;
  }

  .sgf-fade {
    transition:
      opacity 0.8s ease var(--sgf-d, 0ms),
      translate 0.8s cubic-bezier(0.2, 0.7, 0.1, 1) var(--sgf-d, 0ms);
  }

  .sgf[data-in="false"] .sgf-fade {
    opacity: 0;
    translate: 0 10px;
  }

  /* ── Message box ─────────────────────────────────────────────────────── */
  .sgf-form {
    max-width: 266px;
  }

  .sgf-lede {
    display: block;
    max-width: 232px;
  }

  .sgf-field {
    position: relative;
    display: flex;
    align-items: center;
    margin-top: clamp(18px, 2.2cqw, 26px);
    padding: 4px 0 5px;
    border-bottom: 1px solid var(--sgf-ink);
  }

  /* A second, heavier rule that wipes in while the field has focus. */
  .sgf-field::after {
    content: "";
    position: absolute;
    right: 0;
    bottom: -2px;
    left: 0;
    height: 2px;
    background: var(--sgf-ink);
    transform: scaleX(0);
    transform-origin: 0 50%;
    transition: transform 0.5s cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .sgf-field:focus-within::after {
    transform: scaleX(1);
  }

  .sgf-field[data-state="error"] {
    animation: sgf-shake 0.42s cubic-bezier(0.36, 0.07, 0.19, 0.97);
  }

  @keyframes sgf-shake {
    20%,
    60% {
      translate: -5px 0;
    }
    40%,
    80% {
      translate: 5px 0;
    }
  }

  .sgf-input {
    flex: 1;
    min-width: 0;
    margin: 0;
    padding: 0;
    border: 0;
    border-radius: 0;
    outline: none;
    background: transparent;
    color: inherit;
    font: inherit;
    letter-spacing: inherit;
    text-transform: uppercase;
    appearance: none;
  }

  .sgf-input::placeholder {
    color: var(--sgf-ink);
    opacity: 1;
    transition: opacity 0.25s;
  }

  .sgf-input:focus::placeholder {
    opacity: 0.4;
  }

  .sgf-go {
    display: grid;
    flex: none;
    place-items: center;
    width: 26px;
    height: 20px;
    margin-right: -6px;
  }

  .sgf-go svg {
    width: 11px;
    height: 11px;
    transition: translate 0.35s cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .sgf-go:hover svg,
  .sgf-go:focus-visible svg {
    translate: 4px 0;
  }

  .sgf-go:focus-visible {
    outline: 1px dashed var(--sgf-ink);
    outline-offset: 1px;
  }

  .sgf-done {
    display: flex;
    flex: 1;
    align-items: center;
    gap: 10px;
  }

  .sgf-done svg {
    flex: none;
    width: 12px;
    height: 12px;
  }

  .sgf-done button {
    margin-left: auto;
    opacity: 0.55;
    transition: opacity 0.2s;
  }

  .sgf-done button:hover,
  .sgf-done button:focus-visible {
    opacity: 1;
    outline: none;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .sgf-msg {
    min-height: 1.2em;
    margin-top: 8px;
    font-size: 0.86em;
    opacity: 0.85;
  }

  /* ── Links: a mono label, an arrow that walks right, an underline that
        wipes in ───────────────────────────────────────────────────────── */
  .sgf-list {
    display: flex;
    flex-direction: column;
    gap: clamp(5px, 0.6cqw, 7px);
  }

  .sgf-link {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 0.65em;
    padding: 1px 0;
    white-space: nowrap;
  }

  .sgf-link::after {
    content: "";
    position: absolute;
    right: 1.6em;
    bottom: -2px;
    left: 0;
    height: 1px;
    background: currentColor;
    transform: scaleX(0);
    transform-origin: 100% 50%;
    transition: transform 0.4s cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .sgf-link:hover::after,
  .sgf-link:focus-visible::after {
    transform: scaleX(1);
    transform-origin: 0 50%;
  }

  .sgf-link svg {
    flex: none;
    width: 0.8em;
    height: 0.8em;
    transition: translate 0.35s cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .sgf-link:hover svg,
  .sgf-link:focus-visible svg {
    translate: 5px 0;
  }

  .sgf-link:focus-visible {
    outline: none;
  }

  /* On a touch screen everything that is tapped is a fingertip tall (44px):
     the links, the message box, its arrow and "Clear". The link's underline
     moves up with the text, which now sits in the middle of a taller row.

     The message box is also set at 16px there. Below that size an iPhone
     zooms the whole page in when the box is tapped and leaves it zoomed. */
  @media (pointer: coarse) {
    .sgf-list {
      gap: 0;
    }

    .sgf-link {
      min-height: 44px;
      padding: 0;
    }

    .sgf-link::after {
      bottom: calc(50% - 0.6em - 3px);
    }

    .sgf-input {
      min-height: 44px;
      font-size: 16px;
    }

    .sgf-go {
      place-items: center end;
      width: 44px;
      height: 44px;
    }

    .sgf-go svg {
      width: 13px;
      height: 13px;
    }

    .sgf-done {
      min-height: 44px;
    }

    .sgf-done button {
      min-height: 44px;
      padding-inline: 8px;
    }
  }

  .sgf-copy {
    white-space: pre-line;
  }

  /* ── The wordmark ────────────────────────────────────────────────────── */
  .sgf-mark {
    box-sizing: border-box;
    padding: clamp(36px, 4.6cqw, 64px) clamp(16px, 2.6cqw, 40px)
      clamp(14px, 2.1cqw, 28px);
  }

  .sgf-svg {
    display: block;
    overflow: hidden;
    width: 100%;
    height: auto;
    fill: var(--sgf-ink);
  }

  .sgf-rise {
    transition: transform 1.15s cubic-bezier(0.16, 0.84, 0.2, 1) var(--sgf-d, 0ms);
  }

  .sgf[data-in="false"] .sgf-rise {
    transform: translateY(112px);
  }

  .sgf-g {
    cursor: pointer;
  }

  /* Click a letter and it flips. */
  .sgf-flip {
    transform-box: fill-box;
    transform-origin: 50% 50%;
  }

  .sgf-flip.is-flip {
    animation: sgf-flip 0.7s cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  @keyframes sgf-flip {
    0% {
      transform: scaleY(1);
    }
    45% {
      transform: scaleY(-1);
    }
    100% {
      transform: scaleY(1);
    }
  }

  /* Hover a letter and it slices along its waist. */
  .sgf-half {
    transition: transform 0.45s cubic-bezier(0.2, 0.9, 0.25, 1.15);
  }

  .sgf-g:hover .sgf-up {
    transform: translate(5px, -1.5px);
  }

  .sgf-g:hover .sgf-dn {
    transform: translate(-5px, 1.5px);
  }

  .sgf-sh polygon {
    transition: none;
  }

  /* ── Narrower footers ────────────────────────────────────────────────── */
  @container (max-width: 760px) {
    .sgf-top {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    }

    .sgf-top > :first-child,
    .sgf-top > .sgf-copy {
      grid-column: 1 / -1;
    }

    .sgf-copy {
      order: 3;
    }

    .sgf-form {
      max-width: 360px;
    }
  }

  /* One column a little earlier than the source design (460px, not 420px),
     so the email address always has room on one line. */
  @container (max-width: 460px) {
    .sgf-top {
      grid-template-columns: minmax(0, 1fr);
    }

    /* The page links are short, so they pair up and take half the rows. */
    .sgf-list--pair {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: 24px;
    }
  }

  /* Phone: print a size larger (11px capitals are hard work on a small
     screen), and line the block up with the page's own 20px margin. */
  @media (max-width: 639.98px) {
    .sgf {
      font-size: 13px;
      line-height: 1.3;
    }

    .sgf-top {
      row-gap: 28px;
      padding-top: 56px;
      padding-inline: 1.25rem;
    }

    .sgf-mark {
      padding-inline: 1.25rem;
    }

    .sgf-form {
      max-width: none;
    }

    .sgf-lede {
      max-width: 30ch;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .sgf .sgf-rise,
    .sgf .sgf-fade,
    .sgf .sgf-half,
    .sgf .sgf-link svg,
    .sgf .sgf-link::after,
    .sgf .sgf-field::after,
    .sgf .sgf-go svg {
      transition: none !important;
    }

    .sgf .sgf-field,
    .sgf .sgf-flip {
      animation: none !important;
    }

    .sgf[data-in="false"] .sgf-rise {
      transform: none;
    }

    .sgf[data-in="false"] .sgf-fade {
      opacity: 1;
      translate: none;
    }
  }
</style>

<script>
  // What moves in the footer: the shutter follows the pointer and turns when
  // clicked, letters flip when clicked, links scramble on hover, and the
  // message box checks itself before opening WhatsApp.
  import { approach, blades, clamp, f, restPivot, scramble } from "@/lib/footer/shutter";

  document.querySelectorAll<HTMLElement>("[data-sgf]").forEach((root) => {
    const reduce = window.matchMedia("(prefers-reduced-motion: reduce)");
    const still = () => reduce.matches;

    // ── Links: scramble through noise glyphs, then settle ───────────────
    root.querySelectorAll<HTMLAnchorElement>(".sgf-link").forEach((link) => {
      const label = link.querySelector<HTMLElement>("[data-label]");
      if (!label) return;
      const text = label.textContent ?? "";
      let frame = 0;

      const run = () => {
        if (still()) return;
        cancelAnimationFrame(frame);
        const t0 = performance.now();
        const seed = Math.random() * 100;
        let n = 0;
        const step = (now: number) => {
          const progress = (now - t0) / 420;
          if (progress >= 1) {
            label.textContent = text;
            return;
          }
          // A new noise glyph every other frame reads as typing, not static.
          if (n++ % 2 === 0) {
            label.textContent = scramble(text, progress, seed + Math.floor(n / 2));
          }
          frame = requestAnimationFrame(step);
        };
        frame = requestAnimationFrame(step);
      };

      link.addEventListener("pointerenter", run);
      link.addEventListener("focus", run);
    });

    // ── Letters: click to flip ──────────────────────────────────────────
    root.querySelectorAll<SVGGElement>(".sgf-flip").forEach((letter) => {
      letter.addEventListener("click", () => {
        if (still()) return;
        letter.classList.remove("is-flip");
        void letter.getBoundingClientRect();
        letter.classList.add("is-flip");
      });
      letter.addEventListener("animationend", () => letter.classList.remove("is-flip"));
    });

    // ── The shutter ─────────────────────────────────────────────────────
    const svg = root.querySelector<SVGSVGElement>(".sgf-svg");
    const shutter = root.querySelector<SVGGElement>("[data-shutter]");

    if (svg && shutter) {
      const polygons = [...shutter.querySelectorAll("polygon")];
      const width = Number(svg.dataset.width) || 1;
      const offset = Number(shutter.dataset.x) || 0;
      const pointer = { x: 0, y: 0, inside: false };
      let turns = 0;
      let pivot = restPivot(0);
      let visible = false;
      let frame = 0;
      let last = 0;
      let drawn = "";

      // The blades are written straight to the polygons, and only when the
      // pivot has actually moved.
      const paint = (x: number, y: number) => {
        const key = `${f(x)} ${f(y)} ${turns}`;
        if (key === drawn) return;
        drawn = key;
        blades(x, y, turns).forEach((points, i) => {
          polygons[i]?.setAttribute("points", points.map(f).join(" "));
        });
      };

      const tick = (now: number) => {
        const dt = Math.min(0.1, (now - last) / 1000);
        last = now;
        const rest = restPivot(turns);
        const tx = pointer.inside ? clamp(pointer.x, 8, 92) : rest[0];
        const ty = pointer.inside ? clamp(pointer.y, 8, 92) : rest[1];
        pivot = [approach(pivot[0], tx, 0.12, dt), approach(pivot[1], ty, 0.12, dt)];
        paint(pivot[0], pivot[1]);
        frame = requestAnimationFrame(tick);
      };

      // The pivot eases toward the pointer while the footer is on screen;
      // otherwise it sits at rest and nothing runs.
      const start = () => {
        cancelAnimationFrame(frame);
        if (still() || !visible) {
          pivot = restPivot(turns);
          paint(pivot[0], pivot[1]);
          return;
        }
        last = performance.now();
        frame = requestAnimationFrame(tick);
      };

      const onPointer = (event: PointerEvent) => {
        pointer.inside = event.type !== "pointerleave";
        // The pointer in the shutter's own units, from the SVG's on-screen box.
        const box = svg.getBoundingClientRect();
        const scale = box.width / width || 1;
        pointer.x = (event.clientX - box.left) / scale - offset;
        pointer.y = (event.clientY - box.top) / scale;
      };

      root.addEventListener("pointermove", onPointer);
      root.addEventListener("pointerenter", onPointer);
      root.addEventListener("pointerleave", onPointer);

      // Click the shutter and its blades rotate a quarter turn.
      shutter.addEventListener("click", () => {
        turns += 1;
        start();
      });

      new IntersectionObserver(
        ([entry]) => {
          visible = entry.isIntersecting;
          start();
        },
        { threshold: 0.1 },
      ).observe(root);

      reduce.addEventListener("change", start);
    }

    // ── The message box ─────────────────────────────────────────────────
    const form = root.querySelector<HTMLFormElement>(".sgf-form");
    const field = form?.querySelector<HTMLElement>(".sgf-field");
    const input = form?.querySelector<HTMLInputElement>(".sgf-input");
    const go = form?.querySelector<HTMLButtonElement>(".sgf-go");
    const done = form?.querySelector<HTMLElement>(".sgf-done");
    const message = form?.querySelector<HTMLElement>(".sgf-msg");

    if (form && field && input && go && done && message) {
      const show = (state: "idle" | "error" | "done") => {
        field.dataset.state = state;
        input.hidden = go.hidden = state === "done";
        done.hidden = state !== "done";
        message.textContent = state === "error" ? (form.dataset.empty ?? "") : "";
        if (state === "error") input.setAttribute("aria-invalid", "true");
        else input.removeAttribute("aria-invalid");
      };

      form.addEventListener("submit", (event) => {
        event.preventDefault();
        const text = input.value.trim();

        if (!text) {
          show("error");
          // Restart the shake so a second empty try shakes again.
          field.style.animation = "none";
          void field.offsetWidth;
          field.style.animation = "";
          input.focus();
          return;
        }

        window.open(`${form.action}?text=${encodeURIComponent(text)}`, "_blank", "noopener");
        show("done");
      });

      input.addEventListener("input", () => {
        if (field.dataset.state === "error") show("idle");
      });

      done.querySelector("button")?.addEventListener("click", () => {
        input.value = "";
        show("idle");
        input.focus();
      });
    }
  });
</script>
