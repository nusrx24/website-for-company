---
import Social from "@/components/Social.astro";
import config from "@/config/config.json";
import menu from "@/config/menu.json";
import social from "@/config/social.json";
import { markdownify } from "@/lib/utils/textConverter";
import { whatsappUrl } from "@/lib/utils/contact";
import type { Menu, SocialType } from "@/types";

const whatsappLink = whatsappUrl();

// No legal column: the template's privacy and terms pages were Lorem Ipsum and
// have been removed. Add real ones before publishing anything that collects
// personal data, then restore the column here.
const {
  footer_primary,
  footer_resource,
  footer_col_1_title,
  footer_col_2_title,
} = menu as Menu;
const { main: socialLinks } = social as SocialType;
---

<footer class="section pb-0 relative overflow-hidden">
  <div class="container pb-10">
    <div class="grid gap-x-10 gap-y-10 sm:grid-cols-2 lg:grid-cols-[1fr_auto_auto] lg:justify-between">
      <!-- Column 1 - Logo & Contact -->
      <div class="sm:col-span-2 lg:col-span-1 max-w-xs text-lg text-text">
        <img
          src={config.site.logo}
          width={170}
          height={44}
          class="h-11 w-auto"
          alt={config.site.title}
          decoding="async"
        />
        <p class="mt-6">{config.params.footer_tagline}</p>
        <a
          class="link mt-6 inline-block py-1 underline"
          href={`mailto:${config.params.footer_email}`}
          >{config.params.footer_email}</a
        >
        <a
          class="link mt-4 inline-block py-1"
          href={`tel:+${config.params.whatsapp_number}`}
          >{config.params.footer_phone}</a
        >
        <a
          class="link mt-4 inline-flex items-center gap-2 py-1 text-primary hover:text-primary-light transition-colors"
          href={whatsappLink}
          target="_blank"
          rel="noopener noreferrer"
        >
          Chat on WhatsApp &rarr;
        </a>
      </div>
      <!-- Column 2 - Primary -->
      <div>
        <h3 class="footer-label">{footer_col_1_title}</h3>
        <ul>
          {
            footer_primary?.map((item) => (
              <li class="mb-5">
                <a href={item.url} class="footer-link">
                  {item.name}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
      <!-- Column 3 - Resource -->
      <div>
        <h3 class="footer-label">{footer_col_2_title}</h3>
        <ul>
          {
            footer_resource?.map((item) => (
              <li class="mb-5">
                <a href={item.url} class="footer-link">
                  {item.name}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>
  <!-- Bottom Area -->
  <hr
    class="h-px bg-linear-to-r from-transparent from-25% via-white/50 to-75% to-transparent border-0"
  />
  <div class="container py-7">
    <div
      class="flex justify-between lg:items-center flex-col lg:flex-row gap-y-6 w-full"
    >
      <p
        class="text-base text-text"
        set:html={markdownify(config.params.copyright)}
      />

      <Social className="social-icons lg:ml-auto" source={socialLinks} />
    </div>
  </div>

  <div
    class="absolute bottom-0 left-1/2 size-280 blur-2xl -translate-x-1/2 translate-y-1/2 -z-10"
    style="background: radial-gradient(circle, color-mix(in srgb, var(--color-primary) 30%, transparent) 0%, transparent 80%);"
  >
  </div>
</footer>
