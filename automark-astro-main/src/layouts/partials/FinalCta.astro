---
import { whatsappUrl } from "@/lib/utils/contact";
import { markdownify } from "@/lib/utils/textConverter";
import type { Homepage } from "@/types";

export interface Props {
  cta: Homepage["final_cta"];
}

const { cta } = Astro.props as Props;

// The button is optional: leave `button` out of the content and the section
// is a headline and a sentence. When it is there, content says `whatsapp` so
// the number stays in config.json only; anything else is a plain href.
const { button } = cta;
const isWhatsapp = button?.link === "whatsapp";
const href = button && (isWhatsapp ? whatsappUrl() : button.link);
---

{/* The closing statement: a headline and one sentence. The ways to reach us
    (Facebook, LinkedIn, WhatsApp, email, the phone number) and the locations
    are in the footer directly below. */}
<section id="contact" class="section cta">
  <div class="wrap">
    <h2 data-breathe set:html={markdownify(cta.title)} />
    <p>{cta.content}</p>
    {
      button && (
        <a
          class="btn btn-shiny"
          href={href}
          target={isWhatsapp ? "_blank" : null}
          rel={isWhatsapp ? "noopener noreferrer" : null}
          data-page-cta
        >
          <span>{button.label}</span>
        </a>
      )
    }
  </div>
</section>

<style>
  /* 32px on a phone, growing with the screen from there. On the narrowest
     phones (under 360px) it drops to 30px, so a long last line still fits
     instead of leaving its final word on a line of its own. */
  .cta h2 {
    max-width: 22ch;
    font-size: clamp(1.875rem, max(5.2vw, min(8.9vw, 2rem)), 4rem);
    line-height: 1.08;
  }

  .cta p {
    max-width: 52ch;
    margin-top: clamp(1.5rem, 3vw, 2rem);
    color: var(--color-text-light);
    font-size: clamp(1.0625rem, 1.4vw, 1.1875rem);
    line-height: 1.6;
  }

  /* Only when the content has a button. */
  .cta .btn {
    margin-top: clamp(2rem, 3.5vw, 2.5rem);
  }

  /* Phone: the button runs the full width, as in the hero. */
  @media (max-width: 479.98px) {
    .cta .btn {
      width: 100%;
    }
  }
</style>
