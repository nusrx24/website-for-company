---
import { contact, mailtoUrl, telUrl, whatsappUrl } from "@/lib/utils/contact";
import { markdownify } from "@/lib/utils/textConverter";
import type { Homepage } from "@/types";
import { LiquidMetalButton } from "@/components/ui/liquid-metal-button";

export interface Props {
  cta: Homepage["final_cta"];
}

const { cta } = Astro.props as Props;

// Content says `whatsapp` / `email` so the number and address stay in
// config.json only. Anything else is treated as a plain href.
const resolve = (link: string) => {
  if (link === "whatsapp") return whatsappUrl();
  if (link === "email") return mailtoUrl("Software enquiry");
  return link;
};

const isExternal = (link: string) => link === "whatsapp";
---

<section id="contact" class="section scroll-mt-24 pb-4 lg:pb-8">
  <div class="container">
    <div
      class="relative overflow-hidden rounded-2xl border border-primary/30 bg-light p-8 text-center lg:p-16 shine-border"
    >
      {/* The page's one deliberate flourish, kept behind the content and well
          under the accent's 10% share. */}
      <div
        class="pointer-events-none absolute -top-40 left-1/2 -z-10 size-[560px] -translate-x-1/2 rounded-full opacity-[0.14] blur-[120px]"
        style="background: radial-gradient(circle, var(--color-primary) 0%, transparent 70%);"
        aria-hidden="true"
      >
      </div>

      <h2
        class="text-h3 lg:text-h2 mx-auto mb-5 max-w-3xl leading-[1.1] uppercase hasHighlight"
        set:html={markdownify(cta.title)}
      />
      <p class="mx-auto mb-9 max-w-2xl text-base leading-[1.75] text-text">
        {cta.content}
      </p>

      <div class="flex flex-wrap items-center justify-center gap-4">
        <LiquidMetalButton
          client:visible
          label={cta.button_primary.label}
          href={resolve(cta.button_primary.link)}
        />
        <a
          class="btn btn-outline"
          href={resolve(cta.button_secondary.link)}
          target={isExternal(cta.button_secondary.link) ? "_blank" : null}
          rel="noopener noreferrer"
        >
          {cta.button_secondary.label}
        </a>
      </div>

      {/* The details in plain sight, so nobody has to open a form to reach us. */}
      <div
        class="mt-10 flex flex-wrap items-center justify-center gap-x-8 gap-y-3 border-t border-border pt-8 font-primary text-[13px]"
      >
        <a
          class="inline-block py-1 text-text-light transition-colors hover:text-primary"
          href={telUrl}
        >
          {contact.phoneDisplay}
        </a>
        <a
          class="inline-block py-1 text-text-light transition-colors hover:text-primary"
          href={mailtoUrl("Software enquiry")}
        >
          {contact.email}
        </a>
      </div>
    </div>
  </div>
</section>
