---
import { markdownify } from "@/lib/utils/textConverter";
import type { Homepage } from "@/types";
import AnimatedTestimonials from "@/components/ui/animated-testimonials";
import TextLoop from "@/components/ui/text-loop";
import LocationMap from "@/components/ui/location-map";

export interface Props {
  company: Homepage["company"];
  locations: Homepage["locations"];
}

const { company, locations } = Astro.props as Props;
---

{/* Company and locations share one section: they answer the same question -
    who you would actually be dealing with, and where they are. */}
<section id="company" class="section scroll-mt-24">
  <div class="container">
    <div class="grid gap-12 lg:grid-cols-12 lg:gap-12 xl:gap-16 items-start">
      <div class="lg:col-span-7 relative z-10">
        {
          company.eyebrow && (
            <p class="mb-4 font-primary text-xs font-semibold tracking-[0.18em] text-primary uppercase">
              {company.eyebrow}
            </p>
          )
        }
        <div class="mb-5">
          <TextLoop
            client:visible
            staticText="We make business software"
            rotatingTexts={["simpler.", "reliable.", "yours for life.", "built for you."]}
            className="text-2xl sm:text-3xl md:text-4xl lg:text-[2.25rem] xl:text-[2.75rem] font-secondary font-bold uppercase leading-[1.15] tracking-tight flex-col items-start sm:flex-row sm:items-center sm:flex-wrap"
            staticTextClassName="text-white mr-0 sm:mr-3 whitespace-normal break-words max-w-full"
            rotatingTextClassName="text-primary pr-1 font-secondary font-bold uppercase drop-shadow-[0_0_14px_rgba(46,144,255,0.45)]"
            cursorClassName="bg-primary shadow-[0_0_10px_rgba(46,144,255,0.8)]"
            backgroundClassName="bg-gradient-to-r from-transparent via-primary/15 to-primary/25 rounded"
            interval={2800}
          />
        </div>
        <p class="max-w-2xl text-base leading-[1.75] text-text">
          {company.content}
        </p>
      </div>

      <div class="lg:col-span-5 flex flex-col items-center lg:items-end">
        {
          company.team_label && (
            <div class="w-full max-w-[17rem] sm:max-w-[19rem] lg:ml-auto">
              <p class="mb-5 font-primary text-[11px] tracking-[0.16em] text-text-dark uppercase">
                {company.team_label}
              </p>
            </div>
          )
        }
        <AnimatedTestimonials client:visible testimonials={company.team} />
      </div>
    </div>

    {
      locations.enable && (
        <div class="mt-14 border-t border-border/80 pt-12 lg:mt-20">
          <div class="grid gap-10 lg:grid-cols-12 lg:gap-14 items-center">
            <div class="lg:col-span-7">
              <p class="mb-3 font-primary text-xs font-semibold tracking-[0.18em] text-sky-400 uppercase">
                {locations.eyebrow || "Where we work"}
              </p>
              <h3
                class="text-lg sm:text-xl lg:text-h5 mb-4 leading-[1.2] uppercase hasHighlight break-words"
                set:html={markdownify(locations.title)}
              />
              {locations.content && (
                <p class="max-w-xl text-base leading-[1.75] text-text mb-6">
                  {locations.content}
                </p>
              )}

              {locations.languages.length > 0 && (
                <div class="flex items-center gap-2.5 text-xs font-primary text-text-dark bg-light/50 border border-white/5 rounded-full px-4 py-2 w-fit backdrop-blur-sm">
                  <span class="size-2 rounded-full bg-sky-400 shadow-[0_0_8px_rgba(56,189,248,0.9)] animate-pulse" />
                  <span>We work in <strong class="text-white font-medium">{locations.languages.join(", ")}</strong></span>
                </div>
              )}
            </div>

            <div class="lg:col-span-5 flex justify-center lg:justify-end w-full max-w-full">
              <LocationMap
                client:visible
                location="Eravur, Sri Lanka"
                coordinates="7.7767° N, 81.6033° E"
                pinColor="#38BDF8"
              />
            </div>
          </div>
        </div>
      )
    }
  </div>
</section>
