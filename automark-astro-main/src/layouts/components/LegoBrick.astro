---
export interface Props {
  // Colourway: see the theme classes at the bottom of this file.
  color: "blue" | "teal" | "fuchsia" | "grey" | "red" | "green" | "yellow";
  // How many studs wide the brick is. The parent sets the pixel width.
  studs: number;
}

const { color, studs } = Astro.props as Props;
---

{/* One toy brick: a row of studs, a top plate, a face that holds the
    content, and a bottom lip. Built from spans so it can sit inside a
    button. The face has a soft highlight that follows the pointer (--mx and
    --my, set by the builder's script). */}
<span class={`brick brick--${color}`}>
  <span class="brick__top">
    <span class="brick__studs" aria-hidden="true">
      {
        Array.from({ length: studs }).map(() => (
          <span class="stud">
            <span class="stud__shadow" />
            <span class="stud__body">
              <span class="stud__wall" />
              <span class="stud__cap">
                <span class="stud__mark">LC</span>
              </span>
            </span>
          </span>
        ))
      }
    </span>
  </span>
  <span class="brick__face">
    <span class="brick__glow"></span>
    <span class="brick__content"><slot /></span>
  </span>
  <span class="brick__bottom"></span>
</span>

<style>
  .brick {
    position: relative;
    display: block;
    width: 100%;
  }

  /* ── Top plate and studs ────────────────────────────────────────────── */
  .brick__top {
    position: relative;
    display: block;
    height: 19px;
    border-radius: 4px 4px 0 0;
    background: var(--brick-top);
    box-shadow: inset 0 0 4px rgb(0 0 0 / 0.28);
  }

  .brick__studs {
    position: absolute;
    bottom: 100%;
    left: 0;
    display: flex;
    width: 100%;
  }

  .stud {
    position: relative;
    display: flex;
    flex: 1;
    align-items: flex-end;
    justify-content: center;
    transform: translateY(12px);
  }

  /* A stud that has a brick sitting on it. */
  .stud.is-hidden {
    visibility: hidden;
  }

  .stud__shadow {
    position: absolute;
    bottom: -3px;
    left: 50%;
    width: 75%;
    height: 10px;
    border-radius: 50%;
    background: var(--stud-shadow);
    transform: translateX(-50%);
  }

  .stud__body {
    position: relative;
    z-index: 1;
    display: block;
    width: 72%;
    max-width: 42px;
    margin-bottom: -1px;
  }

  .stud__wall {
    position: relative;
    display: block;
    overflow: hidden;
    width: 100%;
    height: 16px;
    border-radius: 50% / 20%;
    background: var(--stud-wall);
  }

  .stud__wall::after {
    content: "";
    position: absolute;
    top: 0;
    left: 20%;
    width: 25%;
    height: 100%;
    background: linear-gradient(to right, transparent, rgb(255 255 255 / 0.25), transparent);
  }

  .stud__cap {
    position: absolute;
    top: -8px;
    left: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    width: 100%;
    height: 16px;
    border-top: 1px solid var(--stud-rim);
    border-radius: 50%;
    background: var(--stud-cap);
    box-shadow:
      inset 0 2px 4px rgb(255 255 255 / 0.6),
      inset 0 -2px 4px rgb(0 0 0 / 0.2),
      0 1px 1px rgb(0 0 0 / 0.4);
  }

  /* Embossed lettering on each stud, as on the real thing. */
  .stud__mark {
    color: rgb(0 0 0 / 0.15);
    font-family: var(--font-secondary);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.1em;
    line-height: 1;
    opacity: 0.8;
    text-shadow: 0 1px 0 rgb(255 255 255 / 0.6);
    transform: scaleY(0.55) translateY(-1px);
    user-select: none;
  }

  /* ── Face ───────────────────────────────────────────────────────────── */
  .brick__face {
    position: relative;
    display: block;
    overflow: hidden;
    border-inline: 1px solid rgb(0 0 0 / 0.05);
    background: var(--brick-face);
    box-shadow: inset 0 2px 6px rgb(255 255 255 / 0.47);
  }

  .brick__glow {
    position: absolute;
    inset: 0;
    z-index: 2;
    pointer-events: none;
    opacity: 0.6;
    background: radial-gradient(
      circle 120px at var(--mx, 50%) var(--my, 50%),
      rgb(255 255 255 / 0.25),
      transparent
    );
  }

  .brick__content {
    position: relative;
    z-index: 3;
    display: block;
  }

  .brick__bottom {
    display: block;
    height: 15px;
    border-radius: 0 0 4px 4px;
    background: var(--brick-bottom);
    box-shadow: inset 0 2px 4px rgb(0 0 0 / 0.15);
  }

  /* ── Colourways ─────────────────────────────────────────────────────────
     To recolour a brick, change the values in its block. --brick-chip is the
     small square behind the step number. */
  .brick--blue {
    --brick-top: #38bdf8;
    --brick-face: linear-gradient(180deg, #0ea5e9 0%, #0284c7 50%, #0369a1 100%);
    --brick-bottom: #075985;
    --brick-chip: rgb(0 0 0 / 0.2);
    --stud-wall: linear-gradient(90deg, #1e3a8a 0%, #1d4ed8 20%, #2563eb 38%, #3b82f6 50%, #2563eb 62%, #1d4ed8 80%, #1e3a8a 100%);
    --stud-cap: linear-gradient(135deg, #93c5fd 0%, #60a5fa 40%, #3b82f6 70%, #2563eb 100%);
    --stud-shadow: radial-gradient(ellipse, rgb(0 0 80 / 0.6) 0%, transparent 70%);
    --stud-rim: rgb(255 255 255 / 0.7);
  }

  .brick--teal {
    --brick-top: #2dd4bf;
    --brick-face: linear-gradient(180deg, #14b8a6 0%, #0d9488 50%, #0f766e 100%);
    --brick-bottom: #115e59;
    --brick-chip: rgb(0 0 0 / 0.2);
    --stud-wall: linear-gradient(90deg, #087028 0%, #10923b 20%, #1ab84d 38%, #20cc55 50%, #1ab84d 62%, #10923b 80%, #087028 100%);
    --stud-cap: linear-gradient(135deg, #42f585 0%, #25dd62 40%, #18c04e 70%, #10a040 100%);
    --stud-shadow: radial-gradient(ellipse, rgb(0 40 0 / 0.6) 0%, transparent 70%);
    --stud-rim: rgb(255 255 255 / 0.7);
  }

  .brick--fuchsia {
    --brick-top: #d946ef;
    --brick-face: linear-gradient(180deg, #c026d3 0%, #a21caf 50%, #86198f 100%);
    --brick-bottom: #701a75;
    --brick-chip: rgb(255 255 255 / 0.1);
    --stud-wall: linear-gradient(90deg, #7f1d1d 0%, #b91c1c 20%, #dc2626 38%, #ef4444 50%, #dc2626 62%, #b91c1c 80%, #7f1d1d 100%);
    --stud-cap: linear-gradient(135deg, #fca5a5 0%, #f87171 40%, #ef4444 70%, #dc2626 100%);
    --stud-shadow: radial-gradient(ellipse, rgb(80 0 0 / 0.6) 0%, transparent 70%);
    --stud-rim: rgb(255 255 255 / 0.7);
  }

  /* The source design pairs this brick with near-black studs, which vanish
     on a black page; these are a mid grey instead. */
  .brick--grey {
    --brick-top: #9ca3af;
    --brick-face: linear-gradient(180deg, #6b7280 0%, #4b5563 50%, #374151 100%);
    --brick-bottom: #1f2937;
    --brick-chip: rgb(255 255 255 / 0.1);
    --stud-wall: linear-gradient(90deg, #1f2937 0%, #374151 20%, #4b5563 38%, #6b7280 50%, #4b5563 62%, #374151 80%, #1f2937 100%);
    --stud-cap: linear-gradient(135deg, #e5e7eb 0%, #9ca3af 40%, #6b7280 70%, #4b5563 100%);
    --stud-shadow: radial-gradient(ellipse, rgb(0 0 0 / 0.7) 0%, transparent 70%);
    --stud-rim: rgb(255 255 255 / 0.5);
  }

  .brick--red {
    --brick-top: #f87171;
    --brick-face: linear-gradient(180deg, #ef4444 0%, #dc2626 50%, #b91c1c 100%);
    --brick-bottom: #991b1b;
    --brick-chip: rgb(0 0 0 / 0.2);
    --stud-wall: linear-gradient(90deg, #7f1d1d 0%, #b91c1c 20%, #dc2626 38%, #ef4444 50%, #dc2626 62%, #b91c1c 80%, #7f1d1d 100%);
    --stud-cap: linear-gradient(135deg, #fca5a5 0%, #f87171 40%, #ef4444 70%, #dc2626 100%);
    --stud-shadow: radial-gradient(ellipse, rgb(80 0 0 / 0.6) 0%, transparent 70%);
    --stud-rim: rgb(255 255 255 / 0.7);
  }

  .brick--green {
    --brick-top: #4ade80;
    --brick-face: linear-gradient(180deg, #22c55e 0%, #16a34a 50%, #15803d 100%);
    --brick-bottom: #166534;
    --brick-chip: rgb(0 0 0 / 0.2);
    --stud-wall: linear-gradient(90deg, #087028 0%, #10923b 20%, #1ab84d 38%, #20cc55 50%, #1ab84d 62%, #10923b 80%, #087028 100%);
    --stud-cap: linear-gradient(135deg, #42f585 0%, #25dd62 40%, #18c04e 70%, #10a040 100%);
    --stud-shadow: radial-gradient(ellipse, rgb(0 40 0 / 0.6) 0%, transparent 70%);
    --stud-rim: rgb(255 255 255 / 0.7);
  }

  .brick--yellow {
    --brick-top: #eab308;
    --brick-face: linear-gradient(180deg, #facc15 0%, #eab308 50%, #ca8a04 100%);
    --brick-bottom: #a16207;
    --brick-chip: rgb(0 0 0 / 0.2);
    --stud-wall: linear-gradient(90deg, #a16207 0%, #ca8a04 20%, #eab308 38%, #facc15 50%, #eab308 62%, #ca8a04 80%, #a16207 100%);
    --stud-cap: linear-gradient(135deg, #fef08a 0%, #fde047 40%, #eab308 70%, #ca8a04 100%);
    --stud-shadow: radial-gradient(ellipse, rgb(80 50 0 / 0.6) 0%, transparent 70%);
    --stud-rim: rgb(255 255 255 / 0.7);
  }
</style>
