---
import config from "@/config/config.json";
import ImageMod from "./ImageMod.astro";

const { src }: { src?: string } = Astro.props;
const {
  logo,
  logo_width,
  logo_height,
  logo_text,
  title,
}: {
  logo: string;
  logo_width: any;
  logo_height: any;
  logo_text: string;
  title: string;
} = config.site;

const source = src ? src : logo;
const width = Number(String(logo_width).replace("px", ""));
const height = Number(String(logo_height).replace("px", ""));
// SVG logos are served as-is: running them through the image pipeline would
// rasterise them and lose the sharpness that made us vectorise in the first place.
const isVector = source?.toLowerCase().endsWith(".svg");
---

<a href="/" class="navbar-brand inline-block" aria-label={`${title} - home`}>
  {
    source ? (
      isVector ? (
        <img
          src={source}
          width={width}
          height={height}
          alt={title}
          class="inline-block"
          style={`width:${width}px;height:${height}px`}
          decoding="async"
        />
      ) : (
        <ImageMod
          src={source}
          class="inline-block"
          width={width * 2}
          height={height * 2}
          alt={title}
          style={{ height: `${height}px`, width: `${width}px` }}
          format="webp"
        />
      )
    ) : logo_text ? (
      logo_text
    ) : (
      title
    )
  }
</a>
