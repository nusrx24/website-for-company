---
// Social links as round icon buttons.
//
// A port of the 21st.dev "social-media" (SocialTooltip) React component to
// plain Astro, so the page keeps shipping no UI framework. Same sizes and
// timings: a 48px circle with a 28px icon; pointing at it fills the circle
// from the bottom up in that network's colour over 0.3s, turns the icon
// white, and shows the network's name on a small label that settles under
// the circle.
//
// Three things differ. The icons are drawn in the page (the source loads
// each as a picture from another site, which cannot change colour); the
// circle rests on the site's near-black instead of the page background, so
// it can be seen on the footer; and the link can be reached with the
// keyboard, where it behaves as if pointed at.
import config from "@/config/config.json";
import social from "@/config/social.json";
import { mailtoUrl, whatsappUrl } from "@/lib/utils/contact";
import type { SocialType } from "@/types";

export interface Props {
  class?: string;
}

const { class: className } = Astro.props as Props;

// One entry per network.
//   fill  - what the circle fills with, and the colour of the name label:
//           the network's own colour; for email, which has none, the site's.
//   label - the colour of the lettering on the name label. White by default;
//           dark where white would be hard to read on a bright colour.
//   shapes - the mark, drawn on a 24x24 grid and coloured by the link.
type Icon = { fill: string; label?: string; shapes: string };

const ICONS: Record<string, Icon> = {
  Facebook: {
    fill: "#1877F2",
    shapes:
      '<path fill="currentColor" d="M13.5 22v-8.5h2.9l.6-3.5h-3.5V7.9c0-1 .5-1.9 2-1.9H17V3.1s-1.3-.2-2.6-.2c-2.8 0-4.6 1.7-4.6 4.7V10H7v3.5h2.8V22z"/>',
  },
  LinkedIn: {
    fill: "#0A66C2",
    shapes:
      '<g fill="currentColor"><circle cx="5" cy="5.2" r="2.2"/><rect x="3.1" y="9" width="3.8" height="12"/><path d="M9.6 9h3.6v1.7c.6-1.1 2-2 3.9-2 3.6 0 4.4 2.3 4.4 5.4V21h-3.8v-6.1c0-1.5 0-3.2-1.9-3.2s-2.3 1.4-2.3 3.1V21H9.6z"/></g>',
  },
  WhatsApp: {
    fill: "#25D366",
    label: "#04140A",
    shapes:
      '<path fill="currentColor" d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413Z"/>',
  },
  Email: {
    fill: "var(--color-primary)",
    label: "#05070A",
    shapes:
      '<g fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2.5" y="4.5" width="19" height="15" rx="2.5"/><path d="m3.2 7.2 8.8 6 8.8-6"/></g>',
  },
};

const profile = (name: string) =>
  (social as SocialType).main.find((item) => item.name === name)?.link;

const links = [
  { name: "Facebook", href: profile("Facebook") },
  { name: "LinkedIn", href: profile("LinkedIn") },
  { name: "WhatsApp", href: whatsappUrl() },
  { name: "Email", href: mailtoUrl("Software enquiry") },
].filter((link): link is { name: string; href: string } => Boolean(link.href && ICONS[link.name]));

const external = (href: string) =>
  /^https?:/.test(href) ? { target: "_blank", rel: "noopener noreferrer" } : {};
---

<ul class:list={["social", className]} aria-label={`${config.site.title} on social media`}>
  {
    links.map((link) => {
      const icon = ICONS[link.name];
      return (
        <li
          class="social__item"
          style={`--social-fill:${icon.fill};--social-label:${icon.label ?? "#fff"}`}
        >
          <a
            id={`social-${link.name.toLowerCase()}`}
            class="social__link"
            href={link.href}
            aria-label={link.name}
            {...external(link.href)}
          >
            <span class="social__fill" aria-hidden="true" />
            <svg class="social__icon" viewBox="0 0 24 24" aria-hidden="true" set:html={icon.shapes} />
          </a>
          <span class="social__tip" aria-hidden="true">{link.name}</span>
        </li>
      );
    })
  }
</ul>

<style>
  .social {
    /* The circle at rest, and the icon on it. */
    --social-ground: var(--color-body);
    --social-icon: var(--color-text-light);

    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .social__item {
    position: relative;
  }

  .social__link {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    width: 3rem;
    height: 3rem;
    border-radius: 50%;
    background-color: var(--social-ground);
    color: var(--social-icon);
    text-decoration: none;
    cursor: pointer;
    touch-action: manipulation;
    user-select: none;
    -webkit-user-select: none;
    transform: translateZ(0);
    transition:
      color 0.25s ease-in-out,
      box-shadow 0.25s ease-in-out,
      transform 0.15s ease-in-out;
    -webkit-tap-highlight-color: transparent;
  }

  /* The colour that rises from the bottom of the circle. */
  .social__fill {
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    height: 0;
    background-color: var(--social-fill);
    pointer-events: none;
    transition: height 0.25s ease-in-out;
  }

  .social__icon {
    position: relative;
    z-index: 1;
    display: block;
    width: 1.75rem;
    height: 1.75rem;
    pointer-events: none;
  }

  /* The name, on a label under the circle. It starts 8px below the circle
     and settles 10px lower as it appears. It lets clicks through, so it
     never gets in the way of a link it happens to cover. */
  .social__tip {
    position: absolute;
    top: calc(100% + 8px);
    left: 50%;
    z-index: 2;
    padding: 0.375rem 0.625rem;
    border-radius: 0.375rem;
    background-color: var(--social-fill);
    color: var(--social-label);
    font-family: var(--font-secondary);
    font-size: 0.875rem;
    font-weight: 600;
    line-height: 1.43;
    letter-spacing: normal;
    text-transform: none;
    white-space: nowrap;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transform: translateX(-50%);
    transition:
      opacity 0.3s ease-in-out,
      transform 0.3s ease-in-out,
      visibility 0s linear 0.3s;
  }

  /* ── Pointed at, or reached with the keyboard ─────────────────────────── */
  @media (hover: hover) {
    .social__item:hover .social__link {
      color: #fff;
      box-shadow: 0 10px 22px -8px color-mix(in srgb, var(--social-fill) 75%, transparent);
    }

    .social__item:hover .social__fill {
      height: 100%;
    }

    .social__item:hover .social__tip {
      opacity: 1;
      visibility: visible;
      transform: translate(-50%, 10px);
      transition:
        opacity 0.3s ease-in-out,
        transform 0.3s ease-in-out,
        visibility 0s;
    }
  }

  .social__link:focus-visible {
    color: #fff;
    box-shadow: 0 10px 22px -8px color-mix(in srgb, var(--social-fill) 75%, transparent);
  }

  .social__link:focus-visible .social__fill {
    height: 100%;
  }

  .social__link:focus-visible + .social__tip {
    opacity: 1;
    visibility: visible;
    transform: translate(-50%, 10px);
    transition:
      opacity 0.3s ease-in-out,
      transform 0.3s ease-in-out,
      visibility 0s;
  }

  /* Pressed state (mouse click and mobile touch) */
  .social__link:active {
    color: #fff;
    transform: scale(0.92);
  }

  .social__link:active .social__fill {
    height: 100%;
    transition-duration: 0.1s;
  }
</style>

<script>
  // Ensure instant :active response and clean touch tap navigation on mobile Safari / WebKit
  document.addEventListener("touchstart", () => {}, { passive: true });
</script>
