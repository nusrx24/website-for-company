---
// Social links with a pop-up icon on hover.
//
// A port of the 21st.dev "social-links" React component to plain Astro, so
// the page keeps shipping no UI framework. Same behaviour:
//   - pointing at (or tabbing to) a name fades the others to half strength,
//   - the brand icon rises above the name, un-blurring, at a small random tilt,
//   - a click gives the icon a quick pulse.
// The whole row has no background; each icon sits on a frosted, see-through
// glass tile and its logo is cut out, so the section behind shows through.
import config from "@/config/config.json";
import social from "@/config/social.json";
import { mailtoUrl, whatsappUrl } from "@/lib/utils/contact";
import type { SocialType } from "@/types";

export interface Props {
  class?: string;
}

const { class: className } = Astro.props as Props;

// Brand marks, drawn on a 24x24 grid. Logos are a single filled path with
// their inner shapes cut out (transparent), except email, which is stroked.
const ICONS: Record<string, { color: string; path: string; stroke?: boolean }> = {
  Facebook: {
    color: "#1877F2",
    path: "M9.101 23.691v-7.98H6.627v-3.667h2.474v-1.58c0-4.085 1.848-5.978 5.858-5.978.401 0 .955.042 1.468.103a8.68 8.68 0 0 1 1.141.195v3.325a8.623 8.623 0 0 0-.653-.036 26.805 26.805 0 0 0-.733-.009c-.707 0-1.259.096-1.675.309a1.686 1.686 0 0 0-.679.622c-.258.42-.374.995-.374 1.752v1.297h3.919l-.386 2.103-.287 1.564h-3.246v8.245C19.396 23.238 24 18.179 24 12.044c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.628 3.874 10.35 9.101 11.647Z",
  },
  LinkedIn: {
    color: "#0A66C2",
    path: "M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z",
  },
  WhatsApp: {
    color: "#25D366",
    path: "M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413Z",
  },
  Email: {
    color: "#EA4335",
    path: "M4 4h16a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2zm18 3-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7",
    stroke: true,
  },
};

const profile = (name: string) =>
  (social as SocialType).main.find((item) => item.name === name)?.link;

const links = [
  { name: "Facebook", href: profile("Facebook") },
  { name: "LinkedIn", href: profile("LinkedIn") },
  { name: "WhatsApp", href: whatsappUrl() },
  { name: "Email", href: mailtoUrl("Software enquiry") },
].filter((link): link is { name: string; href: string } => Boolean(link.href));

const external = (href: string) =>
  /^https?:/.test(href) ? { target: "_blank", rel: "noopener noreferrer" } : {};
---

<ul
  class:list={["social-links", className]}
  aria-label={`${config.site.title} on social media`}
  data-social-links
>
  {
    links.map((link) => {
      const icon = ICONS[link.name];
      return (
        <li class="social-links__item">
          <a
            id={`social-${link.name.toLowerCase()}`}
            class="social-links__link"
            href={link.href}
            {...external(link.href)}
          >
            <span class="social-links__name">{link.name}</span>
            {icon && (
              <span class="social-links__pop" aria-hidden="true">
                <span class="social-links__tile">
                  <svg viewBox="0 0 24 24" width="34" height="34">
                    <path
                      d={icon.path}
                      fill={icon.stroke ? "none" : icon.color}
                      stroke={icon.stroke ? icon.color : "none"}
                      stroke-width={icon.stroke ? 2 : undefined}
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    />
                  </svg>
                </span>
              </span>
            )}
          </a>
        </li>
      );
    })
  }
</ul>

<style>
  .social-links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 0;
    margin: 0;
    padding: 0;
    list-style: none;
    /* Fully transparent: whatever is behind the row shows through. */
    background: transparent;
  }

  .social-links__item {
    transition: opacity 0.2s ease-out;
  }

  /* While one name is pointed at, the rest step back. */
  .social-links:has(.social-links__link:hover, .social-links__link:focus-visible)
    .social-links__item:not(:has(.social-links__link:hover, .social-links__link:focus-visible)) {
    opacity: 0.5;
  }

  .social-links__link {
    position: relative;
    display: block;
    padding: 0.5rem 1.25rem;
    color: inherit;
    text-decoration: none;
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
  }

  .social-links__link:focus-visible {
    outline: 1px dashed currentColor;
    outline-offset: 2px;
    border-radius: 6px;
  }

  .social-links__name {
    display: block;
    font-size: 1.125rem;
    font-weight: 500;
  }

  /* The icon rises from just above the name, un-blurring as it comes. */
  .social-links__pop {
    position: absolute;
    left: 50%;
    bottom: 100%;
    display: grid;
    place-items: center;
    pointer-events: none;
    opacity: 0;
    filter: blur(2px);
    transform: translate(-50%, 10px) rotate(var(--rot, 0deg));
    transition:
      opacity 0.2s ease-out,
      filter 0.2s ease-out,
      transform 0.2s ease-out;
  }

  .social-links__link:hover .social-links__pop,
  .social-links__link:focus-visible .social-links__pop {
    opacity: 1;
    filter: blur(0);
    transform: translate(-50%, 0) rotate(var(--rot, 0deg));
  }

  /* Frosted glass: see-through, blurring what's behind it. */
  .social-links__tile {
    display: grid;
    place-items: center;
    width: 4rem;
    height: 4rem;
    border: 1px solid rgb(255 255 255 / 0.22);
    border-radius: 18px;
    background: linear-gradient(
      145deg,
      rgb(255 255 255 / 0.16),
      rgb(255 255 255 / 0.04)
    );
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 0.25),
      0 10px 30px -10px rgb(0 0 0 / 0.6);
    -webkit-backdrop-filter: blur(10px) saturate(140%);
    backdrop-filter: blur(10px) saturate(140%);
  }

  .social-links__tile svg {
    display: block;
    filter: drop-shadow(0 2px 6px rgb(0 0 0 / 0.35));
  }

  /* Click: a quick pulse, like the original's scale [1, 1.3, 1]. */
  .social-links__link.is-pulse .social-links__tile {
    animation: social-pulse 0.3s ease-out;
  }

  @keyframes social-pulse {
    50% {
      transform: scale(1.3);
    }
  }

  /* Phone: every name on one line, spread across the width. They are set a
     size smaller with no padding at the sides, so all four fit on the
     narrowest phone, and taller padding keeps each one a fingertip tall.
     On one line a name's icon pops up into the empty space above the row;
     when the names wrapped onto two lines it covered a name in the line
     above. */
  @media (max-width: 519.98px) {
    .social-links {
      flex-wrap: nowrap;
      justify-content: space-between;
      width: 100%;
      max-width: 26rem;
    }

    .social-links__link {
      min-width: 2.75rem;
      padding: 0.75rem 0;
      text-align: center;
    }

    .social-links__name {
      font-size: clamp(0.8125rem, 3.9vw, 1rem);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .social-links__item,
    .social-links__pop {
      transition: none;
    }

    .social-links__pop {
      filter: none;
    }

    .social-links__link.is-pulse .social-links__tile {
      animation: none;
    }
  }
</style>

<script>
  // A fresh random tilt (-10deg to 10deg) each time a name is pointed at, and
  // a pulse when it is clicked. Everything else is CSS.
  document.querySelectorAll<HTMLElement>("[data-social-links]").forEach((list) => {
    list.querySelectorAll<HTMLAnchorElement>(".social-links__link").forEach((link) => {
      const tilt = () =>
        link.style.setProperty("--rot", `${(Math.random() * 20 - 10).toFixed(1)}deg`);

      link.addEventListener("pointerenter", tilt);
      link.addEventListener("focus", tilt);
      link.addEventListener("click", () => {
        link.classList.remove("is-pulse");
        void link.offsetWidth;
        link.classList.add("is-pulse");
      });
      link.addEventListener("animationend", () => link.classList.remove("is-pulse"));
    });
  });
</script>
