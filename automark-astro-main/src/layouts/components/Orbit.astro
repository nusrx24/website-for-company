---
// Orbits for behind a section: a centre disc with the React mark, and three
// dotted rings turning round it, each carrying round chips with the logos
// of software-development tools and platforms.
//
// A port of the 21st.dev "stack feature section" orbit to plain Astro and
// CSS, with the source's own icons in its own order and colours: React,
// AWS, Docker, Node.js, Next.js, Vercel, Redux, TypeScript, GitHub,
// Twitter, LinkedIn, Instagram, Google, Apple, Facebook, and its two
// pictures (a second React logo and the Among Us crewmate). Its sizes and
// timing too: three rings 20, 28 and 36em across (12em, plus 8em a ring),
// turning once every 12, 18 and 24 seconds; a 6em centre disc; 2.5em chips
// spaced evenly, six to a ring, so the last ring, with five, has a gap.
//
// The page is dark, so the source's dark colours are used (gray-800 discs,
// gray-600 rings). Logos whose colour is black there (Next.js, Vercel,
// GitHub, Apple) would vanish on a dark disc, so they are drawn in white,
// as those companies' own marks for dark backgrounds are.
//
// Three things differ from the source. The icon drawings live in this site
// (src/lib/orbitIcons.ts, public/images/orbit/), so no React and nothing
// fetched from another site. Each logo turns back against its ring, so it
// stays upright as it travels. And the rings stop when scrolled out of
// view, and do not move for anyone who has asked for less motion.
//
// Sizes are in em: the parent sets font-size to scale the whole system
// (16px is the source's size). The root has no size of its own - it is the
// centre point - so the parent places it with top/left/right.
//
// `links` makes a logo a link, e.g. { FaLinkedin: "https://..." }: it opens
// in a new tab, and the rings stop while it is pointed at so it can be
// clicked. It is a shortcut for the mouse and finger only (out of the tab
// order, like the rest of this decoration), so the same address must also
// be a real link elsewhere on the page.
import { BRAND_ICONS } from "@/lib/orbitIcons";

export interface Props {
  links?: Partial<Record<keyof typeof BRAND_ICONS, string>>;
}

const { links = {} } = Astro.props as Props;

type Chip =
  | { icon: keyof typeof BRAND_ICONS; color: string }
  | { img: string };

// The source's list, in the source's order, with its colours.
const CHIPS: Chip[] = [
  { icon: "FaReact", color: "#61DAFB" },
  { icon: "FaAws", color: "#FF9900" },
  { icon: "FaDocker", color: "#2496ED" },
  { icon: "FaNodeJs", color: "#339933" },
  { icon: "SiNextdotjs", color: "#000000" },
  { icon: "SiVercel", color: "#000000" },
  { icon: "SiRedux", color: "#764ABC" },
  { icon: "SiTypescript", color: "#3178C6" },
  { icon: "FaGithub", color: "#181717" },
  { icon: "FaTwitter", color: "#1DA1F2" },
  { icon: "FaLinkedin", color: "#0077B5" },
  { icon: "FaInstagram", color: "#E1306C" },
  { icon: "FaGoogle", color: "#DB4437" },
  { icon: "FaApple", color: "#000000" },
  { icon: "SiFacebook", color: "#1877F2" },
  { img: "/images/orbit/react-logo.svg" },
  { img: "/images/orbit/among-us.svg" },
];

// Black (and GitHub's near-black) is drawn white on the dark discs.
const onDark = (color: string) => (color === "#000000" || color === "#181717" ? "#FFFFFF" : color);

const RINGS = 3;
const perRing = Math.ceil(CHIPS.length / RINGS);
const step = (2 * Math.PI) / perRing;
const pct = (n: number) => +(50 + 50 * n).toFixed(3);

const rings = Array.from({ length: RINGS }, (_, r) => ({
  size: 12 + 8 * (r + 1),
  turn: 12 + r * 6,
  chips: CHIPS.slice(r * perRing, r * perRing + perRing).map((chip, i) => ({
    chip,
    x: pct(Math.cos(i * step)),
    y: pct(Math.sin(i * step)),
  })),
}));

const centre = BRAND_ICONS.FaReact;
---

{/* Decoration only: hidden from assistive tech and never in the way of a
    click. */}
<div class="orbit" data-orbit aria-hidden="true">
  {
    rings.map((ring) => (
      <div class="orbit__ring" style={`--size:${ring.size}em;--turn:${ring.turn}s`}>
        {ring.chips.map(({ chip, x, y }) => {
          const href = "icon" in chip ? links[chip.icon] : undefined;
          const colour = "icon" in chip ? `;color:${onDark(chip.color)}` : "";
          const Tag = href ? "a" : "span";
          return (
            <Tag
              class:list={["orbit__chip", { "orbit__chip--link": href }]}
              style={`left:${x}%;top:${y}%${colour}`}
              {...(href && { href, target: "_blank", rel: "noopener noreferrer", tabindex: "-1" })}
            >
              {"icon" in chip ? (
                <svg
                  viewBox={BRAND_ICONS[chip.icon].viewBox}
                  fill="currentColor"
                  set:html={BRAND_ICONS[chip.icon].svg}
                />
              ) : (
                <img src={chip.img} alt="" width="32" height="32" decoding="async" />
              )}
            </Tag>
          );
        })}
      </div>
    ))
  }
  <span class="orbit__centre">
    <svg viewBox={centre.viewBox} fill="currentColor" set:html={centre.svg} />
  </span>
</div>

<style>
  /* The source's dark colours: gray-600 dotted rings, gray-800 discs, and
     blue-400 for the React mark in the centre. */
  .orbit {
    --orbit-ring: #4b5563;
    --orbit-chip: #1f2937;
    --orbit-centre-icon: #60a5fa;

    position: absolute;
    top: 0;
    left: 0;
    width: 0;
    height: 0;
    pointer-events: none;
  }

  .orbit__ring {
    position: absolute;
    top: 0;
    left: 0;
    width: var(--size);
    height: var(--size);
    margin: calc(var(--size) / -2);
    border: 2px dotted var(--orbit-ring);
    border-radius: 50%;
    animation: orbit-turn var(--turn) linear infinite;
  }

  /* A 2em logo on a disc with 0.25em round it, as in the source. */
  .orbit__chip {
    position: absolute;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.5em;
    height: 2.5em;
    border-radius: 50%;
    background-color: var(--orbit-chip);
    box-shadow:
      0 4px 6px -1px rgb(0 0 0 / 0.1),
      0 2px 4px -2px rgb(0 0 0 / 0.1);
    transform: translate(-50%, -50%);
  }

  /* A logo that is a link takes the pointer (the rest of the system lets
     it through), and lights a ring in its own colour while pointed at. */
  .orbit__chip--link {
    pointer-events: auto;
    cursor: pointer;
    transition:
      box-shadow 0.2s ease,
      background-color 0.2s ease;
  }

  .orbit__chip--link:hover {
    background-color: #273449;
    box-shadow:
      0 0 0 2px currentColor,
      0 4px 6px -1px rgb(0 0 0 / 0.1);
  }

  /* While a linked logo is pointed at, everything holds still under the
     pointer so it can be clicked. */
  .orbit:has(.orbit__chip--link:hover) .orbit__ring,
  .orbit:has(.orbit__chip--link:hover) .orbit__chip > * {
    animation-play-state: paused;
  }

  /* Turning back as fast as the ring turns forward keeps the logo upright. */
  .orbit__chip svg,
  .orbit__chip img {
    width: 2em;
    height: 2em;
    object-fit: contain;
    animation: orbit-turn var(--turn) linear infinite reverse;
  }

  .orbit__centre {
    position: absolute;
    top: 0;
    left: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 6em;
    height: 6em;
    margin: -3em;
    border-radius: 50%;
    background-color: var(--orbit-chip);
    box-shadow:
      0 10px 15px -3px rgb(0 0 0 / 0.1),
      0 4px 6px -4px rgb(0 0 0 / 0.1);
    color: var(--orbit-centre-icon);
  }

  .orbit__centre svg {
    width: 3em;
    height: 3em;
  }

  @keyframes orbit-turn {
    to {
      rotate: 360deg;
    }
  }

  /* Scrolled out of view: stop turning. The script below sets this. */
  .orbit.is-paused .orbit__ring,
  .orbit.is-paused .orbit__chip > * {
    animation-play-state: paused;
  }

  @media (prefers-reduced-motion: reduce) {
    .orbit__ring,
    .orbit__chip svg,
    .orbit__chip img {
      animation: none;
    }
  }
</style>

<script>
  // Twenty turning pieces have a cost, so they only turn while they can be
  // seen.
  if ("IntersectionObserver" in window) {
    document.querySelectorAll<HTMLElement>("[data-orbit]").forEach((el) => {
      const ring = el.querySelector<HTMLElement>(".orbit__ring:last-of-type");
      new IntersectionObserver(([entry]) => {
        el.classList.toggle("is-paused", !entry.isIntersecting);
      }).observe(ring ?? el);
    });
  }
</script>
