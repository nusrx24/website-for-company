---
import config from "@/config/config.json";
import theme from "@/config/theme.json";
import { plainify } from "@/lib/utils/textConverter";
import Footer from "@/partials/Footer.astro";
import Header from "@/partials/Header.astro";
import "@/styles/main.css";
import { Font } from "astro:assets";
import {
  GoogleTagmanager,
  GoogleTagmanagerNoscript,
} from "@digi4care/astro-google-tagmanager";
import SocialLinks from "@/components/ui/social-links";

const fontEntries = Object.entries(theme.fonts.font_family).filter(
  ([key]) => !key.includes("_type"),
);

export interface Props {
  title?: string;
  meta_title?: string;
  description?: string;
  image?: string;
  noindex?: boolean;
  canonical?: string;
}

const { title, meta_title, description, image, noindex, canonical } =
  Astro.props;

// Every absolute URL on the page derives from config.site.base_url, so the
// domain only ever has to be changed in src/config/config.json.
const siteOrigin = config.site.base_url.replace(/\/+$/, "");
const canonicalUrl = canonical ?? new URL(Astro.url.pathname, `${siteOrigin}/`).href;
const socialImage = new URL(
  image ? image : config.metadata.meta_image,
  `${siteOrigin}/`,
).href;
---

<!doctype html>
<html lang="en">
  <head>
    <!-- google tag manager -->
    {
      config.google_tag_manager.enable && (
        <GoogleTagmanager id={config.google_tag_manager.gtm_id} />
      )
    }
    <link rel="icon" href={config.site.favicon} type="image/svg+xml" />
    <link rel="alternate icon" href="/images/favicon-32.png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/images/apple-touch-icon.png" />
    <meta name="msapplication-TileColor" content="#05070A" />
    <meta name="theme-color" content="#05070A" />
    <meta name="generator" content={Astro.generator} />
    <meta http-equiv="Content-Type" content="text/html; charset=UTF-8" />

    {
      fontEntries.map(([key]) => {
        const cssVar = `--font-${key}` as any;
        return <Font cssVariable={cssVar} preload />;
      })
    }

    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, maximum-scale=5"
    />

    <title>
      {plainify(meta_title ? meta_title : title ? title : config.site.title)}
    </title>

    <link rel="canonical" href={canonicalUrl} />
    {noindex && <meta name="robots" content="noindex,nofollow" />}
    <meta
      name="description"
      content={plainify(
        description ? description : config.metadata.meta_description,
      )}
    />

    <!-- View Transitions removed to avoid conflicts with GSAP/Lenis/Swiper -->

    <meta name="author" content={config.metadata.meta_author} />
    <meta
      property="og:title"
      content={plainify(
        meta_title ? meta_title : title ? title : config.site.title,
      )}
    />
    <meta
      property="og:description"
      content={plainify(
        description ? description : config.metadata.meta_description,
      )}
    />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={config.site.title} />
    <meta property="og:url" content={canonicalUrl} />
    <meta
      name="twitter:title"
      content={plainify(
        meta_title ? meta_title : title ? title : config.site.title,
      )}
    />
    <meta
      name="twitter:description"
      content={plainify(
        description ? description : config.metadata.meta_description,
      )}
    />
    <meta property="og:image" content={socialImage} />
    <meta name="twitter:image" content={socialImage} />
    <meta name="twitter:card" content="summary_large_image" />

    <!--
      The global GSAP, ScrollTrigger and Lenis CDN scripts were removed: three
      third-party requests that no longer animated anything. GSAP is still
      bundled, but only inside the Process timeline island (client:visible).
      Anchor scrolling is native CSS, and the hero video controls itself.
    -->
    <script is:inline defer src="/scripts/main.js"></script>
  </head>
  <body>
    {/* google tag manager noscript */}
    {
      config.google_tag_manager.enable && (
        <GoogleTagmanagerNoscript id={config.google_tag_manager.gtm_id} />
      )
    }

    {/* <TwSizeIndicator /> */}
    <Header />
    {/* clip, not hidden or auto: both turn <main> into a scroll container,
        which silently stops every sticky element inside it from pinning. */}
    <main id="main-content" class="overflow-x-hidden supports-[overflow:clip]:overflow-x-clip">

      <slot />
    </main>
    <SocialLinks client:load />
    <Footer />
  </body>
</html>
