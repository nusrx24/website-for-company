---
import Base from "@/layouts/Base.astro";
import { getListPage } from "@/lib/contentParser.astro";
import Benefits from "@/partials/Benefits.astro";
import Company from "@/partials/Company.astro";
import FinalCta from "@/partials/FinalCta.astro";
import Hardware from "@/partials/Hardware.astro";
import Hero from "@/partials/Hero.astro";
import { DashboardScrollDemo } from "@/components/DashboardScrollDemo";
import Pricing from "@/partials/Pricing.astro";
import Process from "@/partials/Process.astro";
import Comparison from "@/partials/Comparison.astro";
import Projects from "@/partials/Projects.astro";
import Solutions from "@/partials/Solutions.astro";
import Warranty from "@/partials/Warranty.astro";
import WhyLapCircuit from "@/partials/WhyLapCircuit.astro";
import type { Homepage } from "@/types";

const homepage = await getListPage("homepage", "-index");
const d: Homepage = homepage.data;
---

{/*
  The page is one argument, read top to bottom:
  what it is -> why it matters -> what we build -> why us -> how we work ->
  what it costs -> proof -> hardware -> warranty -> who we are -> contact.
*/}
<Base
  meta_title="LapCircuit — POS & business management software, built around your workflow"
>
  <Hero banner={d.banner} />

  <DashboardScrollDemo client:load />

  {d.benefits.enable && <Benefits benefits={d.benefits} />}

  {d.solutions.enable && <Solutions solutions={d.solutions} />}

  {d.why_lapcircuit.enable && <WhyLapCircuit why={d.why_lapcircuit} />}

  {d.process.enable && <Process process={d.process} />}

  <Comparison />

  {d.pricing.enable && <Pricing pricing={d.pricing} />}

  {d.projects.enable && <Projects projects={d.projects} />}

  {d.hardware.enable && <Hardware hardware={d.hardware} />}

  {d.warranty.enable && <Warranty warranty={d.warranty} />}

  {d.company.enable && <Company company={d.company} locations={d.locations} />}

  {d.final_cta.enable && <FinalCta cta={d.final_cta} />}
</Base>
