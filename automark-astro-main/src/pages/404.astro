---
import Base from "@/layouts/Base.astro";
---

<Base title="Page not found" noindex>
  <section class="missing">
    <div class="wrap">
      <h1>Page not found.</h1>
      <p>
        The page you are looking for may have been removed or renamed.
      </p>
      <a class="btn btn-shiny" href="/"><span>Back to home</span></a>
    </div>
  </section>
</Base>

<style>
  .missing {
    padding-block: clamp(9rem, 20vw, 14rem) clamp(5rem, 12vw, 9rem);
  }

  .missing h1 {
    font-size: clamp(2.25rem, 6vw, 4.5rem);
    line-height: 1.08;
  }

  .missing p {
    max-width: 44ch;
    margin-block: 1.5rem 2.25rem;
  }
</style>
