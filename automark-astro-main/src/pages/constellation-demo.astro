---
import Base from "@/layouts/Base.astro";
import ConstellationGrid from "@/components/ui/constellation-grid";
import ConstellationBackground from "@/components/ui/constellation-background";
---

<Base meta_title="Constellation Grid Component Demo | LapCircuit">
  <main class="min-h-screen bg-[#030508] text-white">
    <!-- Section 1: Standalone Constellation Grid (The exact component provided) -->
    <section class="relative w-full border-b border-white/10">
      <div class="p-4 bg-slate-900/80 text-xs font-mono text-cyan-400 border-b border-white/10 flex items-center justify-between">
        <span>PREVIEW 1: Standalone &lt;ConstellationGrid /&gt;</span>
        <span class="text-slate-400">Move your mouse fast across the canvas</span>
      </div>
      <div class="h-[600px] w-full overflow-hidden relative">
        <ConstellationGrid client:load />
      </div>
    </section>

    <!-- Section 2: Constellation Grid as a Section Background with LapCircuit 7 Pillars UI -->
    <section class="relative w-full py-20 px-4 sm:px-8 border-b border-white/10">
      <div class="max-w-6xl mx-auto mb-8 text-center">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full border border-[#2E90FF]/35 bg-[#2E90FF]/10 text-xs font-mono text-[#2E90FF] uppercase mb-4">
          <span class="size-2 rounded-full bg-[#2E90FF] animate-ping"></span>
          <span>PREVIEW 2: Used as a Section Background</span>
        </div>
        <h2 class="text-3xl sm:text-5xl font-black uppercase tracking-tight text-white">
          Dynamic Constellation Behind Content
        </h2>
        <p class="mt-3 text-slate-400 text-sm max-w-xl mx-auto">
          Notice how the canvas dynamically scales, repels particles on cursor movement, and still lets users click cards and buttons!
        </p>
      </div>

      <!-- Container with ConstellationBackground -->
      <div class="max-w-5xl mx-auto relative rounded-3xl border border-[#2E90FF]/30 bg-[#07152B]/40 backdrop-blur-xl p-8 sm:p-12 shadow-[0_0_50px_rgba(46,144,255,0.15)] overflow-hidden min-h-[500px]">
        <ConstellationBackground
          client:load
          accentColor="#2E90FF"
          backgroundColor="transparent"
          spacing={55}
          className="absolute inset-0"
        />

        <div class="relative z-10 grid grid-cols-1 md:grid-cols-3 gap-6">
          <div class="p-6 rounded-2xl border border-white/10 bg-[#0B1E3D]/80 backdrop-blur-md hover:border-[#2E90FF] transition-all duration-300">
            <span class="text-xs font-mono text-[#2E90FF] font-bold">PILLAR 01</span>
            <h3 class="text-lg font-bold text-white mt-1">Lifetime One-Time Payment</h3>
            <p class="text-xs text-slate-300 mt-2 leading-relaxed">
              Pay once and own your system forever with no monthly subscription locks.
            </p>
          </div>

          <div class="p-6 rounded-2xl border border-[#2E90FF] bg-[#0B1E3D]/90 backdrop-blur-md shadow-[0_0_25px_rgba(46,144,255,0.3)] transition-all duration-300">
            <span class="text-xs font-mono text-[#2E90FF] font-bold">PILLAR 02</span>
            <h3 class="text-lg font-bold text-white mt-1">Custom Tailored Workflows</h3>
            <p class="text-xs text-slate-300 mt-2 leading-relaxed">
              Engineered around the exact inventory, billing, and staff routines you use daily.
            </p>
          </div>

          <div class="p-6 rounded-2xl border border-white/10 bg-[#0B1E3D]/80 backdrop-blur-md hover:border-[#2E90FF] transition-all duration-300">
            <span class="text-xs font-mono text-[#2E90FF] font-bold">PILLAR 03</span>
            <h3 class="text-lg font-bold text-white mt-1">Offline &amp; Cloud Flexibility</h3>
            <p class="text-xs text-slate-300 mt-2 leading-relaxed">
              Continue billing even without internet. Sync smoothly when connection restores.
            </p>
          </div>
        </div>

        <div class="relative z-10 mt-8 flex justify-center gap-4">
          <button class="px-6 py-3 rounded-xl bg-[#2E90FF] text-white font-semibold text-sm shadow-[0_0_20px_rgba(46,144,255,0.5)] hover:scale-105 transition-all">
            Interactive Test Button
          </button>
        </div>
      </div>
    </section>
  </main>
</Base>
