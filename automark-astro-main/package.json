{
  "name": "lapcircuit-website",
  "version": "1.0.0",
  "description": "Official website for LapCircuit - POS and business management software",
  "author": "LapCircuit",
  "packageManager": "pnpm@11.9.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"node scripts/themeGenerator.js --watch\" \"astro dev\"",
    "build": "node scripts/themeGenerator.js && astro build",
    "preview": "astro preview",
    "check": "astro check",
    "format": "prettier -w ./src"
  },
  "dependencies": {
    "@astrojs/check": "0.9.9",
    "@astrojs/sitemap": "3.7.3",
    "@astrojs/vercel": "^11.0.0",
    "@digi4care/astro-google-tagmanager": "^2.0.0",
    "astro": "7.0.3",
    "marked": "^18.0.5",
    "sharp": "^0.35.2",
    "vite": "^8.1.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.1",
    "@types/node": "26.0.1",
    "concurrently": "^10.0.3",
    "eslint": "^10.6.0",
    "prettier": "^3.8.5",
    "prettier-plugin-astro": "^0.14.1",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "tailwindcss": "^4.3.1",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "astro": "$astro",
    "typescript": "$typescript"
  },
  "private": true
}
